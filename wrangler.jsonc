{
  "name": "elijahburgess-github-io",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-11",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/google43c3fa07e4f754c4.html"
    ]
  },
  "routes": [
    {
      "pattern": "eliburgessconsulting.com",
      "custom_domain": true
    },
    {
      "pattern": "www.eliburgessconsulting.com",
      "custom_domain": true
    }
  ]
}
