---
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/jetbrains-mono';
import '../styles/tokens.css';
import { navItems, siteMeta } from '../data/site-content';

export interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description = siteMeta.defaultDescription,
  canonicalPath,
  ogImage = `${siteMeta.siteUrl}/images/Eliheadshot.jpg`,
  ogType = 'website',
} = Astro.props;

const currentPath = canonicalPath || Astro.url.pathname;
const canonicalUrl = new URL(currentPath, siteMeta.siteUrl).href;

const pageTitle = title
  ? title.includes('Elijah Burgess')
    ? title
    : `${title} | Elijah Burgess`
  : siteMeta.defaultTitle;

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteMeta.siteUrl}/#person`,
      name: siteMeta.name,
      url: siteMeta.siteUrl,
      image: `${siteMeta.siteUrl}/images/Eliheadshot.jpg`,
      jobTitle: 'Applied AI Systems Builder, Consultant & Coach',
      worksFor: {
        '@type': 'Organization',
        name: 'Burgess Meditation LLC',
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Madison',
        addressRegion: 'WI',
        addressCountry: 'US',
      },
      sameAs: [siteMeta.github],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${siteMeta.siteUrl}/#service`,
      name: siteMeta.brand,
      url: siteMeta.siteUrl,
      logo: `${siteMeta.siteUrl}/favicon.svg`,
      image: `${siteMeta.siteUrl}/images/Eliheadshot.jpg`,
      description: siteMeta.defaultDescription,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Madison',
        addressRegion: 'WI',
        addressCountry: 'US',
      },
      founder: {
        '@id': `${siteMeta.siteUrl}/#person`,
      },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content={siteMeta.brand} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />

    <script is:inline>
      (function () {
        var prodApi = 'https://api.eliburgessconsulting.com';
        var lanApi = 'http://192.168.0.108:8006';
        var h = window.location.hostname;
        var isLan =
          h === 'localhost' ||
          h === '127.0.0.1' ||
          h.indexOf('192.168.') === 0 ||
          h.indexOf('100.') === 0;
        window.__API_BASE__ = isLan ? lanApi : prodApi;
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>

    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="Elijah Burgess Home">
          <svg width="24" height="24" viewBox="0 0 64 64" fill="none" aria-hidden="true">
            <rect width="64" height="64" rx="12" fill="#111620" stroke="rgba(255,255,255,0.14)" stroke-width="2"></rect>
            <path d="M18 18h17M18 32h15M18 46h17M18 18v28M35 18c6 0 10.5 3 10.5 7s-4.5 7-10.5 7c6.5 0 11.5 3 11.5 7s-5 7-11.5 7" stroke="#f3f5f8" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
          <span class="brand-text brand-full">{siteMeta.name}</span>
          <span class="brand-text brand-short">{siteMeta.shortName}</span>
        </a>

        <nav class="site-nav" aria-label="Primary">
          <div class="nav-links">
            {navItems.map((item) => (
              <a href={item.href} class="nav-link">{item.label}</a>
            ))}
          </div>
          <a href="/#contact" class="btn btn-primary btn-sm">Get in Touch</a>
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-copy">
          © {new Date().getFullYear()} {siteMeta.name} · Burgess Meditation LLC · Madison, WI
        </p>
        <div class="footer-links">
          <a href={`mailto:${siteMeta.email}`} class="footer-link">{siteMeta.email}</a>
          <a href={siteMeta.github} target="_blank" rel="noopener noreferrer" class="footer-link">GitHub ↗</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(9, 11, 15, 0.86);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-hairline);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 64px;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 650;
    font-size: 0.96rem;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    flex-shrink: 0;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2.5vw, 1.75rem);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(0.85rem, 2.2vw, 1.6rem);
  }

  .nav-link {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 140ms ease;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .site-footer {
    border-top: 1px solid var(--border-hairline);
    padding-block: 2rem;
    margin-top: auto;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.84rem;
    color: var(--text-muted);
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .footer-link {
    color: var(--text-secondary);
    transition: color 140ms ease;
  }

  .footer-link:hover {
    color: var(--text-primary);
  }

  .brand-short {
    display: none;
  }

  @media (max-width: 560px) {
    .brand-text {
      font-size: 0.9rem;
    }

    .nav-links {
      gap: 0.7rem;
    }

    .nav-link {
      font-size: 0.8rem;
    }

    .site-nav .btn-sm {
      padding: 0.45rem 0.68rem;
      font-size: 0.76rem;
    }
  }

  @media (max-width: 460px) {
    .brand-full {
      display: none;
    }

    .brand-short {
      display: inline;
    }
  }
</style>
