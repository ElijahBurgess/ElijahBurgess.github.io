---
import { heroContent } from '../data/site-content';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero-inner">
    <p class="hero-kicker mono">{heroContent.kicker}</p>
    <h1 id="hero-heading" class="hero-headline">{heroContent.headline}</h1>
    <p class="hero-subhead">{heroContent.subhead}</p>
    <div class="hero-actions">
      <a href={heroContent.primaryCta.href} class="btn btn-primary">
        {heroContent.primaryCta.label}
      </a>
      <a href={heroContent.secondaryCta.href} class="btn btn-ghost">
        {heroContent.secondaryCta.label}
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(4.5rem, 9vw, 7.5rem);
    padding-bottom: clamp(3.5rem, 7vw, 5.5rem);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .hero-kicker {
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1.15rem;
  }

  .hero-headline {
    font-size: clamp(2.2rem, 5vw, 3.45rem);
    max-width: 19ch;
    letter-spacing: -0.032em;
    line-height: 1.1;
    font-weight: 675;
  }

  .hero-subhead {
    margin-top: 1.35rem;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.62;
    color: var(--text-secondary);
    max-width: 54ch;
  }

  .hero-actions {
    margin-top: 2.15rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
  }

  @media (max-width: 420px) {
    .hero-actions {
      width: 100%;
    }

    .hero-actions .btn {
      flex: 1 1 auto;
    }
  }
</style>
