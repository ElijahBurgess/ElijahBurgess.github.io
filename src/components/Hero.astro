---
import { Image } from 'astro:assets';
import headshotAvatar from '../assets/Eliheadshot-avatar.jpg';
import { heroContent, siteMeta } from '../data/site-content';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <div class="hero-card">
      <div class="hero-profile-bar">
        <div class="hero-identity">
          <Image
            src={headshotAvatar}
            alt="Elijah Burgess"
            width={220}
            height={220}
            densities={[1.5, 2]}
            loading="eager"
            decoding="async"
            class="hero-avatar"
          />
          <div class="hero-identity-text">
            <span class="hero-name">{siteMeta.name}</span>
            <span class="hero-role">{heroContent.roleTitle}</span>
            <span class="hero-location mono">{heroContent.location}</span>
          </div>
        </div>

        <a
          href="#contact"
          class="availability-pill mono"
          data-select-tier={heroContent.primaryCta.tier}
        >
          <span class="availability-dot" aria-hidden="true"></span>
          <span>{heroContent.availability}</span>
        </a>
      </div>

      <div class="hero-body">
        <h1 id="hero-heading" class="hero-headline">{heroContent.headline}</h1>
        <p class="hero-subhead">{heroContent.subhead}</p>

        <div class="hero-actions">
          <a
            href={heroContent.primaryCta.href}
            class="btn btn-primary"
            data-select-tier={heroContent.primaryCta.tier}
          >
            {heroContent.primaryCta.label}
          </a>
          <a href={heroContent.secondaryCta.href} class="btn btn-ghost">
            {heroContent.secondaryCta.label}
          </a>
          <a
            href={siteMeta.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost social-btn"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19 3A2 2 0 0 1 21 5v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77Z" />
            </svg>
            <span>LinkedIn ↗</span>
          </a>
          <a
            href={siteMeta.github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost social-btn"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2Z" />
            </svg>
            <span>GitHub ↗</span>
          </a>
        </div>
      </div>
    </div>

    <div class="hero-pillars" aria-label="Consulting focus">
      {heroContent.pillars.map((pillar, idx) => (
        <div class="pillar-box">
          <span class="pillar-label mono">
            0{idx + 1} / {pillar.label}
          </span>
          <h2 class="pillar-title">{pillar.title}</h2>
          <p class="pillar-detail">{pillar.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(2.25rem, 5vw, 3.75rem);
    padding-bottom: clamp(2.75rem, 5vw, 4.25rem);
  }

  .hero-card {
    background-color: var(--bg-panel);
    border: 1px solid var(--border-hairline);
    border-top: 2px solid var(--border-accent);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .hero-profile-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding: clamp(1.15rem, 2.5vw, 1.55rem) clamp(1.35rem, 3vw, 2.15rem);
    background-color: rgba(255, 255, 255, 0.018);
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-identity {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    min-width: 0;
  }

  .hero-avatar {
    width: 92px;
    height: 92px;
    border-radius: 14px;
    object-fit: cover;
    object-position: center center;
    border: 1.5px solid var(--border-strong);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.38);
    flex-shrink: 0;
  }

  .hero-identity-text {
    display: flex;
    flex-direction: column;
    gap: 0.22rem;
    min-width: 0;
  }

  .hero-name {
    font-size: 1.16rem;
    font-weight: 680;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    line-height: 1.22;
  }

  .hero-role {
    font-size: 0.92rem;
    font-weight: 540;
    color: var(--accent);
    line-height: 1.35;
  }

  .hero-location {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .availability-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.76rem;
    line-height: 1.3;
    color: var(--text-primary);
    background-color: var(--live-soft);
    border: 1px solid var(--live-border);
    border-radius: 999px;
    padding: 0.45rem 0.85rem;
    transition: border-color 140ms ease, background-color 140ms ease;
  }

  .availability-pill:hover {
    background-color: rgba(52, 211, 153, 0.16);
    border-color: var(--live-dot);
  }

  .availability-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--live-dot);
    box-shadow: 0 0 8px rgba(52, 211, 153, 0.65);
    flex-shrink: 0;
  }

  .hero-body {
    padding: clamp(1.5rem, 3.2vw, 2.35rem) clamp(1.35rem, 3vw, 2.15rem);
  }

  .hero-headline {
    font-size: clamp(1.95rem, 4.2vw, 3.05rem);
    max-width: 24ch;
    letter-spacing: -0.032em;
    line-height: 1.12;
    font-weight: 675;
  }

  .hero-subhead {
    margin-top: 1.15rem;
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    line-height: 1.62;
    color: var(--text-secondary);
    max-width: 64ch;
  }

  .hero-actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.7rem;
  }

  .social-btn {
    gap: 0.42rem;
    padding-inline: 1rem;
  }

  .hero-pillars {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .pillar-box {
    background-color: var(--bg-panel);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-md);
    padding: 1.15rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.38rem;
  }

  .pillar-label {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .pillar-title {
    font-size: 1rem;
    font-weight: 640;
    color: var(--text-primary);
  }

  .pillar-detail {
    font-size: 0.87rem;
    line-height: 1.52;
    color: var(--text-secondary);
  }

  @media (max-width: 860px) {
    .hero-pillars {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .hero-avatar {
      width: 78px;
      height: 78px;
    }

    .availability-pill {
      font-size: 0.72rem;
      border-radius: var(--radius-sm);
    }

    .hero-actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
      width: 100%;
    }

    .hero-actions .btn:first-child,
    .hero-actions .btn:nth-child(2) {
      grid-column: 1 / -1;
    }
  }
</style>
