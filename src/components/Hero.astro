---
import { Image } from 'astro:assets';
import headshot from '../assets/Eliheadshot.jpg';
import { heroContent, siteMeta } from '../data/site-content';
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <div class="hero-card">
      <div class="hero-profile-bar">
        <div class="hero-identity">
          <Image
            src={headshot}
            alt="Elijah Burgess"
            width={176}
            height={176}
            densities={[1.5, 2]}
            loading="eager"
            decoding="async"
            class="hero-avatar"
          />
          <div class="hero-identity-text">
            <span class="hero-name">{siteMeta.name}</span>
            <span class="hero-role">{heroContent.roleTitle}</span>
            <span class="hero-location mono">{heroContent.location}</span>
          </div>
        </div>

        <a
          href="#contact"
          class="availability-pill mono"
          data-select-tier={heroContent.primaryCta.tier}
        >
          <span class="availability-dot" aria-hidden="true"></span>
          <span>{heroContent.availability}</span>
        </a>
      </div>

      <div class="hero-body">
        <h1 id="hero-heading" class="hero-headline">{heroContent.headline}</h1>
        <p class="hero-subhead">{heroContent.subhead}</p>

        <div class="hero-actions">
          <a
            href={heroContent.primaryCta.href}
            class="btn btn-primary"
            data-select-tier={heroContent.primaryCta.tier}
          >
            {heroContent.primaryCta.label}
          </a>
          <a href={heroContent.secondaryCta.href} class="btn btn-ghost">
            {heroContent.secondaryCta.label}
          </a>
          <a
            href={siteMeta.github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-ghost"
          >
            GitHub ↗
          </a>
        </div>
      </div>
    </div>

    <div class="hero-pillars" aria-label="Core engineering focus">
      {heroContent.pillars.map((pillar, idx) => (
        <div class="pillar-box">
          <span class="pillar-label mono">
            0{idx + 1} / {pillar.label}
          </span>
          <h2 class="pillar-title">{pillar.title}</h2>
          <p class="pillar-detail">{pillar.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(2.25rem, 5vw, 3.75rem);
    padding-bottom: clamp(2.75rem, 5vw, 4.25rem);
  }

  .hero-card {
    background-color: var(--bg-panel);
    border: 1px solid var(--border-hairline);
    border-top: 2px solid var(--border-accent);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .hero-profile-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    padding: clamp(1.15rem, 2.5vw, 1.5rem) clamp(1.35rem, 3vw, 2.15rem);
    background-color: rgba(255, 255, 255, 0.018);
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-identity {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .hero-avatar {
    width: 72px;
    height: 72px;
    border-radius: 12px;
    object-fit: cover;
    object-position: center 18%;
    border: 1px solid var(--border-strong);
    flex-shrink: 0;
  }

  .hero-identity-text {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    min-width: 0;
  }

  .hero-name {
    font-size: 1.08rem;
    font-weight: 675;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    line-height: 1.25;
  }

  .hero-role {
    font-size: 0.9rem;
    font-weight: 520;
    color: var(--accent);
    line-height: 1.35;
  }

  .hero-location {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .availability-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.76rem;
    line-height: 1.3;
    color: var(--text-primary);
    background-color: var(--live-soft);
    border: 1px solid var(--live-border);
    border-radius: 999px;
    padding: 0.45rem 0.85rem;
    transition: border-color 140ms ease, background-color 140ms ease;
  }

  .availability-pill:hover {
    background-color: rgba(52, 211, 153, 0.16);
    border-color: var(--live-dot);
  }

  .availability-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--live-dot);
    box-shadow: 0 0 8px rgba(52, 211, 153, 0.65);
    flex-shrink: 0;
  }

  .hero-body {
    padding: clamp(1.5rem, 3.2vw, 2.35rem) clamp(1.35rem, 3vw, 2.15rem);
  }

  .hero-headline {
    font-size: clamp(1.95rem, 4.2vw, 3.05rem);
    max-width: 24ch;
    letter-spacing: -0.032em;
    line-height: 1.12;
    font-weight: 675;
  }

  .hero-subhead {
    margin-top: 1.15rem;
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    line-height: 1.62;
    color: var(--text-secondary);
    max-width: 64ch;
  }

  .hero-actions {
    margin-top: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-pillars {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .pillar-box {
    background-color: var(--bg-panel);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-md);
    padding: 1.15rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.38rem;
  }

  .pillar-label {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .pillar-title {
    font-size: 1rem;
    font-weight: 640;
    color: var(--text-primary);
  }

  .pillar-detail {
    font-size: 0.87rem;
    line-height: 1.52;
    color: var(--text-secondary);
  }

  @media (max-width: 860px) {
    .hero-pillars {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .hero-avatar {
      width: 60px;
      height: 60px;
    }

    .availability-pill {
      font-size: 0.72rem;
      border-radius: var(--radius-sm);
    }

    .hero-actions {
      width: 100%;
    }

    .hero-actions .btn {
      flex: 1 1 auto;
    }
  }
</style>
