---
import { Image } from 'astro:assets';
import headshot from '../assets/Eliheadshot.jpg';
import { bioContent } from '../data/site-content';
---

<section id="bio" class="section-rule" aria-labelledby="bio-heading">
  <div class="container">
    <div class="section-head">
      <span class="section-index">{bioContent.sectionLabel}</span>
      <h2 id="bio-heading" class="section-title">{bioContent.heading}</h2>
    </div>

    <div class="bio-split">
      <div class="bio-portrait-wrap">
        <Image
          src={headshot}
          alt="Elijah Burgess"
          width={560}
          densities={[1.5, 2]}
          class="bio-portrait"
        />
      </div>

      <div class="bio-body">
        <div class="bio-paragraphs">
          {bioContent.paragraphs.map((paragraph, index) => (
            <p class={index === 0 ? 'bio-lead' : 'bio-copy'}>{paragraph}</p>
          ))}
        </div>

        <dl class="bio-facts">
          {bioContent.facts.map((fact) => (
            <div class="bio-fact-cell">
              <dt class="bio-fact-label mono">{fact.label}</dt>
              <dd class="bio-fact-value">{fact.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .bio-split {
    display: grid;
    grid-template-columns: minmax(220px, 280px) 1fr;
    gap: clamp(2rem, 5vw, 3.75rem);
    align-items: start;
  }

  .bio-portrait-wrap {
    width: 100%;
  }

  .bio-portrait {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center top;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-hairline);
  }

  .bio-body {
    min-width: 0;
  }

  .bio-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 62ch;
    font-size: 1.02rem;
    line-height: 1.68;
  }

  .bio-lead {
    color: var(--text-primary);
  }

  .bio-copy {
    color: var(--text-secondary);
  }

  .bio-facts {
    margin: 2rem 0 0;
    border-top: 1px solid var(--border-hairline);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 2rem;
  }

  .bio-fact-cell {
    padding-block: 1rem;
    border-bottom: 1px solid var(--border-hairline);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .bio-fact-label {
    font-size: 0.74rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .bio-fact-value {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.48;
    color: var(--text-primary);
  }

  @media (max-width: 759px) {
    .bio-split {
      grid-template-columns: 1fr;
    }

    .bio-portrait-wrap {
      max-width: 240px;
    }
  }

  @media (max-width: 560px) {
    .bio-facts {
      grid-template-columns: 1fr;
    }
  }
</style>
