---
import { bioContent } from '../data/site-content';
---

<section id="bio" class="section-rule" aria-labelledby="bio-heading">
  <div class="container">
    <div class="section-head">
      <span class="section-index">{bioContent.sectionLabel}</span>
      <h2 id="bio-heading" class="section-title">{bioContent.heading}</h2>
    </div>

    <div class="bio-grid">
      <!-- Left Box: Single Concise Bio Paragraph + Core Stack / Education Facts -->
      <article class="studio-box bio-panel">
        <div class="panel-header">
          <span class="panel-eyebrow mono">{bioContent.bioBoxLabel}</span>
          <h3 class="panel-heading">{bioContent.bioBoxTitle}</h3>
        </div>

        <p class="bio-paragraph">{bioContent.paragraph}</p>

        <dl class="bio-facts">
          {bioContent.facts.map((fact) => (
            <div class="bio-fact-cell">
              <dt class="bio-fact-label mono">{fact.label}</dt>
              <dd class="bio-fact-value">{fact.value}</dd>
            </div>
          ))}
        </dl>
      </article>

      <!-- Right Box: Scannable Bullet Points of Current AI & Software Achievements -->
      <article class="studio-box achievements-panel">
        <div class="panel-header">
          <span class="panel-eyebrow mono">{bioContent.achievementsLabel}</span>
          <h3 class="panel-heading">{bioContent.achievementsTitle}</h3>
        </div>

        <ul class="achievement-list">
          {bioContent.achievements.map((item) => (
            <li class="achievement-item">
              <span class="achievement-bullet mono" aria-hidden="true">▸</span>
              <div class="achievement-text">
                <strong class="achievement-title">{item.title}:</strong>{' '}
                <span class="achievement-detail">{item.detail}</span>
              </div>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .bio-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 1.15rem;
    align-items: stretch;
  }

  @media (max-width: 859px) {
    .bio-grid {
      grid-template-columns: 1fr;
    }
  }

  .bio-panel,
  .achievements-panel {
    display: flex;
    flex-direction: column;
  }

  .panel-header {
    padding-bottom: 0.9rem;
    margin-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .panel-eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .panel-heading {
    font-size: 1.12rem;
  }

  .bio-paragraph {
    font-size: 0.96rem;
    line-height: 1.66;
    color: var(--text-secondary);
    margin-bottom: 1.35rem;
  }

  .bio-facts {
    margin: auto 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  @media (max-width: 520px) {
    .bio-facts {
      grid-template-columns: 1fr;
    }
  }

  .bio-fact-cell {
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .bio-fact-label {
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .bio-fact-value {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.44;
    color: var(--text-primary);
  }

  .achievement-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .achievement-item {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.78rem 0.95rem;
    font-size: 0.88rem;
    line-height: 1.52;
  }

  .achievement-bullet {
    color: var(--accent);
    font-size: 0.82rem;
    flex-shrink: 0;
  }

  .achievement-title {
    color: var(--text-primary);
    font-weight: 640;
  }

  .achievement-detail {
    color: var(--text-secondary);
  }
</style>
