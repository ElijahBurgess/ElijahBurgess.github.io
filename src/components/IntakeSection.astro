---
import { contactContent, siteMeta } from '../data/site-content';
---

<section id="contact" class="section-rule intake-section" aria-labelledby="contact-heading">
  <div class="container">
    <div class="section-head">
      <span class="section-index">{contactContent.sectionLabel}</span>
      <h2 id="contact-heading" class="section-title">{contactContent.heading}</h2>
    </div>

    <div class="intake-grid">
      <!-- Left Column: Bordered Role Fit & Direct Contact Box -->
      <div class="studio-box intake-editorial">
        <p class="intake-subhead">{contactContent.subhead}</p>

        <dl class="role-highlights">
          {contactContent.roleHighlights.map((item) => (
            <div class="role-highlight-cell">
              <dt class="direct-label mono">{item.label}</dt>
              <dd class="role-highlight-val">{item.value}</dd>
            </div>
          ))}
        </dl>

        <div class="direct-contact">
          <div class="direct-contact-item">
            <span class="direct-label mono">Direct Email</span>
            <a href={`mailto:${siteMeta.email}`} class="text-link direct-link">
              {siteMeta.email}
            </a>
          </div>
          <div class="direct-contact-item">
            <span class="direct-label mono">GitHub</span>
            <a
              href={siteMeta.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-link direct-link"
            >
              github.com/ElijahBurgess ↗
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Studio Form Panel -->
      <div class="intake-panel-wrapper">
        <form
          id="inquiry-form"
          class="inquiry-panel"
          data-email={siteMeta.email}
        >
          <!-- Segmented Topic Selector -->
          <div class="topic-section">
            <span class="topic-label mono" id="topic-group-label">Topic</span>
            <div
              class="topic-group"
              role="radiogroup"
              aria-labelledby="topic-group-label"
            >
              {contactContent.topics.map((topic, index) => (
                <button
                  type="button"
                  role="radio"
                  class={`topic-chip ${index === 0 ? 'active' : ''}`}
                  aria-checked={index === 0 ? 'true' : 'false'}
                  tabindex={index === 0 ? '0' : '-1'}
                  data-topic={topic}
                >
                  {topic}
                </button>
              ))}
            </div>
            <input
              type="hidden"
              name="service_tier"
              id="service-tier-input"
              value={contactContent.topics[0]}
            />
          </div>

          <!-- Name & Email 2-column row -->
          <div class="form-row">
            <div class="form-field">
              <label for="inquiry-name" class="form-label mono">Name</label>
              <input
                type="text"
                id="inquiry-name"
                name="name"
                required
                maxlength="200"
                placeholder="Your name or team"
                class="form-input"
                autocomplete="name"
              />
            </div>
            <div class="form-field">
              <label for="inquiry-email" class="form-label mono">Email</label>
              <input
                type="email"
                id="inquiry-email"
                name="email"
                required
                maxlength="254"
                placeholder="you@company.com"
                class="form-input"
                autocomplete="email"
              />
            </div>
          </div>

          <!-- Message textarea -->
          <div class="form-field">
            <label for="inquiry-message" class="form-label mono">Message</label>
            <textarea
              id="inquiry-message"
              name="message"
              rows="4"
              required
              maxlength="5000"
              placeholder="Share details on an AI-focused role, contract scope, or coaching inquiry..."
              class="form-textarea"
            ></textarea>
          </div>

          <!-- Visually hidden honeypot field -->
          <div class="hp-field" aria-hidden="true">
            <label for="inquiry-website">Website</label>
            <input
              type="text"
              id="inquiry-website"
              name="website_url"
              tabindex="-1"
              autocomplete="off"
            />
          </div>

          <!-- Actions & Feedback Region -->
          <div class="form-actions">
            <button type="submit" id="inquiry-submit" class="btn btn-primary">
              Send Message
            </button>
            <div id="inquiry-status" class="form-status" aria-live="polite"></div>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .intake-grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 1.15rem;
    align-items: stretch;
  }

  @media (max-width: 859px) {
    .intake-grid {
      grid-template-columns: 1fr;
    }
  }

  .intake-editorial {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .intake-subhead {
    color: var(--text-secondary);
    font-size: 0.96rem;
    line-height: 1.62;
  }

  .role-highlights {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .role-highlight-cell {
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .role-highlight-val {
    margin: 0;
    font-size: 0.87rem;
    line-height: 1.48;
    color: var(--text-primary);
  }

  .direct-contact {
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
  }

  .direct-contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.28rem;
  }

  .direct-label {
    font-size: 0.71rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .direct-link {
    font-size: 0.88rem;
    color: var(--text-primary);
    word-break: break-all;
  }

  .direct-link:hover {
    color: var(--accent);
  }

  .intake-panel-wrapper {
    width: 100%;
  }

  .inquiry-panel {
    height: 100%;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-md);
    padding: clamp(1.35rem, 2.6vw, 1.85rem);
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .topic-section {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .topic-label {
    font-size: 0.73rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  .topic-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .topic-chip {
    font-family: var(--font-sans);
    font-size: 0.83rem;
    font-weight: 520;
    color: var(--text-secondary);
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.45rem 0.8rem;
    cursor: pointer;
    transition: background-color 140ms ease, border-color 140ms ease, color 140ms ease;
    white-space: nowrap;
  }

  .topic-chip:hover {
    border-color: var(--border-strong);
    color: var(--text-primary);
  }

  .topic-chip.active,
  .topic-chip[aria-checked='true'] {
    background-color: var(--accent-soft);
    border-color: var(--accent);
    color: var(--text-primary);
    font-weight: 620;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }

  @media (max-width: 560px) {
    .form-row {
      grid-template-columns: 1fr;
    }
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.38rem;
  }

  .form-label {
    font-size: 0.73rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.07em;
  }

  .form-input,
  .form-textarea {
    width: 100%;
    background-color: var(--bg-canvas);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-family: var(--font-sans);
    font-size: 0.92rem;
    padding: 0.68rem 0.85rem;
    transition: border-color 140ms ease, box-shadow 140ms ease;
  }

  .form-input::placeholder,
  .form-textarea::placeholder {
    color: var(--text-muted);
    opacity: 0.8;
  }

  .form-input:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }

  .form-textarea {
    resize: vertical;
    min-height: 105px;
    line-height: 1.5;
  }

  .hp-field {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .form-actions {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    margin-top: auto;
  }

  .btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .form-status {
    font-size: 0.88rem;
    line-height: 1.5;
  }

  :global(.form-status.status-success) {
    color: var(--live-dot);
    padding: 0.65rem 0.85rem;
    background-color: rgba(52, 211, 153, 0.08);
    border: 1px solid rgba(52, 211, 153, 0.28);
    border-radius: var(--radius-sm);
  }

  :global(.form-status.status-error) {
    color: var(--text-primary);
    padding: 0.65rem 0.85rem;
    background-color: rgba(248, 113, 113, 0.08);
    border: 1px solid rgba(248, 113, 113, 0.28);
    border-radius: var(--radius-sm);
  }

  :global(.form-status .fallback-link) {
    display: inline-block;
    margin-top: 0.35rem;
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }

  :global(.form-status .fallback-link:hover) {
    color: var(--accent-hover);
  }
</style>

<script>
  function initIntakeForm() {
    const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
    if (!form || form.dataset.initialized === 'true') return;
    form.dataset.initialized = 'true';

    const submitBtn = document.getElementById('inquiry-submit') as HTMLButtonElement | null;
    const statusEl = document.getElementById('inquiry-status');
    const hiddenInput = document.getElementById('service-tier-input') as HTMLInputElement | null;
    const topicGroup = form.querySelector('.topic-group');
    const directEmail = form.dataset.email || 'elib@eliburgessconsulting.com';

    function getTopicChips(): HTMLElement[] {
      return Array.from(form!.querySelectorAll('.topic-chip'));
    }

    function findTopicMatch(val: string | null): string | null {
      if (!val) return null;
      const clean = val.toLowerCase().trim();
      const chips = getTopicChips();
      const allTopics = chips.map((btn) => btn.getAttribute('data-topic') || '');

      const direct = allTopics.find((t) => t.toLowerCase() === clean);
      if (direct) return direct;

      if (clean.includes('hir') || clean.includes('role') || clean.includes('job')) {
        return allTopics.find((t) => t.toLowerCase().includes('hiring')) || null;
      }
      if (clean === 'consulting' || clean.includes('consult')) {
        return allTopics.find((t) => t.toLowerCase().includes('consulting')) || null;
      }
      if (clean === 'coaching' || clean.includes('coach')) {
        return allTopics.find((t) => t.toLowerCase().includes('coaching')) || null;
      }
      if (clean === 'advisory' || clean.includes('advis') || clean.includes('train')) {
        return (
          allTopics.find(
            (t) => t.toLowerCase().includes('advisory') || t.toLowerCase().includes('training')
          ) || null
        );
      }

      return (
        allTopics.find(
          (t) => t.toLowerCase().includes(clean) || clean.includes(t.toLowerCase())
        ) || null
      );
    }

    function selectTopic(topicName: string) {
      const matched = findTopicMatch(topicName);
      if (!matched) return;

      if (hiddenInput) {
        hiddenInput.value = matched;
      }

      const chips = getTopicChips();
      chips.forEach((btn) => {
        const isTarget = btn.getAttribute('data-topic') === matched;
        btn.setAttribute('aria-checked', isTarget ? 'true' : 'false');
        btn.setAttribute('tabindex', isTarget ? '0' : '-1');
        btn.classList.toggle('active', isTarget);
      });
    }

    if (topicGroup) {
      topicGroup.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        const btn = target?.closest('.topic-chip');
        if (!btn) return;
        const topic = btn.getAttribute('data-topic');
        if (topic) selectTopic(topic);
      });

      topicGroup.addEventListener('keydown', (e) => {
        const ke = e as KeyboardEvent;
        const chips = getTopicChips();
        const currentIndex = chips.findIndex((c) => c === document.activeElement);
        if (currentIndex === -1) return;

        let nextIndex: number | null = null;
        if (ke.key === 'ArrowRight' || ke.key === 'ArrowDown') {
          nextIndex = (currentIndex + 1) % chips.length;
        } else if (ke.key === 'ArrowLeft' || ke.key === 'ArrowUp') {
          nextIndex = (currentIndex - 1 + chips.length) % chips.length;
        }

        if (nextIndex !== null) {
          ke.preventDefault();
          chips[nextIndex].focus();
          const topic = chips[nextIndex].getAttribute('data-topic');
          if (topic) selectTopic(topic);
        }
      });
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const trigger = target?.closest('[data-select-tier]');
      if (!trigger) return;
      const tierVal = trigger.getAttribute('data-select-tier');
      if (tierVal) {
        selectTopic(tierVal);
      }
      const nameInput = document.getElementById('inquiry-name');
      const messageInput = document.getElementById('inquiry-message');
      const targetInput = nameInput || messageInput;
      if (targetInput) {
        setTimeout(() => {
          targetInput.focus();
        }, 120);
      }
    });

    try {
      const urlParams = new URLSearchParams(window.location.search);
      const tierParam = urlParams.get('tier');
      if (tierParam) {
        selectTopic(tierParam);
      }
    } catch (_) {}

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Sending...';
      }

      if (statusEl) {
        statusEl.className = 'form-status';
        statusEl.textContent = '';
      }

      const formData = new FormData(form);
      const currentChips = getTopicChips();
      const defaultTier = currentChips.length
        ? currentChips[0].getAttribute('data-topic') || 'AI Role / Hiring'
        : 'AI Role / Hiring';

      const payload = {
        name: String(formData.get('name') || '').trim(),
        email: String(formData.get('email') || '').trim(),
        service_tier: String(formData.get('service_tier') || defaultTier).trim(),
        message: String(formData.get('message') || '').trim(),
        website_url: String(formData.get('website_url') || '').trim(),
      };

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 5000);

      const win = window as unknown as { __API_BASE__?: string };
      const apiBase = (win.__API_BASE__ || '').replace(/\/+$/, '');
      const endpoint = `${apiBase}/api/coaching/inquiry`;

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });

        clearTimeout(timeoutId);

        if (response.ok) {
          form.reset();
          const firstTopic = getTopicChips()[0]?.getAttribute('data-topic');
          if (firstTopic) selectTopic(firstTopic);

          if (statusEl) {
            statusEl.className = 'form-status status-success';
            statusEl.textContent =
              "Thanks — your note is in. I'll reply within one business day.";
          }
        } else {
          const errData = await response.json().catch(() => ({}));
          throw new Error(errData.detail || `HTTP ${response.status}`);
        }
      } catch (_) {
        clearTimeout(timeoutId);

        if (statusEl) {
          statusEl.className = 'form-status status-error';
          const subject = encodeURIComponent(`Inquiry: ${payload.service_tier}`);
          const body = encodeURIComponent(
            `Hi Eli,\n\nName: ${payload.name}\nEmail: ${payload.email}\nTopic: ${payload.service_tier}\n\n${payload.message}`
          );
          const mailtoUrl = `mailto:${directEmail}?subject=${subject}&body=${body}`;

          statusEl.innerHTML = `Could not reach the server. You can send your note directly: <a href="${mailtoUrl}" class="fallback-link">Open in Email Client &rarr;</a>`;
        }
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Send Message';
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initIntakeForm);
  } else {
    initIntakeForm();
  }
  document.addEventListener('astro:page-load', initIntakeForm);
</script>
