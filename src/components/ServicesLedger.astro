---
import { servicesContent } from '../data/site-content';
---

<section id="services" class="section-rule" aria-labelledby="services-heading">
  <div class="container">
    <div class="section-head">
      <span class="section-index">{servicesContent.sectionLabel}</span>
      <h2 id="services-heading" class="section-title">{servicesContent.heading}</h2>
    </div>

    <div class="services-grid">
      {servicesContent.items.map((item) => (
        <article class="service-box">
          <div class="service-head">
            <p class="service-audience mono">{item.audience}</p>
            <h3 class="service-title">{item.title}</h3>
          </div>

          <p class="service-summary">{item.summary}</p>

          <ul class="service-outcomes">
            {item.outcomes.map((outcome) => (
              <li>{outcome}</li>
            ))}
          </ul>

          <div class="service-footer">
            <a
              href="#contact"
              class="service-select-link text-link"
              data-select-tier={item.tierValue}
            >
              Inquire →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.15rem;
  }

  @media (max-width: 859px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
  }

  .service-box {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background-color: var(--bg-panel);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-md);
    padding: 1.45rem;
    transition: border-color 150ms ease;
  }

  .service-box:hover {
    border-color: var(--border-strong);
  }

  .service-head {
    padding-bottom: 0.9rem;
    margin-bottom: 0.95rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .service-audience {
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 0.35rem;
  }

  .service-title {
    font-size: 1.15rem;
  }

  .service-summary {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .service-outcomes {
    list-style: none;
    padding: 0;
    margin: 1.15rem 0 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .service-outcomes li {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    font-size: 0.87rem;
    line-height: 1.48;
    color: var(--text-primary);
  }

  .service-outcomes li::before {
    content: '•';
    font-family: var(--font-mono);
    color: var(--accent);
    flex-shrink: 0;
  }

  .service-footer {
    margin-top: auto;
    padding-top: 0.95rem;
    border-top: 1px solid var(--border-subtle);
  }

  .service-select-link {
    font-size: 0.86rem;
    color: var(--text-primary);
  }

  .service-select-link:hover {
    color: var(--accent);
  }
</style>
