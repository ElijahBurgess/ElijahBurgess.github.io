---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Toddler Touch Screen Lock | Privacy-First Android Utility by Elijah Burgess"
  description="A 100% offline, zero-telemetry Android utility that locks touch inputs during video playback so toddlers can watch without accidental taps, hung-up calls, or changed settings."
  canonicalPath="/projects/toddler-touch-screen-lock"
>
  <div class="project-showcase">
    <!-- Breadcrumb -->
    <div class="container breadcrumb-container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep">/</span>
        <a href="/#projects">Projects</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">Toddler Touch Screen Lock</span>
      </nav>
    </div>

    <!-- Hero Header -->
    <section class="section hero-section">
      <div class="container hero-container">
        <div class="hero-content">
          <div class="eyebrow mono">
            <span class="status-dot online"></span>
            Production Android Utility // Burgess Meditation LLC
          </div>
          <h1 class="hero-title">Toddler Touch Screen Lock</h1>
          <p class="hero-summary">
            Hand your phone to a toddler playing cartoons or a family video call without accidental hang-ups,
            stray settings toggles, or emergency texts. Engineered with zero network permissions, an impenetrable
            hardware-key unlock combo, and mathematical privacy guarantees enforced by the Android OS.
          </p>

          <div class="tags hero-tags">
            <span class="tag mono">com.burgessmeditation.touchguard</span>
            <span class="tag mono">Burgess Meditation LLC</span>
            <span class="tag mono">100% Offline • Zero Internet Permission</span>
            <span class="tag mono">TYPE_ACCESSIBILITY_OVERLAY</span>
            <span class="tag mono">Hardware Failsafe</span>
          </div>

          <div class="hero-actions">
            <a
              href="https://play.google.com/store/apps/details?id=com.burgessmeditation.touchguard"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M3.609 1.814L13.792 12 3.61 22.186a2.213 2.213 0 0 1-.61-.318c-.615-.46-.999-1.2-.999-2.029V4.161c0-.83.384-1.569 1-2.03.18-.133.385-.239.608-.317zM15.207 13.414l2.585 2.586-11.41 6.52 8.825-9.106zm0-2.828L6.382 1.48l11.41 6.52-2.585 2.586zm1.414 1.414l3.655 2.088c1.196.684 1.196 1.8 0 2.484l-3.655 2.089v-6.661z"/>
              </svg>
              Google Play Store Listing ↗
            </a>
            <a href="/toddler-touch-screen-lock-privacy/" class="btn btn-secondary">
              Read Official Privacy Policy →
            </a>
          </div>
        </div>

        <div class="hero-metrics card">
          <h2 class="metrics-title mono">System Guarantees</h2>
          <ul class="metrics-list">
            <li>
              <div class="metric-val mono text-accent">0 B</div>
              <div class="metric-lbl">Network Telemetry Sent</div>
              <p class="metric-desc"><code>android.permission.INTERNET</code> is omitted entirely from manifest.</p>
            </li>
            <li>
              <div class="metric-val mono text-accent-2">100%</div>
              <div class="metric-lbl">Touch Capture Rate</div>
              <p class="metric-desc">Consumes all multi-touch & edge gestures at WindowManager layer.</p>
            </li>
            <li>
              <div class="metric-val mono text-purple">2-Way</div>
              <div class="metric-lbl">Hardware Unlock Path</div>
              <p class="metric-desc">Volume key cadence combo or instant USB-C power failsafe.</p>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Interactive Hardware Unlock Simulator -->
    <section class="section simulator-section">
      <div class="container">
        <div class="section-header">
          <div class="eyebrow mono">Interactive Experience</div>
          <h2 class="section-title">Hardware Unlock Simulator</h2>
          <p class="section-subtitle">
            Test both unlock mechanisms directly in your browser. Tap the phone screen to verify touch rejection,
            click the side volume buttons in sequence, or plug in the simulated USB-C charging cable.
          </p>
        </div>

        <div class="simulator-wrapper">
          <!-- Phone Silhouette -->
          <div class="phone-frame" id="sim-phone">
            <!-- Hardware Buttons on Edge -->
            <div class="hardware-buttons-left">
              <button
                type="button"
                id="btn-vol-up"
                class="hw-btn hw-btn-vol"
                title="Simulate Hardware Volume Up"
                aria-label="Volume Up button"
              >
                <span>+</span>
                <span class="hw-btn-label">Vol +</span>
              </button>
              <button
                type="button"
                id="btn-vol-down"
                class="hw-btn hw-btn-vol"
                title="Simulate Hardware Volume Down"
                aria-label="Volume Down button"
              >
                <span>−</span>
                <span class="hw-btn-label">Vol −</span>
              </button>
            </div>

            <div class="hardware-buttons-right">
              <div class="hw-btn hw-btn-power" title="Hardware Power Key"></div>
            </div>

            <!-- Phone Bezel & Display -->
            <div class="phone-bezel">
              <div class="phone-notch">
                <div class="phone-speaker"></div>
                <div class="phone-camera"></div>
              </div>

              <!-- Phone Display Area -->
              <div class="phone-screen" id="phone-screen" tabindex="0" role="button" aria-label="Simulated phone screen. Click to test touch lock.">
                <!-- Status Bar -->
                <div class="sim-status-bar mono">
                  <span class="sim-time" id="sim-time">10:42</span>
                  <div class="sim-icons">
                    <span class="sim-network">5G</span>
                    <span class="sim-battery">88% 🔋</span>
                  </div>
                </div>

                <!-- Active Content: Toddler Cartoon Video Playing -->
                <div class="sim-video-player">
                  <div class="video-scene">
                    <!-- Fun animated SVG scenery -->
                    <div class="scenery-sun"></div>
                    <div class="scenery-cloud cloud-1"></div>
                    <div class="scenery-cloud cloud-2"></div>
                    <div class="cartoon-bus">
                      <div class="bus-body">
                        <div class="bus-window win-1">🐱</div>
                        <div class="bus-window win-2">🐶</div>
                        <div class="bus-window win-3">🐻</div>
                        <div class="bus-wheel wheel-1"></div>
                        <div class="bus-wheel wheel-2"></div>
                      </div>
                    </div>
                    <div class="road"></div>
                  </div>

                  <div class="video-overlay-ui">
                    <div class="video-title">Toddler Tunes: Wheels on the Bus 🎵</div>
                    <div class="video-progress-bar">
                      <div class="video-progress-fill"></div>
                    </div>
                  </div>
                </div>

                <!-- TouchGuard Active Lock Overlay -->
                <div class="touchguard-overlay active" id="touchguard-overlay">
                  <div class="lock-indicator" id="lock-indicator">
                    <div class="lock-shield-icon">
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        <path d="M9 12h6m-3-3v6"/>
                      </svg>
                    </div>
                    <span class="lock-shield-text">Touch Blocked</span>
                  </div>

                  <!-- Ripple / Feedback on click -->
                  <div class="touch-feedback" id="touch-feedback" aria-live="polite">
                    <span class="shield-badge">🛡️ Input Discarded</span>
                    <span class="feedback-sub">Touch absorbed by accessibility overlay. Video keeps playing uninterrupted!</span>
                  </div>
                </div>

                <!-- Unlocked Celebration Screen -->
                <div class="unlocked-overlay" id="unlocked-overlay">
                  <div class="unlocked-card">
                    <div class="unlocked-icon">🔓</div>
                    <h3 class="unlocked-title">Screen Unlocked!</h3>
                    <p class="unlocked-msg">Normal Android touch input and navigation restored.</p>
                    <button type="button" id="btn-relock" class="btn btn-primary btn-sm">
                      🔒 Re-Lock Screen
                    </button>
                  </div>
                </div>
              </div>

              <!-- USB-C Port at bottom -->
              <div class="phone-bottom-edge">
                <div class="usbc-port" id="usbc-port" title="USB-C Charging Port">
                  <span class="usbc-slot"></span>
                  <span class="usbc-spark" id="usbc-spark">⚡</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Simulator Control Panel -->
          <div class="simulator-controls card">
            <h3 class="controls-title mono">Unlock Mechanism Tester</h3>
            <p class="controls-desc">
              Test how parents disengage the touch blocker when toddlers return the phone.
            </p>

            <!-- Mechanism 1: Hardware Volume Combo -->
            <div class="control-box">
              <div class="control-header">
                <span class="control-badge mono">Mechanism 1</span>
                <span class="control-name">Volume Rhythm Combo</span>
              </div>
              <p class="control-explanation">
                Press <strong>Volume Down × 3</strong>, followed by <strong>Volume Up × 3</strong>.
                Physical buttons intercept hardware keystrokes even when the touch panel is completely deadened.
              </p>

              <!-- 6-Dot Tracker -->
              <div class="tracker-container">
                <div class="tracker-label mono">Live Key Sequence Tracker:</div>
                <div class="sequence-dots" id="sequence-dots" aria-label="Volume Sequence Progress">
                  <div class="seq-step" data-step="0">
                    <span class="seq-dot">▼</span>
                    <span class="seq-hint">Down 1</span>
                  </div>
                  <div class="seq-step" data-step="1">
                    <span class="seq-dot">▼</span>
                    <span class="seq-hint">Down 2</span>
                  </div>
                  <div class="seq-step" data-step="2">
                    <span class="seq-dot">▼</span>
                    <span class="seq-hint">Down 3</span>
                  </div>
                  <div class="seq-step" data-step="3">
                    <span class="seq-dot">▲</span>
                    <span class="seq-hint">Up 1</span>
                  </div>
                  <div class="seq-step" data-step="4">
                    <span class="seq-dot">▲</span>
                    <span class="seq-hint">Up 2</span>
                  </div>
                  <div class="seq-step" data-step="5">
                    <span class="seq-dot">▲</span>
                    <span class="seq-hint">Up 3</span>
                  </div>
                </div>

                <div class="combo-timer" id="combo-timer-bar">
                  <div class="timer-fill" id="timer-fill"></div>
                </div>
                <div class="combo-status mono" id="combo-status-msg">
                  Waiting for sequence start...
                </div>
              </div>

              <div class="interactive-btns-row">
                <button type="button" id="panel-vol-down" class="btn btn-secondary btn-sm">
                  Click [ Vol − ]
                </button>
                <button type="button" id="panel-vol-up" class="btn btn-secondary btn-sm">
                  Click [ Vol + ]
                </button>
                <button type="button" id="panel-vol-reset" class="btn btn-ghost btn-sm">
                  Reset Sequence
                </button>
              </div>
            </div>

            <!-- Mechanism 2: USB Failsafe -->
            <div class="control-box">
              <div class="control-header">
                <span class="control-badge mono">Mechanism 2</span>
                <span class="control-name">Hardware Charging Failsafe</span>
              </div>
              <p class="control-explanation">
                Forgot the volume sequence? Simply plug in any standard USB-C charger. The OS fires an instantaneous
                <code>ACTION_POWER_CONNECTED</code> hardware broadcast that safely drops the overlay without needing buttons.
              </p>

              <div class="failsafe-actions">
                <button type="button" id="btn-toggle-usbc" class="btn btn-secondary btn-full">
                  <span id="usbc-btn-label">Plug in USB-C Charger ⚡</span>
                </button>
              </div>
              <div class="failsafe-status mono" id="failsafe-status-msg">
                Power status: Disconnected (Battery)
              </div>
            </div>

            <!-- Hint Box -->
            <div class="simulator-hint">
              <div class="hint-icon">💡</div>
              <p>
                <strong>Try tapping the phone screen above!</strong> A shield badge will indicate that touches
                are discarded while the cartoon bus continues rolling.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Zero-Trust Privacy & Architecture Breakdown -->
    <section class="section tech-section">
      <div class="container">
        <div class="section-header">
          <div class="eyebrow mono">Security Architecture</div>
          <h2 class="section-title">Zero-Trust Privacy vs. Invasive Screen Lockers</h2>
          <p class="section-subtitle">
            Most Android screen-lock apps on Google Play require intrusive permissions: full accessibility
            DOM inspection, network access to load ad SDKs, and device administrator rights. TouchGuard was
            engineered from day one with mathematical privacy constraints.
          </p>
        </div>

        <!-- Comparison Table Card -->
        <div class="comparison-card card">
          <div class="comparison-table-wrapper">
            <table class="comparison-table">
              <thead>
                <tr>
                  <th>Security Attribute</th>
                  <th>Typical "Free" Lock Apps</th>
                  <th>TouchGuard (Burgess Meditation LLC)</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>Internet Permission</strong></td>
                  <td class="text-danger"><code>android.permission.INTERNET</code> (Tracks telemetry & ad impressions)</td>
                  <td class="text-accent-2"><strong>NONE</strong>. Completely omitted from <code>AndroidManifest.xml</code>.</td>
                </tr>
                <tr>
                  <td><strong>Screen Content Reading</strong></td>
                  <td class="text-danger"><code>canRetrieveWindowContent="true"</code> (Inspects texts & DOM)</td>
                  <td class="text-accent-2"><strong><code>canRetrieveWindowContent="false"</code></strong> (Physically blocked by OS)</td>
                </tr>
                <tr>
                  <td><strong>Simulated Gestures</strong></td>
                  <td class="text-danger"><code>canPerformGestures="true"</code> (Can simulate touches/clicks)</td>
                  <td class="text-accent-2"><strong><code>canPerformGestures="false"</code></strong> (Cannot click or tap)</td>
                </tr>
                <tr>
                  <td><strong>Window Ingestion</strong></td>
                  <td>Standard foreground floaters (often bypassable)</td>
                  <td class="text-accent-2"><strong><code>TYPE_ACCESSIBILITY_OVERLAY</code></strong> (Native OS input sink)</td>
                </tr>
                <tr>
                  <td><strong>Account or Sign-in</strong></td>
                  <td class="text-danger">Requires email / OAuth tracking</td>
                  <td class="text-accent-2"><strong>Zero account</strong>. 100% offline standalone operation.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Architecture Pillars Grid -->
        <div class="pillars-grid">
          <div class="pillar-card card">
            <div class="pillar-num mono text-accent">01</div>
            <h3 class="pillar-title">WindowManager Layer Input Sink</h3>
            <p class="pillar-text">
              By utilizing Android's specialized <code>TYPE_ACCESSIBILITY_OVERLAY</code> window parameter,
              the lock screen is rendered above normal application windows, navigation bars, and notification
              shades. It consumes all touch, multitouch, and edge swipe events before they ever reach underlying
              apps like YouTube or Netflix.
            </p>
            <div class="code-snippet mono">
              <pre><code>val params = WindowManager.LayoutParams(
    MATCH_PARENT, MATCH_PARENT,
    TYPE_ACCESSIBILITY_OVERLAY,
    FLAG_NOT_FOCUSABLE or FLAG_LAYOUT_IN_SCREEN,
    PixelFormat.TRANSLUCENT
)</code></pre>
            </div>
          </div>

          <div class="pillar-card card">
            <div class="pillar-num mono text-accent-2">02</div>
            <h3 class="pillar-title">Declarative OS-Enforced Blindness</h3>
            <p class="pillar-text">
              Android's accessibility framework requires declaring service capabilities in XML.
              By explicitly binding <code>canRetrieveWindowContent="false"</code>, the Android OS kernel
              refuses to give the service access to screen text, banking inputs, or video calls.
            </p>
            <div class="code-snippet mono">
              <pre><code>&lt;accessibility-service
    xmlns:android="..."
    android:accessibilityEventTypes="typeAllMask"
    android:canRetrieveWindowContent="false"
    android:canPerformGestures="false"
    android:accessibilityFlags="flagDefault" /&gt;</code></pre>
            </div>
          </div>

          <div class="pillar-card card">
            <div class="pillar-num mono text-purple">03</div>
            <h3 class="pillar-title">Hardware Broadcast Failsafe</h3>
            <p class="pillar-text">
              To prevent accidental device lockouts if volume keys are jammed or a parent forgets the sequence,
              a registered <code>BroadcastReceiver</code> listens directly for <code>ACTION_POWER_CONNECTED</code>.
              Connecting a charging cable immediately drops the overlay and restores normal operation.
            </p>
            <div class="code-snippet mono">
              <pre><code>override fun onReceive(context: Context, intent: Intent) &#123;
    if (intent.action == Intent.ACTION_POWER_CONNECTED) &#123;
        unlockAccessibilityOverlay()
    &#125;
&#125;</code></pre>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Conversion Bridge Banner -->
    <section class="section cta-section">
      <div class="container">
        <div class="cta-banner">
          <div class="eyebrow mono">Mobile & Utility Engineering</div>
          <h2 class="cta-title">Need a privacy-first mobile utility or custom workflow built with zero bloat?</h2>
          <p class="cta-text">
            From hardened native Android utilities to production AI agent pipelines and homelab microservices,
            I engineer local-first, zero-telemetry software that respects user privacy and runs with peak efficiency.
          </p>
          <div class="cta-actions">
            <a href="/#contact" class="btn btn-primary">
              Discuss Your App or Workflow →
            </a>
            <a href="/#projects" class="btn btn-secondary">
              Explore Other Showcase Projects
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function initToddlerSimulator() {
    var phone = document.getElementById('sim-phone');
    var screen = document.getElementById('phone-screen');
    var overlay = document.getElementById('touchguard-overlay');
    var unlockedOverlay = document.getElementById('unlocked-overlay');
    var feedback = document.getElementById('touch-feedback');
    var spark = document.getElementById('usbc-spark');
    var usbcBtn = document.getElementById('btn-toggle-usbc');
    var usbcLabel = document.getElementById('usbc-btn-label');
    var failsafeMsg = document.getElementById('failsafe-status-msg');
    var statusMsg = document.getElementById('combo-status-msg');
    var timerFill = document.getElementById('timer-fill');

    var btnVolUp = document.getElementById('btn-vol-up');
    var btnVolDown = document.getElementById('btn-vol-down');
    var panelVolUp = document.getElementById('panel-vol-up');
    var panelVolDown = document.getElementById('panel-vol-down');
    var panelVolReset = document.getElementById('panel-vol-reset');
    var btnRelock = document.getElementById('btn-relock');

    var stepElements = document.querySelectorAll('.seq-step');

    // Sequence state: Target is 0, 1, 2 = Down; 3, 4, 5 = Up
    var currentStep = 0;
    var isLocked = true;
    var isChargerConnected = false;
    var timerTimeout = null;
    var timerInterval = null;
    var feedbackTimeout = null;
    var timerDuration = 5000; // 5 seconds
    var timerStartedAt = 0;

    function updateClock() {
      var d = new Date();
      var el = document.getElementById('sim-time');
      if (el) {
        var h = d.getHours().toString().padStart(2, '0');
        var m = d.getMinutes().toString().padStart(2, '0');
        el.textContent = h + ':' + m;
      }
    }
    setInterval(updateClock, 30000);
    updateClock();

    function setLocked(locked) {
      isLocked = locked;
      if (locked) {
        overlay.classList.add('active');
        unlockedOverlay.classList.remove('active');
        phone.classList.remove('is-unlocked');
      } else {
        overlay.classList.remove('active');
        unlockedOverlay.classList.add('active');
        phone.classList.add('is-unlocked');
        resetSequence('Unlocked! Normal input active.');
      }
    }

    function resetTimer() {
      if (timerTimeout) clearTimeout(timerTimeout);
      if (timerInterval) clearInterval(timerInterval);
      if (timerFill) timerFill.style.width = '0%';
    }

    function startTimer() {
      resetTimer();
      timerStartedAt = Date.now();
      timerFill.style.width = '100%';
      timerInterval = setInterval(function () {
        var elapsed = Date.now() - timerStartedAt;
        var remaining = Math.max(0, timerDuration - elapsed);
        var pct = (remaining / timerDuration) * 100;
        if (timerFill) timerFill.style.width = pct + '%';
        if (remaining <= 0) {
          resetSequence('Sequence timed out. Resetting to step 1.');
        }
      }, 50);
    }

    function renderDots() {
      stepElements.forEach(function (el, idx) {
        el.classList.remove('active', 'success', 'error');
        if (idx < currentStep) {
          el.classList.add('success');
        } else if (idx === currentStep && isLocked) {
          el.classList.add('active');
        }
      });
    }

    function resetSequence(msg) {
      currentStep = 0;
      resetTimer();
      renderDots();
      if (statusMsg && msg) {
        statusMsg.textContent = msg;
      }
    }

    function flashError(msg) {
      stepElements.forEach(function (el) {
        el.classList.add('error');
      });
      if (statusMsg) statusMsg.textContent = msg;
      setTimeout(function () {
        resetSequence('Wrong button! Target sequence: Vol Down ×3, then Vol Up ×3');
      }, 650);
    }

    function handleKeyPress(key) {
      if (!isLocked) return;

      // Expected:
      // steps 0, 1, 2 => 'DOWN'
      // steps 3, 4, 5 => 'UP'
      if (currentStep < 3) {
        if (key === 'DOWN') {
          currentStep++;
          startTimer();
          statusMsg.textContent = 'Correct: Vol Down (' + currentStep + ' of 3). Keep going!';
          renderDots();
        } else {
          flashError('Expected Volume Down! Sequence reset.');
          return;
        }
      } else if (currentStep < 6) {
        if (key === 'UP') {
          currentStep++;
          renderDots();
          if (currentStep === 6) {
            resetTimer();
            statusMsg.textContent = 'Sequence complete! Unlocking screen...';
            setTimeout(function () {
              setLocked(false);
            }, 300);
          } else {
            startTimer();
            statusMsg.textContent = 'Correct: Vol Up (' + (currentStep - 3) + ' of 3). Almost there!';
          }
        } else {
          flashError('Expected Volume Up! Sequence reset.');
          return;
        }
      }
    }

    // Screen Touch Ripple Feedback
    function onScreenTouch(e) {
      if (!isLocked) return;
      e.preventDefault();

      // Ripple position
      var rect = screen.getBoundingClientRect();
      var x = (e.clientX || (e.touches && e.touches[0].clientX) || (rect.left + rect.width / 2)) - rect.left;
      var y = (e.clientY || (e.touches && e.touches[0].clientY) || (rect.top + rect.height / 2)) - rect.top;

      var ripple = document.createElement('div');
      ripple.className = 'touch-ripple';
      ripple.style.left = x + 'px';
      ripple.style.top = y + 'px';
      screen.appendChild(ripple);

      setTimeout(function () {
        if (ripple.parentNode) ripple.parentNode.removeChild(ripple);
      }, 700);

      // Show shield badge briefly
      feedback.classList.add('visible');
      if (feedbackTimeout) clearTimeout(feedbackTimeout);
      feedbackTimeout = setTimeout(function () {
        feedback.classList.remove('visible');
      }, 1800);
    }

    screen.addEventListener('mousedown', onScreenTouch);
    screen.addEventListener('touchstart', onScreenTouch, { passive: false });

    // Buttons
    function triggerVolUp() {
      btnVolUp.classList.add('pressed');
      setTimeout(function () { btnVolUp.classList.remove('pressed'); }, 150);
      handleKeyPress('UP');
    }

    function triggerVolDown() {
      btnVolDown.classList.add('pressed');
      setTimeout(function () { btnVolDown.classList.remove('pressed'); }, 150);
      handleKeyPress('DOWN');
    }

    btnVolUp.addEventListener('click', triggerVolUp);
    btnVolDown.addEventListener('click', triggerVolDown);
    panelVolUp.addEventListener('click', triggerVolUp);
    panelVolDown.addEventListener('click', triggerVolDown);
    panelVolReset.addEventListener('click', function () {
      resetSequence('Sequence cleared manually.');
    });

    // USB-C Charger Toggle
    usbcBtn.addEventListener('click', function () {
      isChargerConnected = !isChargerConnected;
      if (isChargerConnected) {
        spark.classList.add('sparking');
        usbcLabel.textContent = 'Unplug USB-C Charger 🔌';
        failsafeMsg.textContent = 'Power status: CONNECTED ⚡ (ACTION_POWER_CONNECTED fired!)';
        failsafeMsg.classList.add('text-accent-2');
        setLocked(false);
      } else {
        spark.classList.remove('sparking');
        usbcLabel.textContent = 'Plug in USB-C Charger ⚡';
        failsafeMsg.textContent = 'Power status: Disconnected (Battery)';
        failsafeMsg.classList.remove('text-accent-2');
      }
    });

    btnRelock.addEventListener('click', function () {
      if (isChargerConnected) {
        // Automatically unplug to allow locking
        isChargerConnected = false;
        spark.classList.remove('sparking');
        usbcLabel.textContent = 'Plug in USB-C Charger ⚡';
        failsafeMsg.textContent = 'Power status: Disconnected (Battery)';
        failsafeMsg.classList.remove('text-accent-2');
      }
      setLocked(true);
      resetSequence('Screen re-locked. Test volume buttons or charger again.');
    });

    renderDots();
  })();
</script>

