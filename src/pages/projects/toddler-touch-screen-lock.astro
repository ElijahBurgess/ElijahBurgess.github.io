---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
---

<ProjectLayout
  title="Toddler Touch Screen Lock"
  description="Offline Android utility using TYPE_ACCESSIBILITY_OVERLAY and hardware volume-key sequences to block accidental screen taps during video playback or calls."
  canonicalPath="/projects/toddler-touch-screen-lock"
  category="Android Utility · Burgess Meditation LLC"
  summary="Published, 100% offline Android app that absorbs stray screen touches during cartoons or family video calls, unlocked via a physical volume-button cadence or USB-C power failsafe."
  stack={['Kotlin', 'Android SDK', 'TYPE_ACCESSIBILITY_OVERLAY', 'Google Play']}
  liveUrl="https://play.google.com/store/apps/details?id=com.burgessmeditation.touchguard"
  liveLabel="Get on Google Play ↗"
  secondaryUrl="/toddler-touch-screen-lock-privacy/"
  secondaryLabel="Privacy Policy"
>
  <!-- Interactive Hardware Unlock Walkthrough & Tester -->
  <section class="studio-panel simulator-panel" aria-labelledby="unlock-heading">
    <div class="panel-top">
      <div>
        <span class="spec-label">Hardware Unlock Walkthrough</span>
        <h2 id="unlock-heading" class="panel-title">Volume Cadence &amp; USB-C Failsafe Tester</h2>
      </div>
      <span class="state-badge mono" id="overlay-state-badge">Overlay: LOCKED</span>
    </div>

    <div class="sim-grid">
      <!-- Simulated Device Viewport -->
      <div class="device-frame" id="sim-device">
        <div class="device-header mono">
          <span id="sim-clock">10:42</span>
          <span>com.burgessmeditation.touchguard</span>
        </div>

        <div
          class="device-viewport"
          id="phone-screen"
          tabindex="0"
          role="button"
          aria-label="Simulated locked screen. Activate or click to test touch absorption."
        >
          <div class="playback-layer">
            <span class="spec-label">Active Media Surface</span>
            <strong class="playback-title">Family Video Call / Playback Active</strong>
            <div class="playback-bar" aria-hidden="true">
              <div class="playback-fill"></div>
            </div>
            <p class="playback-note mono" id="touch-log" aria-live="polite">
              Tap or click anywhere inside this viewport to test input blocking.
            </p>
          </div>

          <div class="unlocked-banner" id="unlocked-banner" hidden>
            <strong class="mono">OVERLAY DISMISSED</strong>
            <p>Normal Android touch input restored.</p>
            <button type="button" id="btn-relock" class="btn btn-primary btn-sm">
              Re-Lock Screen
            </button>
          </div>
        </div>

        <div class="device-footer mono">
          <span id="power-state-text">USB-C: Disconnected</span>
          <span>WindowManager Sink</span>
        </div>
      </div>

      <!-- Controls: Volume Down x3 -> Volume Up x3 + USB-C Failsafe -->
      <div class="unlock-controls">
        <div class="mechanism-box">
          <div class="mech-head">
            <span class="spec-label">Primary Unlock</span>
            <h3 class="mech-title">Volume Down ×3 → Volume Up ×3</h3>
          </div>
          <p class="mech-desc">
            Hardware key events bypass the capacitive screen overlay. Complete all six presses within 5 seconds to dismiss the lock.
          </p>

          <div class="sequence-track mono" id="sequence-dots" aria-label="6-step volume sequence progress">
            <div class="seq-cell is-current" data-step="0"><span>▼</span><small>Dn 1</small></div>
            <div class="seq-cell" data-step="1"><span>▼</span><small>Dn 2</small></div>
            <div class="seq-cell" data-step="2"><span>▼</span><small>Dn 3</small></div>
            <div class="seq-cell" data-step="3"><span>▲</span><small>Up 1</small></div>
            <div class="seq-cell" data-step="4"><span>▲</span><small>Up 2</small></div>
            <div class="seq-cell" data-step="5"><span>▲</span><small>Up 3</small></div>
          </div>

          <div class="timer-track" aria-hidden="true">
            <div class="timer-fill" id="timer-fill"></div>
          </div>

          <p class="combo-status mono" id="combo-status-msg" aria-live="polite">
            Ready: press [Vol −] three times, then [Vol +] three times.
          </p>

          <div class="hw-btn-row">
            <button type="button" id="btn-vol-down" class="btn btn-ghost btn-sm mono">
              [ Vol − ]
            </button>
            <button type="button" id="btn-vol-up" class="btn btn-ghost btn-sm mono">
              [ Vol + ]
            </button>
            <button type="button" id="btn-vol-reset" class="btn btn-ghost btn-sm">
              Reset
            </button>
          </div>
        </div>

        <div class="mechanism-box">
          <div class="mech-head">
            <span class="spec-label">Hardware Failsafe</span>
            <h3 class="mech-title">USB-C Power Broadcast</h3>
          </div>
          <p class="mech-desc">
            If a parent forgets the volume sequence, plugging in any USB-C charging cable fires <code>ACTION_POWER_CONNECTED</code> and immediately drops the overlay.
          </p>
          <button type="button" id="btn-toggle-usbc" class="btn btn-ghost btn-sm">
            Simulate USB-C Charger Connect
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Privacy & Android Overlay Architecture -->
  <section aria-labelledby="privacy-arch-heading" class="section-stack">
    <div class="prose-block">
      <span class="spec-label">Privacy &amp; OS Architecture</span>
      <h2 id="privacy-arch-heading">Zero Network Permissions &amp; Blind Overlay Design</h2>
      <p>
        Many screen-lock utilities bundle ad SDKs, request network access, or enable full Accessibility DOM inspection. Toddler Touch Screen Lock (<code>com.burgessmeditation.touchguard</code>) omits <code>android.permission.INTERNET</code> from <code>AndroidManifest.xml</code> entirely—the Android OS kernel denies the process any network socket access.
      </p>
      <p>
        Touch blocking uses a translucent <code>TYPE_ACCESSIBILITY_OVERLAY</code> window to absorb multi-touch and edge-swipe events before they reach underlying video players. In its service configuration, both <code>canRetrieveWindowContent="false"</code> and <code>canPerformGestures="false"</code> are enforced by the OS so the app can neither read on-screen text nor synthesize taps. Full compliance details are published in the <a href="/toddler-touch-screen-lock-privacy/" class="inline-policy-link">Toddler Touch Screen Lock Privacy Policy</a>.
      </p>
    </div>

    <div class="spec-grid">
      <div class="spec-cell">
        <span class="spec-label">01 / Input Sink</span>
        <h3 class="spec-title"><code>TYPE_ACCESSIBILITY_OVERLAY</code></h3>
        <p class="spec-text">Intercepts multi-touch and system-bar edge swipes at the WindowManager layer without Device Admin privileges.</p>
      </div>
      <div class="spec-cell">
        <span class="spec-label">02 / OS Blindness</span>
        <h3 class="spec-title">No Window Inspection</h3>
        <p class="spec-text">Declares <code>canRetrieveWindowContent="false"</code> and <code>canPerformGestures="false"</code> in XML.</p>
      </div>
      <div class="spec-cell">
        <span class="spec-label">03 / Zero Telemetry</span>
        <h3 class="spec-title">No <code>INTERNET</code> Permission</h3>
        <p class="spec-text">Zero analytics SDKs, zero ad networks, zero user accounts, and zero bytes transmitted off-device.</p>
      </div>
      <div class="spec-cell">
        <span class="spec-label">04 / Compliance</span>
        <h3 class="spec-title">Published on Google Play</h3>
        <p class="spec-text">Shipped by Burgess Meditation LLC with a standalone <a href="/toddler-touch-screen-lock-privacy/" class="inline-policy-link">public privacy policy</a>.</p>
      </div>
    </div>
  </section>
</ProjectLayout>

<script is:inline>
  (function initTouchGuardTester() {
    var screen = document.getElementById('phone-screen');
    var touchLog = document.getElementById('touch-log');
    var unlockedBanner = document.getElementById('unlocked-banner');
    var stateBadge = document.getElementById('overlay-state-badge');
    var powerText = document.getElementById('power-state-text');
    var statusMsg = document.getElementById('combo-status-msg');
    var timerFill = document.getElementById('timer-fill');

    var btnVolDown = document.getElementById('btn-vol-down');
    var btnVolUp = document.getElementById('btn-vol-up');
    var btnVolReset = document.getElementById('btn-vol-reset');
    var btnUsbc = document.getElementById('btn-toggle-usbc');
    var btnRelock = document.getElementById('btn-relock');
    var stepEls = document.querySelectorAll('.seq-cell');

    var currentStep = 0;
    var isLocked = true;
    var isChargerConnected = false;
    var blockedCount = 0;
    var timerInterval = null;
    var timerDuration = 5000;
    var timerStartedAt = 0;

    function updateClock() {
      var el = document.getElementById('sim-clock');
      if (!el) return;
      var d = new Date();
      el.textContent =
        String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
    }
    updateClock();

    function stopTimer() {
      if (timerInterval) clearInterval(timerInterval);
      timerInterval = null;
      if (timerFill) timerFill.style.width = '0%';
    }

    function startTimer() {
      stopTimer();
      timerStartedAt = Date.now();
      if (timerFill) timerFill.style.width = '100%';
      timerInterval = setInterval(function () {
        var remaining = Math.max(0, timerDuration - (Date.now() - timerStartedAt));
        if (timerFill) timerFill.style.width = (remaining / timerDuration) * 100 + '%';
        if (remaining <= 0) {
          resetSequence('5s window expired — sequence reset to step 1.');
        }
      }, 60);
    }

    function renderSteps(isError) {
      stepEls.forEach(function (el, idx) {
        el.classList.remove('is-current', 'is-done', 'is-error');
        if (isError) {
          el.classList.add('is-error');
        } else if (idx < currentStep) {
          el.classList.add('is-done');
        } else if (idx === currentStep && isLocked) {
          el.classList.add('is-current');
        }
      });
    }

    function resetSequence(message) {
      currentStep = 0;
      stopTimer();
      renderSteps(false);
      if (statusMsg && message) statusMsg.textContent = message;
    }

    function setLocked(locked, reason) {
      isLocked = locked;
      if (unlockedBanner) unlockedBanner.hidden = locked;
      if (stateBadge) {
        stateBadge.textContent = locked ? 'Overlay: LOCKED' : 'Overlay: UNLOCKED';
        stateBadge.className = locked ? 'state-badge mono' : 'state-badge mono is-unlocked';
      }
      if (locked) {
        blockedCount = 0;
        if (touchLog) {
          touchLog.textContent = 'Tap or click anywhere inside this viewport to test input blocking.';
        }
        resetSequence('Ready: press [Vol −] three times, then [Vol +] three times.');
      } else {
        stopTimer();
        currentStep = 6;
        renderSteps(false);
        if (statusMsg && reason) statusMsg.textContent = reason;
      }
    }

    function handleVolumeKey(dir) {
      if (!isLocked) return;
      var expected = currentStep < 3 ? 'DOWN' : 'UP';
      if (dir === expected) {
        currentStep += 1;
        renderSteps(false);
        if (currentStep === 6) {
          setLocked(false, 'Unlocked via Volume Down ×3 -> Volume Up ×3.');
        } else {
          startTimer();
          statusMsg.textContent =
            currentStep <= 3
              ? 'Recorded Vol − (' + currentStep + '/3). Continue...'
              : 'Recorded Vol + (' + (currentStep - 3) + '/3). Almost unlocked...';
        }
      } else {
        renderSteps(true);
        if (statusMsg) statusMsg.textContent = 'Out-of-order key — resetting cadence...';
        setTimeout(function () {
          resetSequence('Target order: [Vol −] ×3 followed by [Vol +] ×3.');
        }, 500);
      }
    }

    if (screen) {
      screen.addEventListener('click', function (e) {
        if (!isLocked) return;
        if (e.target && e.target.id === 'btn-relock') return;
        blockedCount += 1;
        if (touchLog) {
          touchLog.textContent =
            'Absorbed touch #' + blockedCount + ' via TYPE_ACCESSIBILITY_OVERLAY — playback uninterrupted.';
        }
      });
      screen.addEventListener('keydown', function (e) {
        if (!isLocked) return;
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          blockedCount += 1;
          if (touchLog) {
            touchLog.textContent =
              'Absorbed input #' + blockedCount + ' via TYPE_ACCESSIBILITY_OVERLAY — playback uninterrupted.';
          }
        }
      });
    }

    if (btnVolDown) {
      btnVolDown.addEventListener('click', function () {
        handleVolumeKey('DOWN');
      });
    }
    if (btnVolUp) {
      btnVolUp.addEventListener('click', function () {
        handleVolumeKey('UP');
      });
    }
    if (btnVolReset) {
      btnVolReset.addEventListener('click', function () {
        if (isLocked) resetSequence('Sequence cleared.');
      });
    }

    if (btnUsbc) {
      btnUsbc.addEventListener('click', function () {
        isChargerConnected = !isChargerConnected;
        if (isChargerConnected) {
          btnUsbc.textContent = 'Disconnect USB-C Charger';
          if (powerText) powerText.textContent = 'USB-C: Connected (ACTION_POWER_CONNECTED)';
          setLocked(false, 'Unlocked immediately via ACTION_POWER_CONNECTED failsafe.');
        } else {
          btnUsbc.textContent = 'Simulate USB-C Charger Connect';
          if (powerText) powerText.textContent = 'USB-C: Disconnected';
        }
      });
    }

    if (btnRelock) {
      btnRelock.addEventListener('click', function (e) {
        e.stopPropagation();
        if (isChargerConnected) {
          isChargerConnected = false;
          if (btnUsbc) btnUsbc.textContent = 'Simulate USB-C Charger Connect';
          if (powerText) powerText.textContent = 'USB-C: Disconnected';
        }
        setLocked(true);
      });
    }
  })();
</script>

<style>
  .section-stack {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .simulator-panel {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  .panel-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .panel-title {
    font-size: 1.2rem;
    margin-top: 0.25rem;
  }

  .state-badge {
    font-size: 0.76rem;
    padding: 0.36rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-accent);
    color: var(--accent);
    background: var(--bg-canvas);
  }

  .state-badge.is-unlocked {
    border-color: var(--border-strong);
    color: var(--live-dot);
  }

  .sim-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 1.25rem;
    align-items: stretch;
  }

  .device-frame {
    background: var(--bg-canvas);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
  }

  .device-header,
  .device-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.6rem 0.9rem;
    font-size: 0.72rem;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border-hairline);
  }

  .device-footer {
    border-bottom: none;
    border-top: 1px solid var(--border-hairline);
  }

  .device-viewport {
    position: relative;
    flex: 1;
    min-height: 230px;
    padding: 1.35rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    cursor: pointer;
    user-select: none;
  }

  .playback-layer {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .playback-title {
    font-size: 1.02rem;
    color: var(--text-primary);
  }

  .playback-bar {
    height: 4px;
    width: 100%;
    background: var(--bg-elevated);
    border-radius: 2px;
    overflow: hidden;
  }

  .playback-fill {
    width: 62%;
    height: 100%;
    background: var(--accent);
  }

  .playback-note {
    font-size: 0.78rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .unlocked-banner {
    position: absolute;
    inset: 0;
    background: rgba(9, 11, 15, 0.94);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    padding: 1.25rem;
    text-align: center;
  }

  .unlocked-banner[hidden] {
    display: none;
  }

  .unlocked-banner strong {
    color: var(--live-dot);
    font-size: 0.85rem;
  }

  .unlocked-banner p {
    font-size: 0.88rem;
    color: var(--text-secondary);
    margin-bottom: 0.25rem;
  }

  .unlock-controls {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .mechanism-box {
    background: var(--bg-canvas);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-sm);
    padding: 1.15rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.7rem;
  }

  .mech-head {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .mech-title {
    font-size: 1rem;
  }

  .mech-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
  }

  .sequence-track {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    border-top: 1px solid var(--border-hairline);
    border-left: 1px solid var(--border-hairline);
  }

  .seq-cell {
    padding: 0.5rem 0.25rem;
    border-right: 1px solid var(--border-hairline);
    border-bottom: 1px solid var(--border-hairline);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .seq-cell small {
    font-size: 0.66rem;
  }

  .seq-cell.is-current {
    color: var(--accent);
    background: var(--accent-soft);
  }

  .seq-cell.is-done {
    color: var(--live-dot);
  }

  .seq-cell.is-error {
    color: var(--danger);
  }

  .timer-track {
    width: 100%;
    height: 3px;
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .timer-fill {
    width: 0%;
    height: 100%;
    background: var(--accent);
    transition: width 60ms linear;
  }

  .combo-status {
    font-size: 0.76rem;
    color: var(--text-secondary);
  }

  .hw-btn-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .prose-block code,
  .spec-title code,
  .spec-text code,
  .mech-desc code {
    font-family: var(--font-mono);
    font-size: 0.86em;
    color: var(--text-primary);
  }

  .inline-policy-link {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .inline-policy-link:hover {
    color: var(--accent-hover);
  }

  @media (max-width: 860px) {
    .sim-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 440px) {
    .device-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
