---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="eBay Homelab Deal Hunter — Autonomous Price Arbitrage | Elijah Burgess"
  description="Autonomous hardware scraper and valuation engine scanning eBay for enterprise SFF PCs, TinyMiniMicro nodes, and homelab components, calculating live dynamic P20 market benchmarks."
  canonicalPath="/projects/deal-hunter"
>
  <div class="project-showcase">
    <!-- Breadcrumb -->
    <div class="container breadcrumb-container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep">/</span>
        <a href="/#projects">Projects</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">eBay Homelab Deal Hunter</span>
      </nav>
    </div>

    <!-- Hero Header -->
    <section class="section hero-section">
      <div class="container hero-container">
        <div class="hero-content">
          <div class="eyebrow mono">
            <span class="status-dot online"></span>
            Autonomous Scraping & Market Intelligence // Proxmox CT 104
          </div>
          <h1 class="hero-title">eBay Homelab Deal Hunter</h1>
          <p class="hero-summary">
            An autonomous market scanner that continuously tracks thousands of eBay enterprise hardware listings
            (Lenovo Tiny, Dell Micro, HP EliteDesk, ECC RAM, Coral TPUs, and NVMe drives). Using regex spec extractors
            and dynamic <strong>P20 percentile pricing models</strong>, Deal Hunter filters through messy listing titles
            to alert on genuine below-market homelab bargains.
          </p>

          <div class="tags hero-tags">
            <span class="tag mono">Proxmox CT 104</span>
            <span class="tag mono">Read-Only SQLite (?mode=ro)</span>
            <span class="tag mono">Automated Percentile Benchmarking</span>
            <span class="tag mono">Pushover Instant Alerts</span>
            <span class="tag mono">FastAPI + Playwright</span>
          </div>

          <div class="hero-actions">
            <a href="#deals-explorer" class="btn btn-primary">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="8"></circle>
                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
              </svg>
              Explore Live Hardware Deals ↓
            </a>
            <a href="#benchmarks" class="btn btn-secondary">
              View Market Benchmarks
            </a>
          </div>
        </div>

        <div class="hero-summary-card card">
          <h2 class="summary-card-title mono">Scanner Highlights</h2>
          <ul class="summary-card-list">
            <li>
              <div class="summary-metric mono text-accent" id="hero-tracked-count">2,726</div>
              <div class="summary-label">Tracked Hardware Listings</div>
              <p class="summary-desc">Active eBay auctions and Buy-It-Now items tracked across 12 rule sets.</p>
            </li>
            <li>
              <div class="summary-metric mono text-accent-2" id="hero-active-deals">42</div>
              <div class="summary-label">Active Below-Ceiling Deals</div>
              <p class="summary-desc">Priced below dynamic P20 tier ceilings with confirmed specs.</p>
            </li>
            <li>
              <div class="summary-metric mono text-purple" id="hero-top-discount">58%</div>
              <div class="summary-label">Peak Live Arbitrage</div>
              <p class="summary-desc">Maximum discount currently discovered vs. estimated market median.</p>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- Live Summary KPI Cards Strip -->
    <section class="section kpi-section">
      <div class="container">
        <div class="kpi-grid">
          <!-- Card 1 -->
          <div class="kpi-card card">
            <div class="kpi-header">
              <span class="kpi-title">Tracked Listings</span>
              <span class="kpi-tag mono">SQLite</span>
            </div>
            <div class="kpi-number mono text-accent" id="kpi-total-items">2,726</div>
            <div class="kpi-sub">Continuous item catalog</div>
          </div>

          <!-- Card 2 -->
          <div class="kpi-card card">
            <div class="kpi-header">
              <span class="kpi-title">Active Deals</span>
              <span class="kpi-tag mono text-accent-2">Below P20</span>
            </div>
            <div class="kpi-number mono text-accent-2" id="kpi-active-deals">42</div>
            <div class="kpi-sub">Meets quality & seller bar</div>
          </div>

          <!-- Card 3 -->
          <div class="kpi-card card">
            <div class="kpi-header">
              <span class="kpi-title">Top Live Discount</span>
              <span class="kpi-tag mono text-purple">Peak</span>
            </div>
            <div class="kpi-number mono text-purple" id="kpi-top-discount">58.4%</div>
            <div class="kpi-sub">Below market baseline</div>
          </div>

          <!-- Card 4 -->
          <div class="kpi-card card">
            <div class="kpi-header">
