    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function classifyGroup(item) {
      var r = String((item && item.rule_name) || '').toLowerCase();
      var t = String((item && item.title) || '').toLowerCase();
      if (/adapter|sata\s+pcie|6-port|asm1166|hba|cable|caddy|riser|network\s+card|\bnic\b/.test(r)) {
        return 'expansion';
      }
      if (/coral|tpu|accelerator|\bgpu\b|nvidia|quadro|t400|t600|rtx|radeon/.test(r)) {
        return 'accelerators';
      }
      if (/\bddr\d?\b|\bdimm\b|\budimm\b|\bsodimm\b|ecc_udimm|\bram\b/.test(r)) {
        return 'ram';
      }
      if (/\bssd\b|\bnvme\b|m\.2\s*2280|nvme_ssd/.test(r)) {
        return 'ssds';
      }
      if (/optiplex|precision|elitedesk|prodesk|thinkcentre|thinkstation|z2|m720|m920|tiny|sff|micro|mini/.test(r)) {
        return 'pcs';
      }
      if (/\bddr4\b|\bddr5\b|\bdimm\b/.test(t)) return 'ram';
      if (/\bnvme\b|\bssd\b/.test(t)) return 'ssds';
      if (/optiplex|elitedesk|thinkcentre|workstation|mini pc/.test(t)) return 'pcs';
      return 'other';
    }

    function formatTierLabel(tier) {
      if (!tier) return '';
      if (tier === 'COMPLETE_TURNKEY') return 'Complete System';
      if (tier === 'COMPLETE_NO_DRIVE') return 'No Drive';
      if (tier === 'STANDALONE_COMPONENT') return 'Component';
      if (tier === 'CAPACITY_MISMATCH') return 'Memory Kit';
      return tier.replace(/_/g, ' ');
    }

    function formatFormatLabel(fmt) {
      if (!fmt || fmt === 'FIXED_PRICE') return 'Buy It Now';
      if (fmt === 'AUCTION') return 'Auction';
      return String(fmt).replace(/_/g, ' ');
    }

    function extractEbayItemId(item) {
      if (item && item.item_url) {
        var m = String(item.item_url).match(/\/itm\/(\d{8,15})/);
        if (m) return m[1];
      }
      if (item && item.item_id) {
        var parts = String(item.item_id).split('|');
        for (var i = 0; i < parts.length; i++) {
          if (/^\d{8,15}$/.test(parts[i])) return parts[i];
        }
      }
      return '';
    }

