        seller_feedback_score: 6975,
        seller_positive_percent: 99.9,
        item_url: 'https://www.ebay.com/itm/128191190749',
        image_url: 'https://i.ebayimg.com/images/g/xKwAAeSwh~pq9g5h/s-l225.jpg',
      },
      {
        item_id: 'v1|377642460879|0',
        rule_name: 'Google Coral Edge TPU (PCIe / M.2 AI Accelerator)',
        title: 'Google Coral M.2 Accelerator with Dual Edge TPU PCIe Module',
        total_price: 39.0,
        shipping_cost: 0.0,
        effective_ceiling: 80.0,
        savings_dollars: 41.0,
        savings_pct: 51.2,
        detected_cpu: null,
        detected_ram_gb: 0,
        detected_storage: null,
        condition_name: 'Used',
        buying_format: 'FIXED_PRICE',
        config_tier: 'STANDALONE_COMPONENT',
        seller_feedback_score: 78,
        seller_positive_percent: 96.8,
        item_url: 'https://www.ebay.com/itm/377642460879',
        image_url: 'https://i.ebayimg.com/images/g/Dw0AAeSwyYNq9wkG/s-l225.jpg',
      },
    ];

    function setSourceIndicator(isLive, activeCount) {
      if (sourceDot) {
        sourceDot.className = isLive ? 'status-dot is-online' : 'status-dot';
      }
      if (sourceLabel) {
        if (isLive) {
          sourceLabel.textContent =
            typeof activeCount === 'number' && activeCount > 0
              ? 'Live eBay Feed · ' + activeCount + ' Active'
              : 'Live eBay Feed (Online)';
        } else {
          sourceLabel.textContent = 'Sample eBay Snapshot (Offline)';
        }
      }
    }

    function applyClientFiltersAndSort(list, includeGroupFilter) {
      var minPct = filterVerdict && filterVerdict.value ? parseFloat(filterVerdict.value) : 0;
      var sortKey = filterSort ? filterSort.value : 'savings_pct_desc';

      var out = list.filter(function (item) {
        if (Number(item.savings_pct || 0) < minPct) return false;
        if (includeGroupFilter && selectedGroup && classifyGroup(item) !== selectedGroup) {
          return false;
        }
        return true;
      });

      out.sort(function (a, b) {
        if (sortKey === 'savings_dollars_desc') {
          return Number(b.savings_dollars || 0) - Number(a.savings_dollars || 0);
        }
        if (sortKey === 'price_asc') {
          return Number(a.total_price || 0) - Number(b.total_price || 0);
        }
        if (sortKey === 'price_desc') {
          return Number(b.total_price || 0) - Number(a.total_price || 0);
        }
        return Number(b.savings_pct || 0) - Number(a.savings_pct || 0);
      });

      return out;
    }

    function updateTypePillCounts(baseList) {
      if (!typePillsWrap) return;
      var counts = { pcs: 0, ram: 0, ssds: 0, accelerators: 0, expansion: 0, other: 0 };
      baseList.forEach(function (item) {
        var g = classifyGroup(item);
        counts[g] = (counts[g] || 0) + 1;
      });

      var buttons = typePillsWrap.querySelectorAll('.type-pill');
      buttons.forEach(function (btn) {
        var g = btn.getAttribute('data-group') || '';
        var isActive = g === selectedGroup;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');

        if (!g) {
          btn.textContent = 'All Hardware (' + baseList.length + ')';
        } else {
          var def = GROUP_DEFS.find(function (d) {
            return d.key === g;
          });
          var label = def ? def.shortLabel : g;
          var c = counts[g] || 0;
          btn.textContent = label + ' (' + c + ')';
        }
      });
    }

    function verdictText(pct) {
      if (pct >= 30) return 'DEEP ARBITRAGE';
      if (pct >= 20) return 'STRONG VALUE';
      return 'BELOW P20';
    }

    function renderRowHtml(item, groupIcon) {
      var price = Number(item.total_price || 0).toFixed(2);
      var ceiling = Number(item.effective_ceiling || 0).toFixed(2);
      var pctNum = Number(item.savings_pct || 0);
      var savingsPct = pctNum.toFixed(1);
      var savingsDollars = Number(item.savings_dollars || 0).toFixed(0);
      var shipCost = Number(item.shipping_cost || 0);
      var shipText = shipCost > 0 ? '+$' + shipCost.toFixed(2) + ' shipping' : 'Free shipping';
      var shipClass = shipCost > 0 ? 'ship-note' : 'ship-note is-free';

      var safeUrl =
        item.item_url &&
        (item.item_url.indexOf('http://') === 0 || item.item_url.indexOf('https://') === 0)
          ? item.item_url
          : 'https://www.ebay.com';

      var safeImg =
        item.image_url &&
        (item.image_url.indexOf('https://') === 0 || item.image_url.indexOf('http://') === 0)
          ? item.image_url
          : '';

      var specs = [];
      if (item.detected_cpu) specs.push(escapeHtml(item.detected_cpu));
      if (Number(item.detected_ram_gb) > 0) specs.push(escapeHtml(item.detected_ram_gb) + 'GB RAM');
      if (item.detected_storage) specs.push(escapeHtml(item.detected_storage));
      var tierLabel = formatTierLabel(item.config_tier);
      if (tierLabel) specs.push(escapeHtml(tierLabel));

      var sellerScore = Number(item.seller_feedback_score || 0);
      var sellerPct = Number(item.seller_positive_percent || 0);
      var sellerBadge = '';
      if (sellerScore > 0) {
        sellerBadge =
          '<span class="meta-chip mono">Seller ' +
          escapeHtml(sellerPct.toFixed(1)) +
          '% (' +
          escapeHtml(sellerScore.toLocaleString()) +
          ')</span>';
      }

      var ebayId = extractEbayItemId(item);
      var formatLabel = formatFormatLabel(item.buying_format);
      var conditionLabel = item.condition_name || 'Used';

      var thumbInner = '';
      if (safeImg) {
        thumbInner =
          '<img src="' +
          escapeHtml(safeImg) +
          '" alt="' +
          escapeHtml(item.title || 'eBay listing photo') +
          '" class="listing-thumb-img" loading="lazy" decoding="async" referrerpolicy="no-referrer" />' +
          '<span class="listing-thumb-fallback" hidden>' +
          groupIcon +
          '</span>';
      } else {
        thumbInner = '<span class="listing-thumb-fallback">' + groupIcon + '</span>';
      }

      var html = '<tr class="deal-row">';
      html += '<td data-label="eBay Listing" class="listing-cell">';
      html += '<div class="listing-media-row">';
      html +=
        '<a href="' +
        escapeHtml(safeUrl) +
        '" target="_blank" rel="noopener noreferrer" class="listing-thumb" aria-label="Open eBay listing photo: ' +
        escapeHtml(item.title) +
        '">' +
        thumbInner +
        '</a>';

      html += '<div class="listing-info">';
      html += '<div class="listing-badges">';
      html +=
        '<span class="ebay-pill mono"><span class="ebay-word" aria-label="eBay"><span class="eb-e">e</span><span class="eb-b">b</span><span class="eb-a">a</span><span class="eb-y">y</span></span> · ' +
        escapeHtml(formatLabel) +
        '</span>';
      html += '<span class="condition-pill mono">' + escapeHtml(conditionLabel) + '</span>';
      html += sellerBadge;
      html += '</div>';

      html +=
        '<a href="' +
        escapeHtml(safeUrl) +
        '" target="_blank" rel="noopener noreferrer" class="row-title-link">' +
        escapeHtml(item.title) +
        '</a>';

      html +=
        '<div class="row-rule mono">' +
        escapeHtml(item.rule_name || 'Hardware Rule') +
        (ebayId ? ' · Item #' + escapeHtml(ebayId) : '') +
        '</div>';
      html += '</div>';
      html += '</div>';
      html += '</td>';

      html += '<td data-label="Extracted Specs" class="specs-cell mono">';
      if (specs.length) {
        html += '<div class="specs-tags">';
        specs.forEach(function (sp) {
          html += '<span class="spec-tag">' + sp + '</span>';
        });
        html += '</div>';
      } else {
        html += '<span class="spec-tag">Component</span>';
      }
      html += '</td>';

      html += '<td data-label="Deal Verdict" class="verdict-cell mono">';
      html += '<span class="verdict-pct">-' + savingsPct + '%</span>';
      html +=
        '<span class="verdict-sub">' +
        verdictText(pctNum) +
        ' · Save $' +
        savingsDollars +
        '</span>';
      html += '</td>';

      html += '<td data-label="eBay Price" class="num mono price-cell">';
      html += '<strong>$' + price + '</strong>';
      html += '<span class="' + shipClass + '">' + escapeHtml(shipText) + '</span>';
      html += '</td>';

      html += '<td data-label="P20 Ceiling" class="num mono ceiling-cell">$' + ceiling + '</td>';

      html += '<td data-label="Link" class="action-col">';
      html +=
        '<a href="' +
        escapeHtml(safeUrl) +
        '" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm ebay-cta-btn">View on eBay ↗</a>';
      html += '</td>';
      html += '</tr>';

      return html;
    }

    function wireImageFallbacks() {
      if (!groupsContainer) return;
      var imgs = groupsContainer.querySelectorAll('.listing-thumb-img');
      imgs.forEach(function (img) {
        img.addEventListener(
          'error',
          function () {
            img.style.display = 'none';
            var fb = img.nextElementSibling;
            if (fb) fb.removeAttribute('hidden');
          },
          { once: true }
        );
      });
    }

    function renderDeals(rawDeals, isLiveSource) {
      if (!groupsContainer) return;
      var baseFiltered = applyClientFiltersAndSort(rawDeals || [], false);
      updateTypePillCounts(baseFiltered);

      var deals = selectedGroup
        ? baseFiltered.filter(function (d) {
            return classifyGroup(d) === selectedGroup;
          })
        : baseFiltered;

      if (deals.length === 0) {
        groupsContainer.innerHTML =
          '<div class="deal-group-block"><div class="deals-table-wrap"><table class="deals-table"><tbody><tr><td class="empty-cell mono">No eBay listings match the current filters. Reset filters to view all active deals.</td></tr></tbody></table></div></div>';
        if (countLabel) {
          countLabel.textContent = '0 eBay listings matching current filters';
        }
        return;
      }

      var groupedMap = {};
      deals.forEach(function (item) {
        var g = classifyGroup(item);
        if (!groupedMap[g]) groupedMap[g] = [];
        groupedMap[g].push(item);
      });

      var isNarrowedView = Boolean(
        selectedGroup ||
          (filterRule && filterRule.value) ||
          (filterQ && filterQ.value.trim())
      );

      var activeGroupCount = 0;
      var html = '';

      GROUP_DEFS.forEach(function (def) {
        var items = groupedMap[def.key];
        if (!items || items.length === 0) return;
        activeGroupCount += 1;

        var topSavings = 0;
        var minPrice = Infinity;
        items.forEach(function (it) {
          var s = Number(it.savings_pct || 0);
          var p = Number(it.total_price || 0);
          if (s > topSavings) topSavings = s;
          if (p > 0 && p < minPrice) minPrice = p;
        });

        var isExpanded = isNarrowedView || Boolean(expandedGroups[def.key]);
        var visibleItems = isExpanded ? items : items.slice(0, INITIAL_GROUP_PREVIEW);
        var hiddenCount = items.length - visibleItems.length;

        html += '<section class="deal-group-block" data-group-section="' + def.key + '">';
        html += '<header class="deal-group-header">';
        html += '<div class="deal-group-heading">';
        html += '<span class="deal-group-icon">' + def.icon + '</span>';
        html += '<div>';
        html += '<h3 class="deal-group-title">' + escapeHtml(def.title) + '</h3>';
        html += '<p class="deal-group-sub">' + escapeHtml(def.subtitle) + '</p>';
        html += '</div>';
        html += '</div>';

        html += '<div class="deal-group-stats mono">';
        html +=
          '<span class="group-stat-pill">' +
          items.length +
          (items.length === 1 ? ' eBay listing' : ' eBay listings') +
          '</span>';
        if (minPrice < Infinity) {
          html += '<span class="group-stat-pill">From $' + minPrice.toFixed(0) + '</span>';
        }
        if (topSavings > 0) {
          html +=
            '<span class="group-stat-pill is-accent">Up to ' +
            topSavings.toFixed(0) +
            '% off</span>';
        }
        html += '</div>';
        html += '</header>';

        html += '<div class="deals-table-wrap">';
        html +=
          '<table class="deals-table" aria-label="' +
          escapeHtml(def.title) +
          ' live eBay listings">';
        html += '<thead><tr>';
        html += '<th scope="col">Photo &amp; Live eBay Listing</th>';
        html += '<th scope="col">Specs</th>';
        html += '<th scope="col">Discount</th>';
        html += '<th scope="col" class="num">eBay Price</th>';
        html += '<th scope="col" class="num">P20 Ceiling</th>';
        html += '<th scope="col" class="action-col">eBay Link</th>';
        html += '</tr></thead>';
        html += '<tbody>';

        visibleItems.forEach(function (it) {
          html += renderRowHtml(it, def.icon);
        });

        html += '</tbody></table>';
        html += '</div>';

        if (!isNarrowedView && items.length > INITIAL_GROUP_PREVIEW) {
          html += '<div class="deal-group-footer">';
          html +=
            '<button type="button" class="btn btn-ghost btn-sm group-toggle-btn mono" data-toggle-group="' +
            def.key +
            '">';
          if (isExpanded) {
            html += 'Show top ' + INITIAL_GROUP_PREVIEW + ' ' + escapeHtml(def.shortLabel) + ' listings ↑';
          } else {
            html +=
              'Show all ' +
              items.length +
              ' ' +
              escapeHtml(def.shortLabel) +
              ' eBay listings (+' +
              hiddenCount +
              ' more) ↓';
          }
          html += '</button>';
          html += '</div>';
        }

        html += '</section>';
      });

      groupsContainer.innerHTML = html;
      wireImageFallbacks();

      if (countLabel) {
        countLabel.textContent =
          'Showing ' +
          deals.length +
          (isLiveSource ? ' live eBay listings' : ' sample eBay listings') +
          ' across ' +
          activeGroupCount +
          (activeGroupCount === 1 ? ' hardware group' : ' hardware groups');
      }
    }

    function filterLocalDeals() {
      var rule = filterRule ? filterRule.value : '';
      var tier = filterTier ? filterTier.value : '';
      var minRam = filterRam && filterRam.value ? parseInt(filterRam.value, 10) : null;
      var maxP = filterPrice && filterPrice.value ? parseFloat(filterPrice.value) : null;
      var query = filterQ ? filterQ.value.trim().toLowerCase() : '';

      var filtered = fallbackDeals.filter(function (d) {
        if (rule && d.rule_name !== rule) return false;
        if (tier && d.config_tier !== tier) return false;
        if (minRam && (!d.detected_ram_gb || d.detected_ram_gb < minRam)) return false;
        if (maxP && d.total_price > maxP) return false;
        if (query && d.title.toLowerCase().indexOf(query) === -1) return false;
        return true;
      });

      setSourceIndicator(false, 0);
      renderDeals(filtered, false);
    }

    var liveConfirmed = false;
    var lastFetchedDeals = null;
    var liveActiveTotal = 0;

    function fetchSummary() {
      var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
      var timeoutId = controller
        ? setTimeout(function () {
            controller.abort();
          }, 4500)
        : null;

      fetch(apiBase + '/api/deal-hunter/summary', {
        headers: { Accept: 'application/json' },
        signal: controller ? controller.signal : undefined,
      })
        .then(function (res) {
          if (timeoutId) clearTimeout(timeoutId);
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(function (data) {
          if (!data || !data.available) return;
          liveConfirmed = true;
          liveActiveTotal = Number(data.active_deals_count || 0);
          setSourceIndicator(true, liveActiveTotal);

          if (kpiTotal && data.total_tracked_items) {
            kpiTotal.textContent = Number(data.total_tracked_items).toLocaleString();
          }
          if (kpiDeals && data.active_deals_count !== undefined) {
            kpiDeals.textContent = String(data.active_deals_count);
          }
          if (kpiDiscount && data.top_discount_pct !== undefined) {
            kpiDiscount.textContent = Number(data.top_discount_pct).toFixed(0) + '%';
          }
          if (kpiBenchmarks && Array.isArray(data.benchmarks) && data.benchmarks.length) {
            kpiBenchmarks.textContent = String(data.benchmarks.length);
          }

          if (filterRule && Array.isArray(data.rule_names) && data.rule_names.length) {
            var currentVal = filterRule.value;
            var optionsHtml = '<option value="">All Tracked Rules</option>';
            data.rule_names.forEach(function (rule) {
              var selected = rule === currentVal ? ' selected' : '';
              optionsHtml +=
                '<option value="' + escapeHtml(rule) + '"' + selected + '>' + escapeHtml(rule) + '</option>';
            });
            filterRule.innerHTML = optionsHtml;
          }

          if (benchmarksTbody && Array.isArray(data.benchmarks) && data.benchmarks.length) {
            var rows = '';
            data.benchmarks.slice(0, 15).forEach(function (b) {
              rows += '<tr>';
              rows += '<td class="mono"><strong>' + escapeHtml(b.rule_name) + '</strong></td>';
              rows += '<td class="mono">' + escapeHtml(formatTierLabel(b.config_tier) || 'All') + '</td>';
              rows += '<td class="mono num">' + Number(b.sample_count || 0) + '</td>';
              rows += '<td class="mono num accent-val">$' + Number(b.p20_price || 0).toFixed(2) + '</td>';
              rows += '<td class="mono num">$' + Number(b.median_price || 0).toFixed(2) + '</td>';
              rows +=
                '<td class="mono num muted-val">$' +
                Number(b.min_price || 0).toFixed(0) +
                ' – $' +
                Number(b.max_price || 0).toFixed(0) +
                '</td>';
              rows += '</tr>';
            });
            benchmarksTbody.innerHTML = rows;
          }
        })
        .catch(function () {
          if (timeoutId) clearTimeout(timeoutId);
        });
    }

    var fetchTimeout = null;
    function fetchDeals() {
      var rule = filterRule ? filterRule.value : '';
      var tier = filterTier ? filterTier.value : '';
      var minRam = filterRam ? filterRam.value : '';
      var maxPrice = filterPrice ? filterPrice.value : '';
      var q = filterQ ? filterQ.value.trim() : '';
      var hasServerFilter = Boolean(rule || tier || minRam || maxPrice || q);

      var queryParts = ['limit=200'];
      if (rule) queryParts.push('rule_name=' + encodeURIComponent(rule));
      if (tier) queryParts.push('config_tier=' + encodeURIComponent(tier));
      if (minRam) queryParts.push('min_ram_gb=' + encodeURIComponent(minRam));
      if (maxPrice) queryParts.push('max_price=' + encodeURIComponent(maxPrice));
      if (q) queryParts.push('q=' + encodeURIComponent(q));

      var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
      var abortId = controller
        ? setTimeout(function () {
            controller.abort();
          }, 4500)
        : null;

      fetch(apiBase + '/api/deal-hunter/deals?' + queryParts.join('&'), {
        headers: { Accept: 'application/json' },
        signal: controller ? controller.signal : undefined,
      })
        .then(function (res) {
          if (abortId) clearTimeout(abortId);
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(function (data) {
          if (
            data &&
            data.available &&
            Array.isArray(data.deals) &&
            (data.deals.length > 0 || (liveConfirmed && hasServerFilter))
          ) {
            liveConfirmed = true;
            lastFetchedDeals = data.deals;
            setSourceIndicator(true, liveActiveTotal || data.deals.length);
            renderDeals(data.deals, true);
          } else {
            lastFetchedDeals = null;
            filterLocalDeals();
          }
        })
        .catch(function () {
          if (abortId) clearTimeout(abortId);
          lastFetchedDeals = null;
          filterLocalDeals();
        });
    }

    function onServerFilterChange() {
      if (fetchTimeout) clearTimeout(fetchTimeout);
      fetchTimeout = setTimeout(fetchDeals, 220);
    }

    function rerenderCurrent() {
      if (lastFetchedDeals !== null) {
        renderDeals(lastFetchedDeals, true);
      } else {
        filterLocalDeals();
      }
    }

    if (typePillsWrap) {
      typePillsWrap.addEventListener('click', function (ev) {
        var btn = ev.target && ev.target.closest ? ev.target.closest('.type-pill') : null;
        if (!btn) return;
        selectedGroup = btn.getAttribute('data-group') || '';
        rerenderCurrent();
      });
    }

    if (groupsContainer) {
      groupsContainer.addEventListener('click', function (ev) {
        var btn = ev.target && ev.target.closest ? ev.target.closest('[data-toggle-group]') : null;
        if (!btn) return;
        var g = btn.getAttribute('data-toggle-group');
        if (!g) return;
        expandedGroups[g] = !expandedGroups[g];
        rerenderCurrent();
      });
    }

    if (filterRule) filterRule.addEventListener('change', onServerFilterChange);
    if (filterTier) filterTier.addEventListener('change', onServerFilterChange);
    if (filterRam) filterRam.addEventListener('change', onServerFilterChange);
    if (filterPrice) filterPrice.addEventListener('input', onServerFilterChange);
    if (filterQ) filterQ.addEventListener('input', onServerFilterChange);
    if (filterVerdict) filterVerdict.addEventListener('change', rerenderCurrent);
    if (filterSort) filterSort.addEventListener('change', rerenderCurrent);

    if (btnReset) {
      btnReset.addEventListener('click', function () {
        selectedGroup = '';
        expandedGroups = {};
        if (filterQ) filterQ.value = '';
        if (filterRule) filterRule.value = '';
        if (filterTier) filterTier.value = '';
        if (filterVerdict) filterVerdict.value = '0';
        if (filterRam) filterRam.value = '';
        if (filterPrice) filterPrice.value = '';
        if (filterSort) filterSort.value = 'savings_pct_desc';
        onServerFilterChange();
      });
    }

    fetchSummary();
    fetchDeals();
  })();
</script>

<style>
  .section-stack {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .explorer-panel {
    display: flex;
    flex-direction: column;
    gap: 1.45rem;
  }

  .panel-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .panel-title {
    font-size: 1.28rem;
    margin-top: 0.25rem;
  }

  .meta-note {
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .source-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    color: var(--text-primary);
    padding: 0.42rem 0.85rem;
    border: 1px solid var(--live-border);
    border-radius: 999px;
    background: var(--live-soft);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-muted);
    flex-shrink: 0;
  }

  .status-dot.is-online {
    background: var(--live-dot);
    box-shadow: 0 0 8px rgba(52, 211, 153, 0.65);
  }

  .summary-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--border-strong);
    border-left: 1px solid var(--border-strong);
    background: var(--bg-canvas);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .summary-cell {
    padding: 0.95rem 1.1rem;
    border-right: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .summary-val {
    font-size: 1.25rem;
    font-weight: 650;
    color: var(--text-primary);
  }

  .summary-sub {
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  /* Hardware Type Quick-Filter Pills */
  .type-tabs-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
