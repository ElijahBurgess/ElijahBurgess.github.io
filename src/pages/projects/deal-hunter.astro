    </section>

    <!-- Interactive Deal Explorer & Filter Bar -->
    <section class="section explorer-section" id="deals-explorer">
      <div class="container">
        <div class="section-header">
          <div class="eyebrow mono">Live Arbitrage Explorer</div>
          <h2 class="section-title">Filter Live eBay Hardware Deals</h2>
          <p class="section-subtitle">
            Search active deals retrieved from the homelab SQLite database via read-only parameter queries.
            Filter by hardware family, configuration tier, RAM capacity, or maximum budget.
          </p>
        </div>

        <!-- Filter Bar Card -->
        <div class="filter-card card">
          <div class="filter-grid">
            <!-- Filter 1: Hardware Rule / Category -->
            <div class="filter-group">
              <label for="filter-rule" class="filter-label mono">Hardware Category</label>
              <select id="filter-rule" class="filter-select">
                <option value="">All Categories</option>
                <option value="m720q">Lenovo ThinkCentre M720q</option>
                <option value="m920q">Lenovo ThinkCentre M920q</option>
                <option value="m920x">Lenovo ThinkCentre M920x (PCIe)</option>
                <option value="optiplex_3060">Dell OptiPlex 3060 Micro</option>
                <option value="optiplex_7060">Dell OptiPlex 7060 Micro</option>
                <option value="elitedesk_800_g4">HP EliteDesk 800 G4 Mini</option>
                <option value="ecc_udimm">DDR4 ECC UDIMM RAM</option>
                <option value="coral_tpu">Google Coral Edge TPU</option>
                <option value="nvme_ssd">Enterprise NVMe SSD</option>
              </select>
            </div>

            <!-- Filter 2: Config Tier -->
            <div class="filter-group">
              <label for="filter-tier" class="filter-label mono">Config Tier</label>
              <select id="filter-tier" class="filter-select">
                <option value="">All Tiers</option>
                <option value="COMPLETE_TURNKEY">Complete Turnkey (CPU+RAM+SSD)</option>
                <option value="COMPLETE_NO_DRIVE">Complete (No Storage)</option>
                <option value="STANDALONE_COMPONENT">Standalone Component</option>
              </select>
            </div>

            <!-- Filter 3: Minimum RAM -->
            <div class="filter-group">
              <label for="filter-ram" class="filter-label mono">Minimum RAM</label>
              <select id="filter-ram" class="filter-select">
                <option value="">Any RAM</option>
                <option value="16">16 GB+</option>
                <option value="32">32 GB+</option>
                <option value="64">64 GB+</option>
              </select>
            </div>

            <!-- Filter 4: Max Price -->
            <div class="filter-group">
              <label for="filter-price" class="filter-label mono">Max Total Price ($)</label>
              <input
                id="filter-price"
                type="number"
                class="filter-input"
                placeholder="e.g. 180"
                min="10"
                step="10"
              />
            </div>

            <!-- Filter 5: Keyword Search -->
            <div class="filter-group filter-group-search">
              <label for="filter-q" class="filter-label mono">Search Keywords</label>
              <input
                id="filter-q"
                type="search"
                class="filter-input"
                placeholder="i5, PCIe, NVMe, Coral, 32GB..."
              />
            </div>
          </div>

          <div class="filter-footer">
            <div class="filter-status mono" id="deals-count-label">
              Showing active below-market deals...
            </div>
            <button type="button" id="btn-reset-filters" class="btn btn-ghost btn-sm">
              Reset Filters
            </button>
          </div>
        </div>

        <!-- Deals Grid -->
        <div class="deals-grid" id="deals-grid" aria-live="polite">
          <!-- Populated dynamically via JS -->
          <div class="deals-loading mono">
            <span class="status-dot loading"></span>
            Loading homelab hardware deals from CT 104...
          </div>
        </div>
      </div>
    </section>

    <!-- Market Benchmarks Reference Section -->
    <section class="section benchmarks-section" id="benchmarks">
      <div class="container">
        <div class="section-header">
          <div class="eyebrow mono">Algorithmic Valuation</div>
          <h2 class="section-title">Automated Market Price Curves</h2>
          <p class="section-subtitle">
            How Deal Hunter detects real bargains: by computing rolling sample counts, median clearing prices,
            and 20th percentile targets (P20) across specific hardware configurations.
          </p>
        </div>

        <!-- Architecture Callout -->
        <div class="security-callout card">
          <div class="callout-icon">🛡️</div>
          <div class="callout-body">
            <h3 class="callout-title mono">Read-Only Architectural Isolation (?mode=ro)</h3>
            <p class="callout-text">
              The internal eBay scanner daemon runs isolated in the background on Proxmox <code>CT 104</code>,
              updating <code>deal_hunter.db</code> via WAL mode. When the website API queries listings,
              it opens SQLite using the read-only URI flag (<code>file:...deal_hunter.db?mode=ro</code>)
              paired with strictly parameterized queries. The scanner's mutation endpoints (port <code>8004</code>)
              are never exposed to the public Internet.
            </p>
          </div>
        </div>

        <!-- Benchmarks Table Card -->
        <div class="benchmarks-table-card card">
          <div class="table-card-header">
