    // Fetch Summary & Benchmarks
    function fetchSummary() {
      var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
      var timeoutId = null;
      if (controller) {
        timeoutId = setTimeout(function () {
          controller.abort();
        }, 4500); // 4.5s timeout
      }

      fetch(apiBase + '/api/deal-hunter/summary', {
        headers: { Accept: 'application/json' },
        signal: controller ? controller.signal : undefined,
      })
        .then(function (res) {
          if (timeoutId) clearTimeout(timeoutId);
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(function (data) {
          if (!data || !data.available) return;

          if (kpiTotal && data.total_tracked_items) {
            kpiTotal.textContent = Number(data.total_tracked_items).toLocaleString();
            if (heroTracked) heroTracked.textContent = Number(data.total_tracked_items).toLocaleString();
          }
          if (kpiDeals && data.active_deals_count !== undefined) {
            kpiDeals.textContent = data.active_deals_count;
            if (heroActive) heroActive.textContent = data.active_deals_count;
          }
          if (kpiDiscount && data.top_discount_pct !== undefined) {
            kpiDiscount.textContent = data.top_discount_pct.toFixed(0) + '%';
            if (heroDiscount) heroDiscount.textContent = data.top_discount_pct.toFixed(0) + '%';
          }
          if (kpiBenchmarks && data.benchmarks && data.benchmarks.length) {
            kpiBenchmarks.textContent = data.benchmarks.length;
          }

          // Populate Rule Names into Select if available
          if (data.rule_names && data.rule_names.length) {
            var currentVal = filterRule.value;
            // Preserve default "All Categories"
            var optionsHtml = '<option value="">All Categories</option>';
            data.rule_names.forEach(function (rule) {
              var selected = rule === currentVal ? ' selected' : '';
              optionsHtml += '<option value="' + escapeHtml(rule) + '"' + selected + '>' + escapeHtml(rule) + '</option>';
            });
            filterRule.innerHTML = optionsHtml;
          }

          // Render Live Benchmarks Table
          if (data.benchmarks && data.benchmarks.length && benchmarksTbody) {
            var rows = '';
            data.benchmarks.slice(0, 15).forEach(function (b) {
              rows += '<tr>';
              rows += '<td><strong class="mono">' + escapeHtml(b.rule_name) + '</strong></td>';
              rows += '<td><span class="tag mono">' + escapeHtml(b.config_tier || 'ALL') + '</span></td>';
              rows += '<td class="mono">' + (b.sample_count || 0) + '</td>';
              rows += '<td class="mono text-accent-2 font-bold">$' + Number(b.p20_price || 0).toFixed(2) + '</td>';
              rows += '<td class="mono">$' + Number(b.median_price || 0).toFixed(2) + '</td>';
              rows += '<td class="mono text-muted">$' + Number(b.min_price || 0).toFixed(0) + ' – $' + Number(b.max_price || 0).toFixed(0) + '</td>';
              rows += '</tr>';
            });
            benchmarksTbody.innerHTML = rows;
          }
        })
        .catch(function () {
          if (timeoutId) clearTimeout(timeoutId);
          // Keep static fallbacks intact
        });
    }

    // Render Deals Grid
    function renderDeals(deals) {
      if (!dealsGrid) return;

      if (!deals || deals.length === 0) {
        dealsGrid.innerHTML =
          '<div class="no-deals card mono">' +
          '<div class="no-deals-icon">🔍</div>' +
          '<h4>No matching hardware deals found</h4>' +
          '<p>Try relaxing your budget, clearing search keywords, or selecting "All Categories".</p>' +
          '</div>';
        if (countLabel) countLabel.textContent = '0 active deals matching filter criteria.';
        return;
      }

      var html = '';
      deals.forEach(function (item) {
        var price = Number(item.total_price || 0).toFixed(2);
        var ceiling = Number(item.effective_ceiling || 0).toFixed(2);
        var savingsPct = Number(item.savings_pct || 0).toFixed(0);
        var savingsDollars = Number(item.savings_dollars || 0).toFixed(0);
        var shipText = item.shipping_cost > 0 ? '+$' + Number(item.shipping_cost).toFixed(2) + ' ship' : 'Free shipping';

        // Safe external item URL
        var safeUrl = item.item_url && (item.item_url.indexOf('http://') === 0 || item.item_url.indexOf('https://') === 0)
          ? item.item_url
          : 'https://www.ebay.com';

        html += '<article class="deal-card card">';

        // Thumbnail + Discount Pill
        html += '<div class="deal-media">';
        if (item.image_url) {
          html += '<img src="' + escapeHtml(item.image_url) + '" alt="' + escapeHtml(item.title) + '" loading="lazy" class="deal-thumb" onerror="this.src=\'data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22120%22 height=%22120%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%23475569%22 stroke-width=%221.5%22><rect width=%2220%22 height=%2216%22 x=%222%22 y=%224%22 rx=%222%22/><line x1=%226%22 y1=%2212%22 x2=%2218%22 y2=%2212%22/></svg>\';" />';
        } else {
          html += '<div class="deal-thumb-placeholder">🖥️</div>';
        }
        html += '<span class="discount-badge mono">-' + savingsPct + '% • Save $' + savingsDollars + '</span>';
        html += '</div>';

        // Content
        html += '<div class="deal-body">';
        html += '<div class="deal-eyebrow mono">' + escapeHtml(item.rule_name || 'Hardware') + ' • ' + escapeHtml(item.condition_name || 'Used') + '</div>';
        html += '<h3 class="deal-title" title="' + escapeHtml(item.title) + '">' + escapeHtml(item.title) + '</h3>';

        // Price Comparison
        html += '<div class="price-row">';
        html += '<div class="price-main"><span class="price-val mono text-accent">$' + price + '</span> <span class="price-ship mono">' + escapeHtml(shipText) + '</span></div>';
        html += '<div class="price-ceiling mono text-muted">Ceiling: $' + ceiling + '</div>';
        html += '</div>';

        // Specs Badges
        html += '<div class="deal-specs tags">';
        if (item.detected_cpu) {
          html += '<span class="tag mono">' + escapeHtml(item.detected_cpu) + '</span>';
        }
        if (item.detected_ram_gb) {
          html += '<span class="tag mono text-accent-2">' + escapeHtml(item.detected_ram_gb) + ' GB RAM</span>';
        }
        if (item.detected_storage) {
          html += '<span class="tag mono">' + escapeHtml(item.detected_storage) + '</span>';
        }
        if (item.config_tier) {
          html += '<span class="tag mono">' + escapeHtml(item.config_tier) + '</span>';
        }
        html += '</div>';

        // Seller Line & CTA
        html += '<div class="deal-footer">';
        html += '<div class="seller-info mono text-muted">';
        if (item.seller_positive_percent !== undefined && item.seller_feedback_score !== undefined) {
          html += '⭐ ' + item.seller_positive_percent + '% (' + item.seller_feedback_score + ')';
        }
        html += '</div>';
        html += '<a href="' + escapeHtml(safeUrl) + '" target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">';
        html += 'View on eBay ↗';
        html += '</a>';
        html += '</div>';

        html += '</div>'; // .deal-body
        html += '</article>';
      });

      dealsGrid.innerHTML = html;
      if (countLabel) {
        countLabel.textContent = 'Showing ' + deals.length + ' active below-market homelab deals.';
      }
    }

    // Filter Local / Fallback Deals
    function filterLocalDeals() {
      var rule = filterRule.value;
      var tier = filterTier.value;
      var minRam = filterRam.value ? parseInt(filterRam.value, 10) : null;
      var maxP = filterPrice.value ? parseFloat(filterPrice.value) : null;
      var query = filterQ.value.trim().toLowerCase();

      var filtered = fallbackDeals.filter(function (d) {
        if (rule && d.rule_name !== rule) return false;
        if (tier && d.config_tier !== tier) return false;
        if (minRam && (!d.detected_ram_gb || d.detected_ram_gb < minRam)) return false;
        if (maxP && d.total_price > maxP) return false;
        if (query && d.title.toLowerCase().indexOf(query) === -1) return false;
        return true;
      });

      renderDeals(filtered);
    }

    // Fetch Deals from Live Backend with graceful local fallback
    var fetchTimeout = null;
    function fetchDeals() {
      var rule = filterRule.value;
      var tier = filterTier.value;
      var minRam = filterRam.value;
      var maxPrice = filterPrice.value;
      var q = filterQ.value.trim();

      var queryParts = ['limit=30'];
      if (rule) queryParts.push('rule_name=' + encodeURIComponent(rule));
      if (tier) queryParts.push('config_tier=' + encodeURIComponent(tier));
      if (minRam) queryParts.push('min_ram_gb=' + encodeURIComponent(minRam));
      if (maxPrice) queryParts.push('max_price=' + encodeURIComponent(maxPrice));
      if (q) queryParts.push('q=' + encodeURIComponent(q));

      var url = apiBase + '/api/deal-hunter/deals?' + queryParts.join('&');

      var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
      var abortId = null;
      if (controller) {
        abortId = setTimeout(function () {
          controller.abort();
        }, 4000);
      }

      fetch(url, {
        headers: { Accept: 'application/json' },
        signal: controller ? controller.signal : undefined,
      })
        .then(function (res) {
          if (abortId) clearTimeout(abortId);
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(function (data) {
          if (data && data.available && Array.isArray(data.deals) && data.deals.length > 0) {
            renderDeals(data.deals);
          } else {
            // If live API returns empty for query or is in test mode, apply local filter
            filterLocalDeals();
          }
        })
        .catch(function () {
          if (abortId) clearTimeout(abortId);
          filterLocalDeals();
        });
    }

    function onFilterChange() {
      if (fetchTimeout) clearTimeout(fetchTimeout);
      fetchTimeout = setTimeout(fetchDeals, 250); // 250ms debounce
    }

    // Event Listeners
    filterRule.addEventListener('change', onFilterChange);
    filterTier.addEventListener('change', onFilterChange);
    filterRam.addEventListener('change', onFilterChange);
    filterPrice.addEventListener('input', onFilterChange);
    filterQ.addEventListener('input', onFilterChange);

    btnReset.addEventListener('click', function () {
      filterRule.value = '';
      filterTier.value = '';
      filterRam.value = '';
      filterPrice.value = '';
      filterQ.value = '';
      onFilterChange();
    });

    // Initial Execution
    fetchSummary();
    fetchDeals();
  })();
</script>

