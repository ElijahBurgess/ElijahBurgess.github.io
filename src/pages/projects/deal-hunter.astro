---
import ProjectLayout from '../../layouts/ProjectLayout.astro';
---

<ProjectLayout
  title="eBay Homelab Deal Hunter"
  description="Continuous eBay hardware valuation pipeline with regex spec normalization, rolling P20 market price ceilings, and a read-only browser deal explorer."
  canonicalPath="/projects/deal-hunter"
  category="Market Valuation & Data Pipelines"
  summary="Continuous eBay hardware scraper and valuation engine tracking enterprise mini-PCs, ECC memory, NVMe drives, and Coral accelerators. Extracts structured specs from messy listing titles and flags items priced below rolling 20th-percentile (P20) market ceilings."
  stack={['Python', 'SQLite WAL (?mode=ro)', 'FastAPI', 'Playwright', 'Pushover']}
  liveUrl="#explorer"
  liveLabel="Open Deal Explorer ↓"
  secondaryUrl="#benchmarks"
  secondaryLabel="Market Benchmarks"
>
  <!-- Live Summary Telemetry Strip + Interactive Deal Explorer -->
  <section id="explorer" class="studio-panel explorer-panel" aria-labelledby="explorer-heading">
    <div class="panel-top">
      <div>
        <span class="spec-label">Interactive Valuation Table</span>
        <h2 id="explorer-heading" class="panel-title">Hardware Deal Explorer</h2>
      </div>
      <div class="source-indicator mono" id="dh-source-pill" title="Data source status">
        <span class="status-dot" id="dh-source-dot" aria-hidden="true"></span>
        <span id="dh-source-label">Connecting SQLite...</span>
      </div>
    </div>

    <div class="summary-strip" role="region" aria-label="Scanner summary metrics">
      <div class="summary-cell">
        <span class="spec-label">Tracked Listings</span>
        <strong class="summary-val mono" id="kpi-total-items">2,726</strong>
        <span class="summary-sub mono">SQLite catalog</span>
      </div>
      <div class="summary-cell">
        <span class="spec-label">Below-Ceiling Deals</span>
        <strong class="summary-val mono" id="kpi-active-deals">42</strong>
        <span class="summary-sub mono">Active &lt; P20 ceiling</span>
      </div>
      <div class="summary-cell">
        <span class="spec-label">Peak Live Discount</span>
        <strong class="summary-val mono" id="kpi-top-discount">58%</strong>
        <span class="summary-sub mono">Below tier ceiling</span>
      </div>
      <div class="summary-cell">
        <span class="spec-label">Calibrated Tiers</span>
        <strong class="summary-val mono" id="kpi-benchmarks-count">97</strong>
        <span class="summary-sub mono">Rolling P20 curves</span>
      </div>
    </div>

    <!-- Filter & Sort Controls -->
    <div class="controls-bar" role="search" aria-label="Filter and sort hardware deals">
      <div class="control-field control-search">
        <label for="filter-q" class="spec-label">Search</label>
        <input
          id="filter-q"
          type="search"
          class="studio-input"
          placeholder="i5-8500T, M920x, PCIe, NVMe, Coral..."
        />
      </div>

      <div class="control-field">
        <label for="filter-rule" class="spec-label">Category</label>
        <select id="filter-rule" class="studio-select">
          <option value="">All Categories</option>
          <option value="m720q">m720q (Lenovo Tiny)</option>
          <option value="m920q">m920q (Lenovo Tiny)</option>
          <option value="m920x">m920x (PCIe Tiny)</option>
          <option value="optiplex_3060">optiplex_3060 (Dell Micro)</option>
          <option value="optiplex_7060">optiplex_7060 (Dell Micro)</option>
          <option value="elitedesk_800_g4">elitedesk_800_g4 (HP Mini)</option>
          <option value="ecc_udimm">ecc_udimm (DDR4 ECC)</option>
          <option value="coral_tpu">coral_tpu (Edge TPU)</option>
          <option value="nvme_ssd">nvme_ssd (Enterprise NVMe)</option>
        </select>
      </div>

      <div class="control-field">
        <label for="filter-tier" class="spec-label">Config Tier</label>
        <select id="filter-tier" class="studio-select">
          <option value="">All Tiers</option>
          <option value="COMPLETE_TURNKEY">Complete Turnkey</option>
          <option value="COMPLETE_NO_DRIVE">No Storage</option>
          <option value="STANDALONE_COMPONENT">Component</option>
        </select>
      </div>

      <div class="control-field">
        <label for="filter-verdict" class="spec-label">Verdict</label>
        <select id="filter-verdict" class="studio-select">
          <option value="0">All Below P20</option>
          <option value="20">Strong Value (≥20% off)</option>
          <option value="30">Deep Arbitrage (≥30% off)</option>
        </select>
      </div>

      <div class="control-field">
        <label for="filter-ram" class="spec-label">Min RAM</label>
        <select id="filter-ram" class="studio-select">
          <option value="">Any RAM</option>
          <option value="16">16 GB+</option>
          <option value="32">32 GB+</option>
          <option value="64">64 GB+</option>
        </select>
      </div>

      <div class="control-field">
        <label for="filter-price" class="spec-label">Max Price ($)</label>
        <input
          id="filter-price"
          type="number"
          class="studio-input mono"
          placeholder="180"
          min="10"
          step="10"
        />
      </div>

      <div class="control-field">
        <label for="filter-sort" class="spec-label">Sort By</label>
        <select id="filter-sort" class="studio-select">
          <option value="savings_pct_desc">Discount % (High → Low)</option>
          <option value="savings_dollars_desc">$ Saved (High → Low)</option>
          <option value="price_asc">Total Price (Low → High)</option>
          <option value="price_desc">Total Price (High → Low)</option>
        </select>
      </div>
    </div>

    <div class="controls-meta">
      <p class="count-label mono" id="deals-count-label" aria-live="polite">
        Loading hardware listings...
      </p>
      <button type="button" id="btn-reset-filters" class="btn btn-ghost btn-sm">
        Reset Filters
      </button>
    </div>

    <!-- Studio Data Table -->
    <div class="deals-table-wrap">
      <table class="deals-table" aria-label="Evaluated eBay hardware deals">
        <thead>
          <tr>
            <th scope="col">Listing &amp; Rule</th>
            <th scope="col">Normalized Specs</th>
            <th scope="col">Verdict</th>
            <th scope="col" class="num">Total Price</th>
            <th scope="col" class="num">P20 Ceiling</th>
            <th scope="col" class="action-col">Listing</th>
          </tr>
        </thead>
        <tbody id="deals-tbody">
          <tr>
            <td colspan="6" class="empty-cell mono">Querying read-only SQLite database...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Architecture & Valuation Design -->
  <section aria-labelledby="valuation-heading" class="section-stack">
    <div class="prose-block">
      <span class="spec-label">Architecture</span>
      <h2 id="valuation-heading">Spec Normalization &amp; Read-Only Isolation</h2>
      <p>
        Raw eBay titles mix barebones chassis, missing power bricks, and turnkey systems under identical search terms. The ingestion daemon runs regex extractors across titles and item specifics to classify CPU generation, RAM capacity, storage presence, and configuration tier before computing landed cost (item price plus shipping).
      </p>
      <p>
        Instead of static price thresholds, each hardware rule and configuration tier maintains a rolling 20th-percentile (P20) clearing ceiling in SQLite WAL mode. Public API queries attach with <code>file:deal_hunter.db?mode=ro</code> and parameterized SQL, keeping the scraper daemon isolated on the internal Proxmox network.
      </p>
    </div>

    <div class="spec-grid">
      <div class="spec-cell">
        <span class="spec-label">01 / Parsing</span>
        <h3 class="spec-title">Title Spec Extraction</h3>
        <p class="spec-text">Separates turnkey nodes from no-drive and barebones units so missing components never skew price ceilings.</p>
      </div>
      <div class="spec-cell">
        <span class="spec-label">02 / Pricing</span>
        <h3 class="spec-title">Rolling P20 Ceilings</h3>
        <p class="spec-text">Calculates median and 20th-percentile landed prices per rule and config tier, plus seller feedback floors.</p>
      </div>
      <div class="spec-cell">
        <span class="spec-label">03 / Security</span>
        <h3 class="spec-title">SQLite <code>?mode=ro</code></h3>
        <p class="spec-text">Web API opens the SQLite database strictly read-only with bound parameters; mutation ports stay LAN-only.</p>
      </div>
      <div class="spec-cell">
        <span class="spec-label">04 / Alerting</span>
        <h3 class="spec-title">Instant Pushover Dispatch</h3>
        <p class="spec-text">High-margin Buy-It-Now listings trigger push notifications within seconds of ingestion before items sell out.</p>
      </div>
    </div>
  </section>

  <!-- Rolling Market Benchmarks Table -->
  <section id="benchmarks" class="studio-panel" aria-labelledby="benchmarks-heading">
    <div class="panel-top">
      <div>
        <span class="spec-label">Reference Curves</span>
        <h2 id="benchmarks-heading" class="panel-title">Rolling Market Benchmarks</h2>
      </div>
      <span class="mono meta-note">Landed USD (Price + Shipping)</span>
    </div>

    <div class="bench-table-wrap">
      <table class="bench-table">
        <thead>
          <tr>
            <th scope="col">Rule</th>
            <th scope="col">Config Tier</th>
            <th scope="col" class="num">Samples</th>
            <th scope="col" class="num">P20 Ceiling</th>
            <th scope="col" class="num">Median</th>
            <th scope="col" class="num">Observed Range</th>
          </tr>
        </thead>
        <tbody id="benchmarks-tbody">
          <tr>
            <td class="mono"><strong>m720q</strong></td>
            <td class="mono">COMPLETE_TURNKEY</td>
            <td class="mono num">88</td>
            <td class="mono num accent-val">$125.00</td>
            <td class="mono num">$155.00</td>
            <td class="mono num muted-val">$80 – $240</td>
          </tr>
          <tr>
            <td class="mono"><strong>optiplex_3060</strong></td>
            <td class="mono">COMPLETE_TURNKEY</td>
            <td class="mono num">74</td>
            <td class="mono num accent-val">$110.00</td>
            <td class="mono num">$139.00</td>
            <td class="mono num muted-val">$75 – $210</td>
          </tr>
          <tr>
            <td class="mono"><strong>m920x</strong></td>
            <td class="mono">COMPLETE_NO_DRIVE</td>
            <td class="mono num">42</td>
            <td class="mono num accent-val">$175.00</td>
            <td class="mono num">$219.00</td>
            <td class="mono num muted-val">$140 – $320</td>
          </tr>
          <tr>
            <td class="mono"><strong>elitedesk_800_g4</strong></td>
            <td class="mono">COMPLETE_TURNKEY</td>
            <td class="mono num">51</td>
            <td class="mono num accent-val">$130.00</td>
            <td class="mono num">$165.00</td>
            <td class="mono num muted-val">$90 – $250</td>
          </tr>
          <tr>
            <td class="mono"><strong>coral_tpu</strong></td>
            <td class="mono">STANDALONE_COMPONENT</td>
            <td class="mono num">36</td>
            <td class="mono num accent-val">$29.00</td>
            <td class="mono num">$38.00</td>
            <td class="mono num muted-val">$22 – $65</td>
          </tr>
          <tr>
            <td class="mono"><strong>ecc_udimm</strong></td>
            <td class="mono">STANDALONE_COMPONENT</td>
            <td class="mono num">62</td>
            <td class="mono num accent-val">$54.00</td>
            <td class="mono num">$68.00</td>
            <td class="mono num muted-val">$40 – $110</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</ProjectLayout>

<script is:inline>
  (function initDealHunter() {
    var apiBase = window.__API_BASE__ || 'https://api.eliburgessconsulting.com';

    var sourceDot = document.getElementById('dh-source-dot');
    var sourceLabel = document.getElementById('dh-source-label');
    var kpiTotal = document.getElementById('kpi-total-items');
    var kpiDeals = document.getElementById('kpi-active-deals');
    var kpiDiscount = document.getElementById('kpi-top-discount');
    var kpiBenchmarks = document.getElementById('kpi-benchmarks-count');

    var filterQ = document.getElementById('filter-q');
    var filterRule = document.getElementById('filter-rule');
    var filterTier = document.getElementById('filter-tier');
    var filterVerdict = document.getElementById('filter-verdict');
    var filterRam = document.getElementById('filter-ram');
    var filterPrice = document.getElementById('filter-price');
    var filterSort = document.getElementById('filter-sort');
    var btnReset = document.getElementById('btn-reset-filters');
    var countLabel = document.getElementById('deals-count-label');
    var dealsTbody = document.getElementById('deals-tbody');
    var benchmarksTbody = document.getElementById('benchmarks-tbody');

    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    var fallbackDeals = [
      {
        item_id: '395192837461',
        rule_name: 'coral_tpu',
        title: 'Google Coral Edge TPU M.2 Accelerator Module (B+M key) PCIe',
        total_price: 26.5,
        shipping_cost: 3.5,
        effective_ceiling: 42.0,
        savings_dollars: 15.5,
        savings_pct: 36.9,
        detected_cpu: null,
        detected_ram_gb: null,
        detected_storage: null,
        condition_name: 'Open box',
        config_tier: 'STANDALONE_COMPONENT',
        seller_feedback_score: 950,
        seller_positive_percent: 100.0,
        item_url: 'https://www.ebay.com/itm/395192837461',
      },
      {
        item_id: '325918273641',
        rule_name: 'ecc_udimm',
        title: 'Samsung 32GB 2Rx8 PC4-2666V DDR4 ECC UDIMM Unbuffered Server RAM',
        total_price: 49.0,
        shipping_cost: 0.0,
        effective_ceiling: 75.0,
        savings_dollars: 26.0,
        savings_pct: 34.7,
        detected_cpu: null,
        detected_ram_gb: 32,
        detected_storage: null,
        condition_name: 'Used',
        config_tier: 'STANDALONE_COMPONENT',
        seller_feedback_score: 6400,
        seller_positive_percent: 99.9,
        item_url: 'https://www.ebay.com/itm/325918273641',
      },
      {
        item_id: '156291049281',
        rule_name: 'm920x',
        title: 'Lenovo ThinkCentre M920x Tiny i7-8700T 32GB RAM PCIe Riser Slot (No SSD)',
        total_price: 169.0,
        shipping_cost: 0.0,
        effective_ceiling: 240.0,
        savings_dollars: 71.0,
        savings_pct: 29.6,
        detected_cpu: 'i7-8700T',
        detected_ram_gb: 32,
        detected_storage: null,
        condition_name: 'Used',
        config_tier: 'COMPLETE_NO_DRIVE',
        seller_feedback_score: 12400,
        seller_positive_percent: 99.4,
        item_url: 'https://www.ebay.com/itm/156291049281',
      },
      {
        item_id: '276492018592',
        rule_name: 'optiplex_3060',
        title: 'Dell OptiPlex 3060 Micro Desktop i5-8500T 32GB DDR4 512GB SSD PSU',
        total_price: 129.5,
        shipping_cost: 9.5,
        effective_ceiling: 175.0,
        savings_dollars: 45.5,
        savings_pct: 26.0,
        detected_cpu: 'i5-8500T',
        detected_ram_gb: 32,
        detected_storage: '512GB SSD',
        condition_name: 'Used',
        config_tier: 'COMPLETE_TURNKEY',
        seller_feedback_score: 3150,
        seller_positive_percent: 100.0,
        item_url: 'https://www.ebay.com/itm/276492018592',
      },
      {
        item_id: '186392019401',
        rule_name: 'm720q',
        title: 'Lenovo ThinkCentre M720q Tiny Core i5-8400T 16GB RAM 256GB NVMe SSD',
        total_price: 114.99,
        shipping_cost: 0.0,
        effective_ceiling: 155.0,
        savings_dollars: 40.01,
        savings_pct: 25.8,
        detected_cpu: 'i5-8400T',
        detected_ram_gb: 16,
        detected_storage: '256GB NVMe',
        condition_name: 'Used',
        config_tier: 'COMPLETE_TURNKEY',
        seller_feedback_score: 8420,
        seller_positive_percent: 99.7,
        item_url: 'https://www.ebay.com/itm/186392019401',
      },
      {
        item_id: '204819283741',
        rule_name: 'elitedesk_800_g4',
        title: 'HP EliteDesk 800 G4 Mini PC i5-8500 16GB RAM 256GB NVMe SSD + Adapter',
        total_price: 109.95,
        shipping_cost: 0.0,
        effective_ceiling: 148.0,
        savings_dollars: 38.05,
        savings_pct: 25.7,
        detected_cpu: 'i5-8500',
        detected_ram_gb: 16,
        detected_storage: '256GB NVMe',
        condition_name: 'Used',
        config_tier: 'COMPLETE_TURNKEY',
        seller_feedback_score: 18200,
        seller_positive_percent: 99.8,
        item_url: 'https://www.ebay.com/itm/204819283741',
      },
    ];

    function setSourceIndicator(isLive) {
      if (sourceDot) {
        sourceDot.className = isLive ? 'status-dot is-online' : 'status-dot';
      }
      if (sourceLabel) {
        sourceLabel.textContent = isLive ? 'Live SQLite (?mode=ro)' : 'Sample Snapshot (Offline)';
      }
    }

    function applyClientVerdictAndSort(list) {
      var minPct = filterVerdict && filterVerdict.value ? parseFloat(filterVerdict.value) : 0;
      var sortKey = filterSort ? filterSort.value : 'savings_pct_desc';

      var out = list.filter(function (item) {
        return Number(item.savings_pct || 0) >= minPct;
      });

      out.sort(function (a, b) {
        if (sortKey === 'savings_dollars_desc') {
          return Number(b.savings_dollars || 0) - Number(a.savings_dollars || 0);
        }
        if (sortKey === 'price_asc') {
          return Number(a.total_price || 0) - Number(b.total_price || 0);
        }
        if (sortKey === 'price_desc') {
          return Number(b.total_price || 0) - Number(a.total_price || 0);
        }
        return Number(b.savings_pct || 0) - Number(a.savings_pct || 0);
      });

      return out;
    }

    function verdictText(pct) {
      if (pct >= 30) return 'DEEP ARBITRAGE';
      if (pct >= 20) return 'STRONG VALUE';
      return 'BELOW P20';
    }

    function renderDeals(rawDeals, isLiveSource) {
      if (!dealsTbody) return;
      var deals = applyClientVerdictAndSort(rawDeals || []);

      if (deals.length === 0) {
        dealsTbody.innerHTML =
          '<tr><td colspan="6" class="empty-cell mono">No listings match the current filter criteria. Reset filters to view all active deals.</td></tr>';
        if (countLabel) {
          countLabel.textContent = '0 deals matching current filters';
        }
        return;
      }

      var rows = '';
      deals.forEach(function (item) {
        var price = Number(item.total_price || 0).toFixed(2);
        var ceiling = Number(item.effective_ceiling || 0).toFixed(2);
        var pctNum = Number(item.savings_pct || 0);
        var savingsPct = pctNum.toFixed(1);
        var savingsDollars = Number(item.savings_dollars || 0).toFixed(0);
        var shipText =
          Number(item.shipping_cost || 0) > 0
            ? '+$' + Number(item.shipping_cost).toFixed(2) + ' ship'
            : 'Free ship';

        var safeUrl =
          item.item_url &&
          (item.item_url.indexOf('http://') === 0 || item.item_url.indexOf('https://') === 0)
            ? item.item_url
            : 'https://www.ebay.com';

        var specs = [];
        if (item.detected_cpu) specs.push(escapeHtml(item.detected_cpu));
        if (item.detected_ram_gb) specs.push(escapeHtml(item.detected_ram_gb) + 'GB RAM');
        if (item.detected_storage) specs.push(escapeHtml(item.detected_storage));
        if (item.config_tier) specs.push(escapeHtml(item.config_tier));

        var sellerMeta = '';
        if (item.seller_positive_percent !== undefined && item.seller_feedback_score !== undefined) {
          sellerMeta =
            ' · Seller ' +
            escapeHtml(item.seller_positive_percent) +
            '% (' +
            escapeHtml(item.seller_feedback_score) +
            ')';
        }

        rows += '<tr class="deal-row">';
        rows += '<td data-label="Listing" class="listing-cell">';
        rows +=
          '<div class="row-rule mono">' +
          escapeHtml(item.rule_name || 'hardware') +
          ' · ' +
          escapeHtml(item.condition_name || 'Used') +
          sellerMeta +
          '</div>';
        rows += '<div class="row-title">' + escapeHtml(item.title) + '</div>';
        rows += '</td>';

        rows += '<td data-label="Specs" class="specs-cell mono">';
        rows += specs.length ? specs.join(' · ') : 'Standalone';
        rows += '</td>';

        rows += '<td data-label="Verdict" class="verdict-cell mono">';
        rows += '<span class="verdict-pct">-' + savingsPct + '%</span>';
        rows += '<span class="verdict-sub">' + verdictText(pctNum) + ' · Save $' + savingsDollars + '</span>';
        rows += '</td>';

        rows += '<td data-label="Total Price" class="num mono price-cell">';
        rows += '<strong>$' + price + '</strong>';
        rows += '<span class="ship-note">' + escapeHtml(shipText) + '</span>';
        rows += '</td>';

        rows += '<td data-label="P20 Ceiling" class="num mono ceiling-cell">$' + ceiling + '</td>';

        rows += '<td data-label="Listing" class="action-col">';
        rows +=
          '<a href="' +
          escapeHtml(safeUrl) +
          '" target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm">eBay ↗</a>';
        rows += '</td>';
        rows += '</tr>';
      });

      dealsTbody.innerHTML = rows;
      if (countLabel) {
        countLabel.textContent =
          'Showing ' +
          deals.length +
          (isLiveSource ? ' live homelab deals' : ' sample deals (homelab tunnel standby)');
      }
    }

    function filterLocalDeals() {
      var rule = filterRule ? filterRule.value : '';
      var tier = filterTier ? filterTier.value : '';
      var minRam = filterRam && filterRam.value ? parseInt(filterRam.value, 10) : null;
      var maxP = filterPrice && filterPrice.value ? parseFloat(filterPrice.value) : null;
      var query = filterQ ? filterQ.value.trim().toLowerCase() : '';

      var filtered = fallbackDeals.filter(function (d) {
        if (rule && d.rule_name !== rule) return false;
        if (tier && d.config_tier !== tier) return false;
        if (minRam && (!d.detected_ram_gb || d.detected_ram_gb < minRam)) return false;
        if (maxP && d.total_price > maxP) return false;
        if (query && d.title.toLowerCase().indexOf(query) === -1) return false;
        return true;
      });

      setSourceIndicator(false);
      renderDeals(filtered, false);
    }

    var liveConfirmed = false;
    var lastFetchedDeals = null;

    function fetchSummary() {
      var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
      var timeoutId = controller
        ? setTimeout(function () {
            controller.abort();
          }, 4500)
        : null;

      fetch(apiBase + '/api/deal-hunter/summary', {
        headers: { Accept: 'application/json' },
        signal: controller ? controller.signal : undefined,
      })
        .then(function (res) {
          if (timeoutId) clearTimeout(timeoutId);
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(function (data) {
          if (!data || !data.available) return;
          liveConfirmed = true;
          setSourceIndicator(true);

          if (kpiTotal && data.total_tracked_items) {
            kpiTotal.textContent = Number(data.total_tracked_items).toLocaleString();
          }
          if (kpiDeals && data.active_deals_count !== undefined) {
            kpiDeals.textContent = String(data.active_deals_count);
          }
          if (kpiDiscount && data.top_discount_pct !== undefined) {
            kpiDiscount.textContent = Number(data.top_discount_pct).toFixed(0) + '%';
          }
          if (kpiBenchmarks && Array.isArray(data.benchmarks) && data.benchmarks.length) {
            kpiBenchmarks.textContent = String(data.benchmarks.length);
          }

          if (filterRule && Array.isArray(data.rule_names) && data.rule_names.length) {
            var currentVal = filterRule.value;
            var optionsHtml = '<option value="">All Categories</option>';
            data.rule_names.forEach(function (rule) {
              var selected = rule === currentVal ? ' selected' : '';
              optionsHtml +=
                '<option value="' + escapeHtml(rule) + '"' + selected + '>' + escapeHtml(rule) + '</option>';
            });
            filterRule.innerHTML = optionsHtml;
          }

          if (benchmarksTbody && Array.isArray(data.benchmarks) && data.benchmarks.length) {
            var rows = '';
            data.benchmarks.slice(0, 15).forEach(function (b) {
              rows += '<tr>';
              rows += '<td class="mono"><strong>' + escapeHtml(b.rule_name) + '</strong></td>';
              rows += '<td class="mono">' + escapeHtml(b.config_tier || 'ALL') + '</td>';
              rows += '<td class="mono num">' + Number(b.sample_count || 0) + '</td>';
              rows += '<td class="mono num accent-val">$' + Number(b.p20_price || 0).toFixed(2) + '</td>';
              rows += '<td class="mono num">$' + Number(b.median_price || 0).toFixed(2) + '</td>';
              rows +=
                '<td class="mono num muted-val">$' +
                Number(b.min_price || 0).toFixed(0) +
                ' – $' +
                Number(b.max_price || 0).toFixed(0) +
                '</td>';
              rows += '</tr>';
            });
            benchmarksTbody.innerHTML = rows;
          }
        })
        .catch(function () {
          if (timeoutId) clearTimeout(timeoutId);
        });
    }

    var fetchTimeout = null;
    function fetchDeals() {
      var rule = filterRule ? filterRule.value : '';
      var tier = filterTier ? filterTier.value : '';
      var minRam = filterRam ? filterRam.value : '';
      var maxPrice = filterPrice ? filterPrice.value : '';
      var q = filterQ ? filterQ.value.trim() : '';
      var hasServerFilter = Boolean(rule || tier || minRam || maxPrice || q);

      var queryParts = ['limit=50'];
      if (rule) queryParts.push('rule_name=' + encodeURIComponent(rule));
      if (tier) queryParts.push('config_tier=' + encodeURIComponent(tier));
      if (minRam) queryParts.push('min_ram_gb=' + encodeURIComponent(minRam));
      if (maxPrice) queryParts.push('max_price=' + encodeURIComponent(maxPrice));
      if (q) queryParts.push('q=' + encodeURIComponent(q));

      var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
      var abortId = controller
        ? setTimeout(function () {
            controller.abort();
          }, 4000)
        : null;

      fetch(apiBase + '/api/deal-hunter/deals?' + queryParts.join('&'), {
        headers: { Accept: 'application/json' },
        signal: controller ? controller.signal : undefined,
      })
        .then(function (res) {
          if (abortId) clearTimeout(abortId);
          if (!res.ok) throw new Error('HTTP ' + res.status);
          return res.json();
        })
        .then(function (data) {
          if (data && data.available && Array.isArray(data.deals) && (data.deals.length > 0 || (liveConfirmed && hasServerFilter))) {
            liveConfirmed = true;
            lastFetchedDeals = data.deals;
            setSourceIndicator(true);
            renderDeals(data.deals, true);
          } else {
            lastFetchedDeals = null;
            filterLocalDeals();
          }
        })
        .catch(function () {
          if (abortId) clearTimeout(abortId);
          lastFetchedDeals = null;
          filterLocalDeals();
        });
    }

    function onServerFilterChange() {
      if (fetchTimeout) clearTimeout(fetchTimeout);
      fetchTimeout = setTimeout(fetchDeals, 220);
    }

    function onClientSortOrVerdictChange() {
      if (lastFetchedDeals !== null) {
        renderDeals(lastFetchedDeals, true);
      } else {
        filterLocalDeals();
      }
    }

    if (filterRule) filterRule.addEventListener('change', onServerFilterChange);
    if (filterTier) filterTier.addEventListener('change', onServerFilterChange);
    if (filterRam) filterRam.addEventListener('change', onServerFilterChange);
    if (filterPrice) filterPrice.addEventListener('input', onServerFilterChange);
    if (filterQ) filterQ.addEventListener('input', onServerFilterChange);
    if (filterVerdict) filterVerdict.addEventListener('change', onClientSortOrVerdictChange);
    if (filterSort) filterSort.addEventListener('change', onClientSortOrVerdictChange);

    if (btnReset) {
      btnReset.addEventListener('click', function () {
        if (filterQ) filterQ.value = '';
        if (filterRule) filterRule.value = '';
        if (filterTier) filterTier.value = '';
        if (filterVerdict) filterVerdict.value = '0';
        if (filterRam) filterRam.value = '';
        if (filterPrice) filterPrice.value = '';
        if (filterSort) filterSort.value = 'savings_pct_desc';
        onServerFilterChange();
      });
    }

    fetchSummary();
    fetchDeals();
  })();
</script>

