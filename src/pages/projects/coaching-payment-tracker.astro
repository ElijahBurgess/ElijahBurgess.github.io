---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Automated Coaching Sync & Square Billing Pipeline | Elijah Burgess"
  description="How Elijah automated coaching session invoicing from Google Calendar to Square using a local-first Raspberry Pi 4 pipeline with human-in-the-loop review."
  canonicalPath="/projects/coaching-payment-tracker"
>
  <div class="project-page">
    <div class="container project-container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-sep">/</span>
        <a href="/#projects">Projects</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">Automated Coaching Sync & Square Billing</span>
      </nav>

      <!-- Hero Header -->
      <header class="project-hero">
        <div class="eyebrow mono">
          <span class="status-dot online"></span>
          Business Automation Case Study // Production Homelab
        </div>
        <h1 class="project-title">Automated Coaching Sync & Square Billing Pipeline</h1>

        <div class="hero-meta-row">
          <div class="tags hero-tags">
            <span class="tag">Raspberry Pi 4 Self-Hosted</span>
            <span class="tag">Google Calendar API</span>
            <span class="tag">Square Invoices API</span>
            <span class="tag">Human-in-the-Loop Safety</span>
            <span class="tag">SQLite WAL Idempotency</span>
            <span class="tag">Python 3 + FastAPI</span>
          </div>

          <div class="status-pill" title="Production Raspberry Pi 4 automation daemon">
            <span class="status-dot online"></span>
            <span class="status-label">Raspberry Pi Daemon Active</span>
          </div>
        </div>

        <p class="hero-summary">
          As a solo AI consultant and 1-on-1 coach, administrative billing used to consume over 45 minutes of manual cross-referencing every week—manually opening calendar entries, matching client names, checking hourly rates, and typing line items into invoicing software. To eliminate this busywork forever, Elijah engineered a private, local-first Python + SQLite pipeline hosted on his <strong>Raspberry Pi 4</strong>. It parses completed coaching sessions, stages them behind an air-tight <strong>human-in-the-loop review gate</strong>, and publishes invoices via Square in <strong>under 60 seconds a week</strong>.
        </p>

        <div class="hero-actions">
          <a href="#roi-metrics" class="btn btn-primary">View Executive ROI</a>
          <a href="#pipeline-explorer" class="btn btn-secondary">Interactive Pipeline Sandbox</a>
          <a href="/?tier=automation#contact" class="btn btn-ghost">Automate Your Operations</a>
        </div>
      </header>

      <!-- Executive ROI Metrics Strip -->
      <section id="roi-metrics" class="section-block">
        <div class="section-header">
          <div class="eyebrow mono">Quantifiable Business Impact</div>
          <h2 class="section-heading">Executive ROI & Operational Gains</h2>
          <p class="section-subtext">
            Measured outcomes from replacing manual spreadsheet reconciliation with a deterministic local-first state machine.
          </p>
        </div>

        <div class="roi-grid">
          <div class="card roi-card">
            <div class="roi-value mono">100%</div>
            <div class="roi-label mono">Elimination of Missed Sessions</div>
            <div class="roi-desc">Every completed billable calendar session is captured and reconciled. Zero forgotten billable hours.</div>
          </div>

          <div class="card roi-card">
            <div class="roi-value mono">&lt; 60 sec</div>
            <div class="roi-label mono">Weekly Billing Review Time</div>
            <div class="roi-desc">Reduced administrative invoicing overhead from 45+ minutes to a single 1-click batch review on the LAN.</div>
          </div>

          <div class="card roi-card">
            <div class="roi-value mono">$0 / mo</div>
            <div class="roi-label mono">Recurring Middleware Fees</div>
            <div class="roi-desc">Eliminated expensive multi-step Zapier and Make subscriptions in favor of a 5-watt self-hosted microservice.</div>
          </div>

          <div class="card roi-card">
            <div class="roi-value mono">Zero</div>
            <div class="roi-label mono">Accidental Invoices Sent</div>
            <div class="roi-desc">A strict staging review gate guarantees no invoice ever leaves the system without explicit 1-click approval.</div>
          </div>
        </div>
      </section>

      <!-- Interactive 4-Step Pipeline Explorer -->
      <section id="pipeline-explorer" class="section-block">
        <div class="section-header">
          <div class="eyebrow mono">Architecture Walkthrough</div>
          <h2 class="section-heading">Interactive 4-Step Pipeline Architecture</h2>
          <p class="section-subtext">
            Click through each stage to inspect the technical data contracts, idempotency checks, and safety controls.
          </p>
        </div>

        <!-- Stage Navigation Tabs -->
        <div class="stage-nav-tabs" role="tablist">
          <button class="stage-tab active" data-stage="1" role="tab" aria-selected="true">
            <span class="stage-num mono">01</span>
            <span class="stage-title">Calendar Ingestion</span>
          </button>
          <button class="stage-tab" data-stage="2" role="tab" aria-selected="false">
            <span class="stage-num mono">02</span>
            <span class="stage-title">SQLite Reconciliation</span>
          </button>
          <button class="stage-tab" data-stage="3" role="tab" aria-selected="false">
            <span class="stage-num mono">03</span>
            <span class="stage-title">Human Staging Gate</span>
          </button>
          <button class="stage-tab" data-stage="4" role="tab" aria-selected="false">
            <span class="stage-num mono">04</span>
            <span class="stage-title">Square API Dispatch</span>
          </button>
        </div>

        <!-- Stage Content Panels -->
        <div class="card stage-panel-card">
          <!-- Stage 1 Panel -->
          <div class="stage-panel active" id="stage-panel-1">
            <div class="panel-header">
              <span class="panel-badge mono">STAGE 1: CALENDAR EVENT INGESTION</span>
              <h3 class="panel-title">OAuth Ingestion & Deterministic Regex Filtering</h3>
            </div>
            <p class="panel-text">
              The service communicates with the Google Calendar API via OAuth 2.0 with automated headless token refresh (<code>token.json</code>). Every evening, a systemd timer polls the calendar for completed events within the past 14 days.
            </p>
            <div class="panel-grid">
              <div class="panel-box">
                <div class="box-label mono">Event Parsing Regex</div>
                <div class="code-block mono">/(?:Success Coaching|Elijah|Success Mentoring)(?:\s+with)?\s+(.+)/i</div>
                <p class="box-desc">Extracts client name from calendar titles regardless of client formatting variations.</p>
              </div>
              <div class="panel-box">
                <div class="box-label mono">Safety & Noise Filtering</div>
                <ul class="box-list">
                  <li>Discards cancelled, declined, or unconfirmed calendar invitations.</li>
                  <li>Automatically identifies <code>[Free Discovery]</code> and intro calls to avoid billing consultations.</li>
                  <li>Computes duration from RFC 3339 timestamps for partial-hour fractional billing.</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Stage 2 Panel -->
          <div class="stage-panel" id="stage-panel-2">
            <div class="panel-header">
              <span class="panel-badge mono">STAGE 2: IDEMPOTENT SQLITE RECONCILIATION</span>
              <h3 class="panel-title">Transactional Deduplication & Custom Rate Matching</h3>
            </div>
            <p class="panel-text">
              Incoming parsed events are written into a local SQLite database configured with Write-Ahead Logging (WAL). Sessions are deduplicated using calendar event IDs as strict unique constraints.
            </p>
            <div class="panel-grid">
              <div class="panel-box">
                <div class="box-label mono">Database Schema Constraint</div>
                <div class="code-block mono">CREATE UNIQUE INDEX idx_event ON meetings(calendar_event_id);</div>
                <p class="box-desc">Re-running sync 10 times a day can never create duplicate meeting records or double-bill.</p>
              </div>
              <div class="panel-box">
                <div class="box-label mono">Client Rate Table Resolution</div>
                <ul class="box-list">
                  <li>Resolves client record by name or email alias against <code>clients</code> table.</li>
                  <li>Retrieves client-specific agreed rates (e.g., $150/hr vs. customized retainer packages).</li>
                  <li>Generates staged line items in state <code>PENDING_REVIEW</code>.</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Stage 3 Panel -->
          <div class="stage-panel" id="stage-panel-3">
            <div class="panel-header">
              <span class="panel-badge mono">STAGE 3: HUMAN-IN-THE-LOOP STAGING GATE</span>
              <h3 class="panel-title">1-Click Local Review Before Financial Dispatch</h3>
            </div>
            <p class="panel-text">
              Financial transactions should never execute fully autonomously without human oversight. Elijah hosts a private, secure FastAPI web dashboard on the local LAN (<code>Raspberry Pi 4:8000</code>).
            </p>
            <div class="panel-grid">
              <div class="panel-box">
                <div class="box-label mono">Granular Line-Item Controls</div>
                <ul class="box-list">
                  <li>Toggle individual sessions on/off with responsive checkboxes.</li>
                  <li>Adjust session rates inline for prorated meetings or credited sessions.</li>
                  <li>Preview live invoice totals and line item descriptions before submission.</li>
                </ul>
              </div>
              <div class="panel-box">
                <div class="box-label mono">Strict Privacy Architecture</div>
                <ul class="box-list">
                  <li>Runs strictly on the local home network with zero public port exposure.</li>
                  <li>Client names and billing figures never pass through third-party multi-tenant SaaS servers.</li>
                  <li>Full audit log of who approved each invoice and at what exact timestamp.</li>
                </ul>
              </div>
            </div>
          </div>

          <!-- Stage 4 Panel -->
          <div class="stage-panel" id="stage-panel-4">
            <div class="panel-header">
              <span class="panel-badge mono">STAGE 4: SQUARE INVOICES API DISPATCH</span>
              <h3 class="panel-title">Deterministic Order Creation & Invoicing Webhooks</h3>
            </div>
            <p class="panel-text">
              Upon clicking "Approve Batch", the system talks directly to the official Square SDK. It creates a customer if new, generates an Order with calculated line items, and publishes the invoice.
            </p>
            <div class="panel-grid">
              <div class="panel-box">
                <div class="box-label mono">Square API Idempotency Token</div>
                <div class="code-block mono">idempotency_key = f"inv_&#123;client_id&#125;_&#123;batch_hash&#125;_&#123;date&#125;"</div>
                <p class="box-desc">Even in the event of network dropouts or timeouts, Square guarantees zero duplicate charges.</p>
              </div>
              <div class="panel-box">
                <div class="box-label mono">Order State Machine Lifecycle</div>
                <ul class="box-list">
                  <li>Supports <code>DRAFT</code> mode for extra inspection or <code>PUBLISHED</code> for automatic email dispatch.</li>
                  <li>Updates local SQLite record with <code>square_invoice_id</code> and direct Square Dashboard deep links.</li>
                  <li>Webhooks track invoice payment status (<code>PAID</code>, <code>UNPAID</code>, <code>REFUNDED</code>).</li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Interactive Client-Side Sandbox Demo -->
      <section class="section-block">
        <div class="section-header">
          <div class="eyebrow mono">Live Interactive Sandbox</div>
          <h2 class="section-heading">Try the Human-in-the-Loop Staging Review</h2>
          <p class="section-subtext">
            Experience the exact workflow in a safe, client-side sandbox using fictional sample data. Zero real client information or external APIs are touched.
          </p>
        </div>

        <div class="card sandbox-card">
          <div class="sandbox-header">
            <div>
              <div class="sandbox-title mono">LAN Review Dashboard // Simulated Raspberry Pi 4</div>
              <div class="sandbox-sub">Filter: <strong>Pending Review (2 Sessions Found)</strong></div>
            </div>
            <div class="sandbox-total mono">
              Staged Total: <span id="sandbox-total-amount">$275.00</span>
            </div>
          </div>

          <!-- Staged Items List -->
          <div class="sandbox-items-list" id="sandbox-items-list">
            <!-- Item 1 -->
            <div class="sandbox-item card" id="demo-item-1">
              <div class="item-checkbox-col">
                <input type="checkbox" id="check-item-1" class="sandbox-checkbox" checked />
              </div>
              <div class="item-content-col">
                <div class="item-client-row">
                  <span class="client-name">Alex Rivera</span>
                  <span class="client-type mono">Bi-Weekly AI Productivity Session</span>
                  <span class="item-rate mono">$150.00</span>
                </div>
                <div class="item-details-row">
                  <span class="item-time">Yesterday, 2:00 PM – 3:00 PM (60 min)</span>
                  <span class="item-sep">•</span>
                  <span class="item-src mono">Google Meet #cal_evt_9a48f2</span>
                  <span class="item-sep">•</span>
                  <span class="item-status mono status-pending">PENDING APPROVAL</span>
                </div>
              </div>
            </div>

            <!-- Item 2 -->
            <div class="sandbox-item card" id="demo-item-2">
              <div class="item-checkbox-col">
                <input type="checkbox" id="check-item-2" class="sandbox-checkbox" checked />
              </div>
              <div class="item-content-col">
                <div class="item-client-row">
                  <span class="client-name">Dr. Elena Vance</span>
                  <span class="client-type mono">Systems Engineering Mentorship</span>
                  <span class="item-rate mono">$125.00</span>
                </div>
                <div class="item-details-row">
                  <span class="item-time">Tuesday, 10:00 AM – 10:45 AM (45 min)</span>
                  <span class="item-sep">•</span>
                  <span class="item-src mono">Google Meet #cal_evt_8c11e4</span>
                  <span class="item-sep">•</span>
                  <span class="item-status mono status-pending">PENDING APPROVAL</span>
                </div>
              </div>
            </div>

            <!-- Item 3: Filtered Out / Free Intro -->
            <div class="sandbox-item card item-ignored">
              <div class="item-checkbox-col">
                <input type="checkbox" disabled />
              </div>
              <div class="item-content-col">
                <div class="item-client-row">
                  <span class="client-name">Marcus Chen</span>
                  <span class="client-type mono">[Free Discovery] Workflow Audit Intro</span>
                  <span class="item-rate mono" style="color: var(--muted);">$0.00</span>
                </div>
                <div class="item-details-row">
                  <span class="item-time">Monday, 3:30 PM (30 min)</span>
                  <span class="item-sep">•</span>
                  <span class="item-src mono">Filtered: Free Intro Tag</span>
                  <span class="item-sep">•</span>
                  <span class="item-status mono" style="color: var(--text-dim);">AUTOMATICALLY EXCLUDED</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Sandbox Action Footer -->
          <div class="sandbox-footer">
            <div class="sandbox-help">
              <span class="help-icon">&check;</span> Toggle checkboxes or test dispatching the invoice batch.
            </div>
            <div class="sandbox-buttons">
              <button type="button" id="btn-sandbox-approve" class="btn btn-primary">
                Approve &amp; Stage Invoice Batch
              </button>
              <button type="button" id="btn-sandbox-reset" class="btn btn-secondary" style="display: none;">
                Reset Demo
              </button>
            </div>
          </div>

          <!-- Dispatch Result Preview Box -->
          <div id="sandbox-success-box" class="sandbox-success-box" style="display: none;">
            <div class="success-banner">
              <span class="status-dot online"></span>
              <strong>Square API Batch Dispatched Successfully</strong>
            </div>
            <div class="success-payload mono">
              <div>&gt; Generated Idempotency Key: <span class="payload-hl">sq_idemp_7f920d3a_202611</span></div>
              <div>&gt; Square Customers Matched: <span class="payload-hl">CUST_RIVERA_8829</span>, <span class="payload-hl">CUST_VANCE_4012</span></div>
              <div>&gt; Orders Created: <span class="payload-hl">2 Line Items totaling $275.00</span></div>
              <div>&gt; Square Invoice Status: <span class="payload-hl">DRAFT / PUBLISHED</span> (Viewable in Square Merchant Portal)</div>
              <div>&gt; SQLite Audit Log: <span class="payload-hl">2 meeting records reconciled in 0.04s</span></div>
            </div>
          </div>
        </div>
      </section>

      <!-- Why Custom Code Beats Fragile No-Code Zaps -->
      <section class="section-block">
        <div class="section-header">
          <div class="eyebrow mono">Engineering Philosophy</div>
          <h2 class="section-heading">Why Custom Code Beats Fragile No-Code Zaps</h2>
          <p class="section-subtext">
            Why professional automation engineering relies on idempotent code rather than brittle multi-step SaaS subscriptions.
          </p>
        </div>

        <div class="card comparison-card">
          <div class="comparison-table-wrapper">
            <table class="comparison-table">
              <thead>
                <tr>
                  <th class="col-feature">Architectural Dimension</th>
                  <th class="col-zapier">Generic SaaS / Zapier / Make</th>
                  <th class="col-custom">Elijah's Local-First Pipeline</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="cell-feature"><strong>Deduplication &amp; Idempotency</strong></td>
                  <td class="cell-zapier">
                    <span class="risk-pill">High Risk</span>
                    Triggers fire multiple times on rescheduled meetings; prone to double-charging clients.
                  </td>
                  <td class="cell-custom">
                    <span class="win-pill">Guaranteed</span>
                    Database-level <code>UNIQUE(calendar_event_id)</code> + Square idempotency keys prevent duplicates.
                  </td>
                </tr>
                <tr>
                  <td class="cell-feature"><strong>Human-in-the-Loop Oversight</strong></td>
                  <td class="cell-zapier">
                    <span class="risk-pill">Blind Push</span>
                    Sends emails automatically on trigger; calendar typos turn into embarrassing billing disputes.
                  </td>
                  <td class="cell-custom">
                    <span class="win-pill">Staging Gate</span>
                    FastAPI review dashboard allows Elijah to review, edit, or exclude sessions with 1 click before send.
                  </td>
                </tr>
                <tr>
                  <td class="cell-feature"><strong>Operating Cost &amp; SaaS Lock-In</strong></td>
                  <td class="cell-zapier">
                    <span class="risk-pill">$360 – $840 / year</span>
                    Expensive tiered subscriptions that scale up as your meeting volume increases.
                  </td>
                  <td class="cell-custom">
                    <span class="win-pill">$0 / month</span>
                    Runs continuously on a 5-watt self-hosted Raspberry Pi 4 with zero software fees.
                  </td>
                </tr>
                <tr>
                  <td class="cell-feature"><strong>Client Data Privacy</strong></td>
                  <td class="cell-zapier">
                    <span class="risk-pill">Third-Party Cloud</span>
                    Client names, emails, and financial amounts pass through shared multi-tenant cloud servers.
                  </td>
                  <td class="cell-custom">
                    <span class="win-pill">100% Private</span>
                    OAuth tokens, client lists, and rate tables remain strictly on local encrypted disk.
                  </td>
                </tr>
                <tr>
                  <td class="cell-feature"><strong>Reliability &amp; Maintainability</strong></td>
                  <td class="cell-zapier">
                    <span class="risk-pill">Brittle</span>
                    Silent token expirations, unannounced UI changes, and limited error debugging.
                  </td>
                  <td class="cell-custom">
                    <span class="win-pill">Rock Solid</span>
                    14 passing <code>pytest</code> unit tests, structured logs, and automatic systemd service restart.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- Conversion Bridge Banner -->
      <section class="section-block">
        <div class="cta-banner">
          <div class="eyebrow mono" style="color: var(--accent);">Bespoke Business Process Automation</div>
          <h2 class="cta-heading">Spending Hours Every Week Reconciling Calendars, Spreadsheets, or Invoices?</h2>
          <p class="cta-desc">
            Let's automate your repetitive business workflows in a focused 1- to 2-week sprint. We build robust, reliable systems—self-hosted on your hardware or cloud-native—with zero recurring middleware fees.
          </p>
          <div class="cta-actions">
            <a href="/?tier=automation#contact" class="btn btn-primary">Book an Automation Consultation</a>
            <a href="/#services" class="btn btn-secondary">Explore Consulting Services</a>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script is:inline>
  // 1. Stage Panel Tab Switcher
  (function initStageTabs() {
    var tabs = document.querySelectorAll('.stage-tab');
    var panels = document.querySelectorAll('.stage-panel');

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var stageNum = tab.getAttribute('data-stage');

        tabs.forEach(function (t) {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        panels.forEach(function (p) {
          p.classList.remove('active');
        });

        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        var targetPanel = document.getElementById('stage-panel-' + stageNum);
        if (targetPanel) {
          targetPanel.classList.add('active');
        }
      });
    });
  })();

  // 2. Interactive Client-Side Sandbox Logic
  (function initSandbox() {
    var check1 = document.getElementById('check-item-1');
    var check2 = document.getElementById('check-item-2');
    var totalEl = document.getElementById('sandbox-total-amount');
    var approveBtn = document.getElementById('btn-sandbox-approve');
    var resetBtn = document.getElementById('btn-sandbox-reset');
    var successBox = document.getElementById('sandbox-success-box');

    function updateTotal() {
      var total = 0;
      if (check1 && check1.checked) total += 150.0;
      if (check2 && check2.checked) total += 125.0;

      if (totalEl) {
        totalEl.textContent = '$' + total.toFixed(2);
      }

      if (approveBtn) {
        if (total === 0) {
          approveBtn.disabled = true;
          approveBtn.textContent = 'Select at least 1 session';
        } else {
          approveBtn.disabled = false;
          approveBtn.textContent = 'Approve & Stage Invoice Batch';
        }
      }
    }

    if (check1) check1.addEventListener('change', updateTotal);
    if (check2) check2.addEventListener('change', updateTotal);

    if (approveBtn) {
      approveBtn.addEventListener('click', function () {
        if (successBox) successBox.style.display = 'block';
        approveBtn.style.display = 'none';
        if (resetBtn) resetBtn.style.display = 'inline-flex';

        // Update badges to approved
        document.querySelectorAll('.status-pending').forEach(function (el) {
          el.textContent = 'STAGED FOR SQUARE';
          el.style.color = 'var(--accent-2)';
        });
      });
    }

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        if (successBox) successBox.style.display = 'none';
        if (approveBtn) {
          approveBtn.style.display = 'inline-flex';
          approveBtn.disabled = false;
        }
        resetBtn.style.display = 'none';

        if (check1) check1.checked = true;
        if (check2) check2.checked = true;
        updateTotal();

        document.querySelectorAll('.status-pending').forEach(function (el) {
          el.textContent = 'PENDING APPROVAL';
          el.style.color = '#eab308';
        });
      });
    }
  })();
</script>

<style>
  .project-page {
    padding: 2rem 0 5rem 0;
  }

  .project-container {
    max-width: 1100px;
  }

  /* Hero Section */
  .project-hero {
    margin-bottom: 3.5rem;
  }

  .project-title {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: var(--text);
    margin-bottom: 1.25rem;
  }

  .hero-meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }

  .hero-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .hero-summary {
    font-size: 1.125rem;
    color: var(--muted);
    line-height: 1.7;
    max-width: 900px;
    margin-bottom: 2rem;
  }

  .hero-summary strong {
    color: var(--text);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  /* Section Blocks */
  .section-block {
    margin-bottom: 4.5rem;
  }

  .section-header {
    margin-bottom: 2rem;
  }

  .section-heading {
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    font-weight: 700;
