---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Eliheadshot from '../assets/Eliheadshot.jpg';
---

<BaseLayout
  title="Elijah Burgess — Applied AI Engineering, Automation Consulting & Coaching"
  description="Building intelligent systems & helping people work with clarity. Explore live self-hosted AI research, game AI, and 1-on-1 coaching based in Madison, WI."
>
  <!-- =========================================================================
       1. HERO SECTION (#top)
       ========================================================================= -->
  <section id="top" class="hero-section">
    <div class="hero-bg-mesh" aria-hidden="true"></div>
    <div class="container hero-container">
      <div class="hero-content">
        <div class="eyebrow mono">
          <span class="status-dot online"></span>
          Applied AI Engineering • Automation Consulting • Success Coaching
        </div>
        <h1 class="hero-headline">
          Building intelligent systems &amp; helping people work with clarity.
        </h1>
        <p class="hero-subhead">
          Explore my live self-hosted AI research, reinforcement learning engines, and automation projects—or work with me 1-on-1 for AI workflow consulting and success coaching.
        </p>

        <div class="hero-actions">
          <a href="#contact" class="btn btn-primary hero-btn">
            Book a Free 15-Min Intro Call
          </a>
          <a href="#services" class="btn btn-secondary hero-btn">
            Explore Services
          </a>
          <a href="#projects" class="hero-tertiary-link">
            Try Live AI Demos <span class="arrow" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <div class="hero-visual">
        <div class="hero-avatar-wrapper">
          <Image
            src={Eliheadshot}
            alt="Elijah Burgess — Applied AI Engineer & Coach"
            widths={[168, 336]}
            sizes="168px"
            formats={['avif', 'webp']}
            loading="eager"
            fetchpriority="high"
            class="hero-avatar"
          />
          <div class="hero-badge status-pill">
            <span class="status-dot online"></span>
            <span class="hero-badge-text">Madison, WI • Accepting New Clients</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       2. CREDIBILITY & SOCIAL PROOF STRIP
       ========================================================================= -->
  <section class="proof-section" aria-label="Credibility and Qualifications">
    <div class="container">
      <div class="proof-grid">
        <div class="proof-card">
          <div class="proof-header">
            <span class="proof-icon" aria-hidden="true">⚡</span>
            <span class="proof-title">Applied AI &amp; Systems</span>
          </div>
          <p class="proof-text">
            24/7 self-hosted Proxmox cluster, sub-10ms search across 71.5k+ papers &amp; 65 code shards, and 17 live neural bots.
          </p>
        </div>

        <div class="proof-card">
          <div class="proof-header">
            <span class="proof-icon" aria-hidden="true">📱</span>
            <span class="proof-title">Published Mobile Founder</span>
          </div>
          <p class="proof-text">
            Creator of <em>Toddler Touch Screen Lock</em> (Burgess Meditation LLC) on Google Play—100% offline, zero-data architecture.
          </p>
        </div>

        <div class="proof-card">
          <div class="proof-header">
            <span class="proof-icon" aria-hidden="true">🎯</span>
            <span class="proof-title">1-on-1 Personal Coach</span>
          </div>
          <p class="proof-text">
            Structured weekly accountability and custom automation setups for students, founders, and technical professionals.
          </p>
        </div>

        <div class="proof-card">
          <div class="proof-header">
            <span class="proof-icon" aria-hidden="true">🛡️</span>
            <span class="proof-title">Local Roots &amp; Delivery</span>
          </div>
          <p class="proof-text">
            Based in <strong>Madison, WI (CST)</strong> • Client-owned open-source code, zero proprietary vendor lock-in.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       3. PRODUCTIZED SERVICES (#services)
       ========================================================================= -->
  <section id="services" class="section services-section">
    <div class="container">
      <div class="section-header">
        <div class="eyebrow mono">Direct Offerings</div>
        <h2 class="section-title">Productized Services &amp; Coaching</h2>
        <p class="section-subtitle">
          Transparent, results-driven engagements designed for individuals seeking execution clarity and small teams needing resilient automation.
        </p>
      </div>

      <div class="services-grid">
        <!-- Tier 1: 1-on-1 Coaching -->
        <article class="service-card card" data-tier="1-on-1 Success & AI Productivity Coaching">
          <div class="service-card-top">
            <span class="service-tag mono">Personal &amp; Executive Coaching</span>
            <h3 class="service-title">1-on-1 Success &amp; AI Productivity Coaching</h3>
            <p class="service-summary">
              Structured coaching sessions to build repeatable systems, master AI workflows, and achieve measurable personal or academic milestones.
            </p>
            <ul class="deliverables-list" aria-label="Coaching Deliverables">
              <li>Weekly or bi-weekly 1-on-1 coaching sessions</li>
              <li>Personalized AI &amp; automation workflow setup</li>
              <li>Automated Google Calendar scheduling &amp; transparent billing</li>
              <li>First 15-min intro alignment call free</li>
            </ul>
          </div>
          <div class="service-card-bottom">
            <a
              href="?tier=coaching#contact"
              class="btn btn-secondary btn-full service-cta"
              data-select-tier="1-on-1 Success & AI Productivity Coaching"
            >
              Book Free Intro Session &rarr;
            </a>
          </div>
        </article>

        <!-- Tier 2: AI Workflow & Automation Consulting (Featured) -->
        <article class="service-card card featured-service" data-tier="AI Workflow & Automation Consulting">
          <div class="featured-badge mono">Most Requested • Fast ROI</div>
          <div class="service-card-top">
            <span class="service-tag mono">Small Business &amp; Teams</span>
            <h3 class="service-title">AI Workflow &amp; Automation Consulting</h3>
            <p class="service-summary">
              Turn manual bottlenecks into reliable, automated pipelines—from custom LLM agents and data scrapers to billing and CRM integrations.
            </p>
            <ul class="deliverables-list" aria-label="Consulting Deliverables">
              <li>Architecture &amp; process audit with actionable ROI roadmap</li>
              <li>Custom Python / FastAPI / Playwright automation pipelines</li>
              <li>Local-first or cloud-hybrid deployment with 100% code ownership</li>
              <li>Typically delivered in 1- to 2-week focused sprints</li>
            </ul>
          </div>
          <div class="service-card-bottom">
            <a
              href="?tier=automation#contact"
              class="btn btn-primary btn-full service-cta"
              data-select-tier="AI Workflow & Automation Consulting"
            >
              Request Workflow Audit &rarr;
            </a>
          </div>
        </article>

        <!-- Tier 3: Custom AI Systems & Homelab Engineering -->
        <article class="service-card card" data-tier="Custom AI Systems & Homelab Engineering">
          <div class="service-card-top">
            <span class="service-tag mono">Technical Advisory &amp; Build</span>
            <h3 class="service-title">Custom AI Systems &amp; Homelab Engineering</h3>
            <p class="service-summary">
              End-to-end design of private AI infrastructure, RAG knowledge bases, reinforcement learning environments, and self-hosted services.
            </p>
            <ul class="deliverables-list" aria-label="Advisory Deliverables">
              <li>Private RAG &amp; MCP (Model Context Protocol) tool servers</li>
              <li>Proxmox / Docker / Tailscale secure homelab infrastructure</li>
              <li>Hands-on technical mentoring, architecture design, and code review</li>
              <li>Self-hosted LLM &amp; ONNX CPU neural inference optimization</li>
            </ul>
          </div>
          <div class="service-card-bottom">
            <a
              href="?tier=advisory#contact"
              class="btn btn-secondary btn-full service-cta"
              data-select-tier="Custom AI Systems & Homelab Engineering"
            >
              Discuss Architecture &rarr;
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       4. 3-STEP ENGAGEMENT PROCESS (#process)
       ========================================================================= -->
  <section id="process" class="section process-section">
    <div class="container">
      <div class="section-header">
        <div class="eyebrow mono">Transparent Framework</div>
        <h2 class="section-title">How Working Together Works</h2>
        <p class="section-subtitle">
          No vague retainers or hidden scope creep. Every project follows a clear 3-step progression from initial alignment to production delivery.
        </p>
      </div>

      <div class="process-grid">
        <div class="process-card card">
          <div class="process-step mono">01</div>
          <h3 class="process-title">Free 15-Min Intro Call</h3>
          <p class="process-desc">
            We discuss your current bottleneck, daily friction, or AI goals. Zero pitch; clear determination of whether we're a mutual fit.
          </p>
        </div>

        <div class="process-card card">
          <div class="process-step mono">02</div>
          <h3 class="process-title">Scoped Roadmap &amp; Prototype</h3>
          <p class="process-desc">
            You receive a fixed-scope roadmap with exact deliverables, timeline (typically 1–2 weeks for automations), and transparent flat-milestone pricing.
          </p>
        </div>

        <div class="process-card card">
          <div class="process-step mono">03</div>
          <h3 class="process-title">Deploy, Train &amp; Own</h3>
          <p class="process-desc">
            We implement the solution, verify it together, and hand over 100% documentation and code. You own the infrastructure with zero recurring licensing fees.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       5. INTERACTIVE AI & SYSTEMS ENGINEERING SHOWCASE (#projects)
       ========================================================================= -->
  <section id="projects" class="section showcase-section">
    <div class="container">
      <div class="section-header">
        <div class="eyebrow mono">Live Self-Hosted Systems</div>
        <h2 class="section-title">Interactive AI &amp; Systems Engineering Showcase</h2>
        <p class="section-subtitle">
          Every system below is built from scratch and running live 24/7 on my Proxmox homelab cluster, powered by local compute, edge caching, and real-time telemetry.
        </p>
      </div>

      <!-- Bento Grid (6-column desktop layout) -->
      <div class="bento-grid">
        <!-- Project 1: BoredGamer Arena (3 cols) -->
        <article class="bento-card bento-span-3 card">
          <div class="bento-card-header">
            <span class="bento-category mono">Reinforcement Learning &amp; Game AI</span>
            <div class="status-pill" id="telemetry-arena" title="Proxmox CT 105 Arena Server Status">
              <span class="status-dot online"></span>
              <span class="telemetry-text">17 Neural Bots Ready</span>
            </div>
          </div>
          <h3 class="bento-title">BoredGamer Arena — Kingdomino &amp; Pinochle AI</h3>
          <p class="bento-summary">
            Rust + PyO3 zero-copy game engines, self-play reinforcement learning, ONNX CPU inference, and Information Set MCTS (IS-MCTS) search running 24/7 on Proxmox CT 105.
          </p>
          <div class="bento-tags tags">
            <span class="tag">Rust</span>
            <span class="tag">PyO3</span>
            <span class="tag">ONNX Runtime</span>
            <span class="tag">IS-MCTS</span>
            <span class="tag">WebSockets</span>
          </div>
          <div class="bento-actions">
            <a
              href="https://arena.eliburgessconsulting.com"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary btn-sm"
            >
              Play Live vs. AI ↗
            </a>
            <a href="/projects/boredgamer-arena" class="btn btn-secondary btn-sm">
              Case Study &rarr;
            </a>
          </div>
        </article>

        <!-- Project 2: Research & Bioinformatics Hub (3 cols) -->
        <article class="bento-card bento-span-3 card">
          <div class="bento-card-header">
            <span class="bento-category mono">RAG, Code Search &amp; Bioinformatics</span>
            <div class="status-pill" id="telemetry-research" title="Proxmox CT 107 Research Hub Status">
              <span class="status-dot online"></span>
              <span class="telemetry-text">71.5k+ Papers • 65 Shards</span>
            </div>
          </div>
          <h3 class="bento-title">Local-First AI Research &amp; Bioinformatics Hub</h3>
          <p class="bento-summary">
            Sub-10ms DuckDB BM25 search, Zoekt trigram code indexing, local NCBI BLAST+, Kiwix ZIM archives, and FastMCP agent server running on Proxmox CT 107.
          </p>
          <div class="bento-tags tags">
            <span class="tag">DuckDB BM25</span>
            <span class="tag">Zoekt</span>
            <span class="tag">NCBI BLAST+</span>
            <span class="tag">FastMCP</span>
            <span class="tag">Python</span>
          </div>
          <div class="bento-actions">
            <a href="/projects/research-hub" class="btn btn-secondary btn-sm">
              Explore Architecture &rarr;
            </a>
          </div>
        </article>

        <!-- Project 3: eBay Deal Hunter (2 cols) -->
        <article class="bento-card bento-span-2 card">
          <div class="bento-card-header">
            <span class="bento-category mono">Scraping &amp; Valuation</span>
            <div class="status-pill" id="telemetry-deals" title="CT 104 SQLite WAL Deal Hunter">
              <span class="status-dot online"></span>
              <span class="telemetry-text">2,700+ Tracked Listings</span>
            </div>
          </div>
          <h3 class="bento-title">eBay Homelab Deal Hunter</h3>
          <p class="bento-summary">
            Automated hardware price-ceiling benchmarking, CPU/RAM/SSD spec extraction, and live SQLite deal explorer on CT 104.
          </p>
          <div class="bento-tags tags">
            <span class="tag">Python</span>
            <span class="tag">SQLite</span>
            <span class="tag">FastAPI</span>
            <span class="tag">Market Analytics</span>
          </div>
          <div class="bento-actions">
            <a href="/projects/deal-hunter" class="btn btn-secondary btn-sm">
              Launch Deal Explorer &rarr;
            </a>
          </div>
        </article>

        <!-- Project 4: Coaching Sync & Square Billing (2 cols) -->
        <article class="bento-card bento-span-2 card">
          <div class="bento-card-header">
            <span class="bento-category mono">Business Automation</span>
            <div class="status-pill">
              <span class="status-dot static"></span>
              <span>Production Pipeline • Pi 4</span>
            </div>
          </div>
          <h3 class="bento-title">Automated Coaching Sync &amp; Square Billing</h3>
          <p class="bento-summary">
            Google Calendar event parsing, human-in-the-loop staging review gate, and automated Square Invoices API billing.
          </p>
          <div class="bento-tags tags">
            <span class="tag">Google Calendar API</span>
            <span class="tag">Square API</span>
            <span class="tag">SQLite</span>
            <span class="tag">Automation</span>
          </div>
          <div class="bento-actions">
            <a href="/projects/coaching-payment-tracker" class="btn btn-secondary btn-sm">
              Read Case Study &rarr;
            </a>
          </div>
        </article>

        <!-- Project 5: Toddler Touch Screen Lock (2 cols) -->
        <article class="bento-card bento-span-2 card">
          <div class="bento-card-header">
            <span class="bento-category mono">Android &amp; Consumer App</span>
            <div class="status-pill">
              <span class="status-dot online"></span>
              <span>Google Play • 100% Offline</span>
            </div>
          </div>
          <h3 class="bento-title">Toddler Touch Screen Lock</h3>
          <p class="bento-summary">
            Published Android accessibility touch-shield (Burgess Meditation LLC) with hardware volume-combo unlock and zero internet permission.
          </p>
          <div class="bento-tags tags">
            <span class="tag">Kotlin</span>
            <span class="tag">Android</span>
            <span class="tag">Privacy-by-Design</span>
          </div>
          <div class="bento-actions">
            <a href="/projects/toddler-touch-screen-lock" class="btn btn-secondary btn-sm">
              Interactive Showcase &rarr;
            </a>
            <a href="/toddler-touch-screen-lock-privacy/" class="btn btn-ghost btn-sm">
              Privacy Policy
            </a>
          </div>
        </article>
      </div>

      <!-- Live Cluster Nodes & Valheim Dedicated Server Strip -->
      <div class="cluster-telemetry-strip card">
        <div class="cluster-strip-col">
          <div class="cluster-strip-header">
            <span class="status-pill mono">
              <span class="status-dot online"></span>
              VM 102 • Active Multi-Agent Node
            </span>
          </div>
          <h4 class="cluster-strip-title">Antigravity 24/7 Cloud IDE &amp; Mobile Gateway</h4>
          <p class="cluster-strip-desc">
            Self-hosted multi-agent development workspace &amp; Tailscale mobile gateway running continuous coding agents across Proxmox virtual machines.
          </p>
        </div>

        <div class="cluster-strip-col">
          <div class="cluster-strip-header">
            <div class="status-pill mono" id="valheim-pill" title="CT 101 Dedicated Game Server">
              <span class="status-dot loading" id="valheim-status-dot"></span>
              <span id="valheim-status-text">Checking CT 101…</span>
            </div>
          </div>
          <h4 class="cluster-strip-title">Valheim Dedicated Server Live Telemetry</h4>
          <p class="cluster-strip-desc">
            <span id="valheim-server-name">Aurora Family Friends [AuroraV1]</span> &bull;
            <span id="valheim-player-count">Checking players...</span> &bull;
            <span id="valheim-uptime">Proxmox Dedicated</span>
          </p>
          <div class="cluster-strip-mods tags" id="valheim-mods">
            <span class="tag">ValheimBandwidthUnlocker</span>
            <span class="tag">FuelEternal</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       6. "MEET ELIJAH" BIO & REAL-WORLD ROI VIGNETTE (#about)
       ========================================================================= -->
  <section id="about" class="section about-section">
    <div class="container">
      <div class="about-grid">
        <div class="about-bio">
          <div class="eyebrow mono">Behind the Systems</div>
          <h2 class="about-title">Engineering with Rigor, Coaching with Empathy.</h2>
          <p class="about-paragraph">
            I'm Elijah Burgess—an applied AI systems engineer, published Android app founder, and 1-on-1 coach based in Madison, WI.
          </p>
          <p class="about-paragraph">
            I bridge the gap between deep systems engineering (reinforcement learning, sub-10ms search, self-hosted infrastructure) and human execution (habit formation, structured workflows, stress-free automation). Whether you're an individual wanting to master personal productivity or a business looking to automate repetitive grunt work, I build durable systems that simply work.
          </p>
          <div class="about-creds">
            <div class="cred-item">
              <span class="cred-dot" aria-hidden="true">&bull;</span>
              <span><strong>Madison, WI (CST):</strong> Local face-to-face or remote sessions with high responsiveness.</span>
            </div>
            <div class="cred-item">
              <span class="cred-dot" aria-hidden="true">&bull;</span>
              <span><strong>Client Ownership:</strong> You retain complete source code and access credentials.</span>
            </div>
            <div class="cred-item">
              <span class="cred-dot" aria-hidden="true">&bull;</span>
              <span><strong>Local-First &amp; Private:</strong> Data remains yours; zero forced third-party lock-ins.</span>
            </div>
          </div>
        </div>

        <div class="about-vignette">
          <div class="roi-card card">
            <div class="eyebrow mono">
              <span class="status-dot online"></span>
              Practice What I Preach
            </div>
            <h3 class="roi-card-title">Real-World Automation in Action</h3>
            <blockquote class="roi-quote">
              &ldquo;For my own coaching practice, I built an automated pipeline that parses Google Calendar events, stages client reviews, and triggers Square invoices without human error—saving hours of administrative busywork every month. I bring that exact automation rigor to your operations.&rdquo;
            </blockquote>
            <div class="roi-card-footer">
              <span class="roi-impact-badge mono">Saved 5+ Admin Hours/Mo</span>
              <a href="/projects/coaching-payment-tracker" class="btn btn-secondary btn-sm">
                Read Case Study &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       7. 5-QUESTION OBJECTION-HANDLING FAQ (#faq)
       ========================================================================= -->
  <section id="faq" class="section faq-section">
    <div class="container">
      <div class="section-header">
        <div class="eyebrow mono">Clear Answers</div>
        <h2 class="section-title">Frequently Asked Questions</h2>
        <p class="section-subtitle">
          Everything you need to know about working together, security, pricing, and expectations before scheduling our first conversation.
        </p>
      </div>

      <div class="faq-list">
        <!-- Question 1 -->
        <details class="faq-item card">
          <summary class="faq-summary">
            <span class="faq-question">Do I need technical experience to work with you?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-answer">
            <p>
              Not at all. For 1-on-1 coaching and automation consulting, I handle all the technical architecture and setup behind the scenes. We focus together on your goals, habits, and workflows, ensuring everything is simple, intuitive, and easy to maintain without requiring any programming knowledge.
            </p>
          </div>
        </details>

        <!-- Question 2 -->
        <details class="faq-item card">
          <summary class="faq-summary">
            <span class="faq-question">Will my company or personal data stay private?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-answer">
            <p>
              Yes, 100%. I prioritize local-first and self-hosted architectures. When designing automation or private AI tools, data can be processed on your own hardware or private cloud instance, completely insulated from public LLM training datasets. Zero proprietary vendor lock-in and zero unauthorized third-party access.
            </p>
          </div>
        </details>

        <!-- Question 3 -->
        <details class="faq-item card">
          <summary class="faq-summary">
            <span class="faq-question">Do you charge recurring license fees, or do I own the code?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-answer">
            <p>
              You own 100% of the code and deliverables. I deliver clean, production-ready Python, scripts, and infrastructure configurations with comprehensive documentation. There are no proprietary lock-ins or recurring SaaS seat licenses from my end—you keep complete freedom and ownership.
            </p>
          </div>
        </details>

        <!-- Question 4 -->
        <details class="faq-item card">
          <summary class="faq-summary">
            <span class="faq-question">How much does a typical engagement cost?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-answer">
            <p>
              Engagements are scoped with transparent, flat-milestone pricing so you never face unexpected billing surprises. 1-on-1 coaching is billed on a straightforward session or monthly retainer basis, while automation sprints typically range from 1 to 2 weeks for targeted pipelines. We establish exact deliverables and scope upfront.
            </p>
          </div>
        </details>

        <!-- Question 5 -->
        <details class="faq-item card">
          <summary class="faq-summary">
            <span class="faq-question">What happens on the 15-minute intro call?</span>
            <span class="faq-icon" aria-hidden="true">+</span>
          </summary>
          <div class="faq-answer">
            <p>
              The intro call is a focused, 15-minute alignment conversation to discuss your primary bottleneck, daily friction, or AI project goals. There is zero high-pressure pitch; we evaluate mutual fit and map out the highest-leverage next step whether we end up working together or not.
            </p>
          </div>
        </details>
      </div>
    </div>
  </section>

  <!-- =========================================================================
       8. 2-COLUMN CONTACT & BOOKING SECTION (#contact)
       ========================================================================= -->
  <section id="contact" class="section contact-section">
    <div class="container">
      <div class="section-header">
        <div class="eyebrow mono">Direct Communication</div>
        <h2 class="section-title">Start a Conversation</h2>
        <p class="section-subtitle">
          Inquiries are recorded directly to my Proxmox homelab cluster and forwarded instantly to my phone. Guaranteed response within 24 hours.
        </p>
      </div>

      <div class="contact-grid">
        <!-- Left Column: Direct Access & Expectations -->
        <div class="contact-info-col">
          <!-- SLA Guarantee Card -->
          <div class="contact-sla-card card">
            <div class="sla-item">
              <span class="sla-badge mono">SLA Guarantee</span>
              <h3 class="sla-title">Response time: Under 24 hours guaranteed.</h3>
              <p class="sla-desc">
                Direct engineer access—you communicate directly with Elijah, never an account manager or outsourced contractor.
              </p>
            </div>
            <div class="sla-meta">
              <div class="sla-meta-item">
                <span class="sla-meta-label mono">Location &amp; Timezone</span>
                <span class="sla-meta-val">Madison, Wisconsin &bull; Central Time (CST/CDT)</span>
              </div>
              <div class="sla-meta-item">
