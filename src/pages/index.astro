---
const apiBase = import.meta.env.PUBLIC_API_BASE_URL || 'https://api.eliburgessconsulting.com';
const lanApiBase = 'http://192.168.0.108:8006';

const defaultProjects = [
  {
    id: 'boredgamer-arena',
    title: 'BoredGamer Arena — Multi-Agent AI Board Game Engine',
    category: 'Reinforcement Learning & Game AI',
    stack: ['Rust', 'PyO3', 'ONNX Runtime', 'IS-MCTS', 'FastAPI', 'React'],
    summary:
      '24/7 multiplayer & AI board game lounge hosting neural Kingdomino and Partnership Pinochle agents trained via self-play.',
    live_demo_available: true,
  },
  {
    id: 'research-bioinfo-hub',
    title: 'Local-First AI Research & Bioinformatics Knowledge Engine',
    category: 'RAG, Search & Bioinformatics',
    stack: ['DuckDB BM25', 'Zoekt', 'FastMCP', 'BLAST+', 'FastAPI'],
    summary:
      'Sub-10ms code search across 59 repositories, 2.6M arXiv papers, and viral genomics databases exposed via Model Context Protocol (MCP).',
    live_demo_available: true,
  },
  {
    id: 'antigravity-mobile-gateway',
    title: 'Antigravity Remote Agent Orchestrator & Mobile Gateway',
    category: 'Agentic Systems & Infrastructure',
    stack: ['Python', 'FastAPI', 'WebSockets', 'WebAuthn Passkeys', 'Tailscale'],
    summary:
      'Passkey-authenticated mobile command center for dispatching and monitoring autonomous coding agents across Proxmox VMs and workstations.',
    live_demo_available: false,
  },
  {
    id: 'coaching-payment-tracker',
    title: 'Automated Coaching Sync & Square Billing Pipeline',
    category: 'Business Automation',
    stack: ['Python', 'Google Calendar API', 'Square API', 'SQLite'],
    summary:
      'Self-hosted billing pipeline that extracts coaching sessions from Google Calendar, stages client reviews, and automates Square invoicing.',
    live_demo_available: false,
  },
  {
    id: 'toddler-touch-screen-lock',
    title: 'Toddler Touch Screen Lock — Mobile Utility App',
    category: 'Android & Consumer Apps',
    stack: ['Android', 'Kotlin', 'System Overlay', 'Google Play'],
    summary:
      'Published Android utility (Burgess Meditation LLC) that locks screen touches during video playback so kids can watch without accidental exits.',
    live_demo_available: false,
  },
];

const services = [
  {
    title: '1-on-1 Success & AI Productivity Coaching',
    tag: 'Personal & Executive Coaching',
    description:
      'Structured coaching sessions to build repeatable systems, master AI workflows, and achieve measurable personal or academic milestones.',
    highlights: [
      'Weekly or bi-weekly 1-on-1 coaching sessions',
      'Personalized AI & automation workflow setup',
      'Automated Google Calendar scheduling & transparent billing',
    ],
  },
  {
    title: 'AI Workflow & Automation Consulting',
    tag: 'Small Business & Teams',
    description:
      'Turn manual bottlenecks into reliable, automated pipelines—from custom LLM agents and data scrapers to billing and CRM integrations.',
    highlights: [
      'Architecture & process audit with actionable ROI roadmap',
      'Custom Python / FastAPI / Playwright automation pipelines',
      'Local-first or cloud-hybrid deployment with full ownership',
    ],
  },
  {
    title: 'Custom AI Systems & Homelab Engineering',
    tag: 'Technical Advisory & Build',
    description:
      'End-to-end design of private AI infrastructure, RAG knowledge bases, reinforcement learning environments, and self-hosted services.',
    highlights: [
      'Private RAG & MCP tool server development',
      'Proxmox / Docker / Tailscale secure infrastructure setup',
      'Hands-on technical mentoring and code review',
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Elijah Burgess — AI Engineering, Consulting & Coaching</title>
    <style>
      :root {
        --bg: #0b0f19;
        --surface: #111827;
        --surface-hover: #1e293b;
        --border: #1f2937;
        --text: #f8fafc;
        --muted: #94a3b8;
        --accent: #38bdf8;
        --accent-2: #10b981;
        --accent-purple: #8b5cf6;
      }
      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
      }
      .container {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 1.5rem;
      }
      header {
        border-bottom: 1px solid var(--border);
        background: rgba(11, 15, 25, 0.85);
        backdrop-filter: blur(12px);
        position: sticky;
        top: 0;
        z-index: 20;
      }
      .nav-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 4rem;
      }
      .brand {
        font-weight: 700;
        font-size: 1.1rem;
        letter-spacing: -0.02em;
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .status-pill {
        font-size: 0.75rem;
        font-weight: 500;
        padding: 0.2rem 0.65rem;
        border-radius: 999px;
        background: rgba(16, 185, 129, 0.12);
        color: var(--accent-2);
        border: 1px solid rgba(16, 185, 129, 0.3);
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
      }
      .status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--accent-2);
      }
      nav a {
        color: var(--muted);
        text-decoration: none;
        margin-left: 1.5rem;
        font-size: 0.92rem;
        transition: color 0.15s;
      }
      nav a:hover {
        color: var(--text);
      }
      .hero {
        padding: 5rem 0 4rem;
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2.5rem;
        flex-wrap: wrap;
      }
      .hero-content {
        flex: 1 1 540px;
      }
      .hero-avatar {
        width: 168px;
        height: 168px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid rgba(56, 189, 248, 0.45);
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
      }
      .eyebrow {
        color: var(--accent);
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.75rem;
      }
      h1 {
        font-size: clamp(2.2rem, 4.5vw, 3.4rem);
        line-height: 1.15;
        letter-spacing: -0.03em;
        max-width: 820px;
        margin-bottom: 1.25rem;
      }
      .hero p {
        color: var(--muted);
        font-size: 1.15rem;
        max-width: 680px;
        margin-bottom: 2rem;
      }
      .btn-row {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
      }
      .btn {
        display: inline-flex;
        align-items: center;
        padding: 0.75rem 1.4rem;
        border-radius: 0.5rem;
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        cursor: pointer;
        border: 1px solid transparent;
        transition: all 0.15s;
      }
      .btn-primary {
        background: var(--accent);
        color: #020617;
      }
      .btn-primary:hover {
        filter: brightness(1.1);
      }
      .btn-secondary {
        background: var(--surface);
        color: var(--text);
        border-color: var(--border);
      }
      .btn-secondary:hover {
        background: var(--surface-hover);
      }
      section {
        padding: 4.5rem 0;
        border-bottom: 1px solid var(--border);
      }
      .section-header {
        margin-bottom: 2.5rem;
      }
      .section-header h2 {
        font-size: 1.85rem;
        letter-spacing: -0.02em;
        margin-bottom: 0.5rem;
      }
      .section-header p {
        color: var(--muted);
        max-width: 640px;
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
        gap: 1.5rem;
      }
      .card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.85rem;
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: border-color 0.15s, transform 0.15s;
      }
      .card:hover {
        border-color: rgba(56, 189, 248, 0.45);
        transform: translateY(-2px);
      }
      .card-tag {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
      }
      .card h3 {
        font-size: 1.2rem;
        margin-bottom: 0.75rem;
      }
      .card p {
        color: var(--muted);
        font-size: 0.95rem;
        margin-bottom: 1.25rem;
      }
      .tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
        margin-top: auto;
      }
      .tag {
        font-size: 0.75rem;
        padding: 0.2rem 0.55rem;
        border-radius: 0.35rem;
        background: rgba(255, 255, 255, 0.05);
        color: #cbd5e1;
      }
      .highlights {
        list-style: none;
        margin-top: 0.5rem;
      }
      .highlights li {
        font-size: 0.9rem;
        color: #cbd5e1;
        margin-bottom: 0.45rem;
        padding-left: 1.25rem;
        position: relative;
      }
      .highlights li::before {
        content: '✓';
        color: var(--accent-2);
        position: absolute;
        left: 0;
        font-weight: 700;
      }
      .contact-box {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 0.85rem;
        padding: 2rem;
        max-width: 640px;
      }
      .form-row {
        margin-bottom: 1rem;
      }
      .form-row label {
        display: block;
        font-size: 0.85rem;
        color: var(--muted);
        margin-bottom: 0.35rem;
      }
      .form-row input,
      .form-row select,
      .form-row textarea {
        width: 100%;
        padding: 0.65rem 0.85rem;
        border-radius: 0.45rem;
        border: 1px solid var(--border);
        background: var(--bg);
        color: var(--text);
        font-family: inherit;
      }
      footer {
        padding: 2.5rem 0;
        color: var(--muted);
        font-size: 0.88rem;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <header>
      <div class="container nav-bar">
        <div class="brand">
          <span>Elijah Burgess</span>
          <span class="status-pill" id="homelab-status">
            <span class="status-dot"></span>
            <span id="homelab-status-text">Homelab API Ready</span>
          </span>
        </div>
        <nav>
          <a href="#projects">AI Projects</a>
          <a href="#services">Coaching & Consulting</a>
          <a href="#contact">Book / Inquire</a>
        </nav>
      </div>
    </header>

    <main class="container">
      <section class="hero">
        <div class="hero-content">
          <div class="eyebrow">Applied AI Engineering • Automation Consulting • Success Coaching</div>
          <h1>Building intelligent systems & helping people work with clarity.</h1>
          <p>
            Explore my live self-hosted AI research, reinforcement learning engines, and automation
            projects—or work with me 1-on-1 for AI workflow consulting and success coaching.
          </p>
          <div class="btn-row">
            <a href="#projects" class="btn btn-primary">Explore AI Projects</a>
            <a href="#services" class="btn btn-secondary">View Coaching & Consulting</a>
          </div>
        </div>
        <img src="/images/Eliheadshot.jpg" alt="Elijah Burgess" class="hero-avatar" />
      </section>

      <section id="projects">
        <div class="section-header">
          <h2>AI & Systems Engineering Showcase</h2>
          <p>
            Active projects running across my Proxmox & Raspberry Pi homelab cluster, backed by
            live APIs and local-first compute.
          </p>
        </div>
        <div class="grid" id="projects-grid">
          {
            defaultProjects.map((proj) => (
              <article class="card">
                <div>
                  <div class="card-tag">{proj.category}</div>
                  <h3>{proj.title}</h3>
                  <p>{proj.summary}</p>
                </div>
                <div class="tags">
                  {proj.stack.map((tech) => (
                    <span class="tag">{tech}</span>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section id="services">
        <div class="section-header">
          <h2>Consulting, Automation & Success Coaching</h2>
          <p>
            Practical, results-driven engagements tailored for individuals, students, and small
            businesses looking to leverage AI and structured execution.
          </p>
        </div>
        <div class="grid">
          {
            services.map((svc) => (
              <article class="card">
                <div>
                  <div class="card-tag">{svc.tag}</div>
                  <h3>{svc.title}</h3>
                  <p>{svc.description}</p>
                </div>
                <ul class="highlights">
                  {svc.highlights.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section id="contact">
        <div class="section-header">
          <h2>Start a Conversation</h2>
          <p>
            Send an inquiry directly to my homelab API to book an intro coaching call or discuss a
            custom automation project.
          </p>
        </div>
        <div class="contact-box">
          <form id="inquiry-form">
            <div class="form-row">
              <label for="name">Your Name</label>
              <input id="name" name="name" type="text" required placeholder="Alex Rivera" />
            </div>
            <div class="form-row">
              <label for="email">Email Address</label>
              <input id="email" name="email" type="email" required placeholder="alex@example.com" />
            </div>
            <div class="form-row">
              <label for="service_tier">Interest Area</label>
              <select id="service_tier" name="service_tier">
                <option value="1-on-1 Success & AI Coaching">1-on-1 Success & AI Coaching</option>
                <option value="AI Workflow & Automation Consulting">AI Workflow & Automation Consulting</option>
                <option value="Custom AI Systems Engineering">Custom AI Systems Engineering</option>
              </select>
            </div>
            <div class="form-row">
              <label for="message">How can I help?</label>
              <textarea id="message" name="message" rows="4" required placeholder="Tell me about your goals or project..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Send Inquiry</button>
            <p id="form-status" style="margin-top: 0.85rem; font-size: 0.9rem; color: var(--accent-2);"></p>
          </form>
        </div>
      </section>
    </main>

    <footer>
      <div class="container">
        Hybrid Edge + Proxmox Homelab Architecture • Served via Cloudflare Pages & Proxmox CT 104 API
      </div>
    </footer>

    <script define:vars={{ apiBase, lanApiBase }}>
      const isLan =
        window.location.hostname === 'localhost' ||
        window.location.hostname.startsWith('192.168.') ||
        window.location.hostname.startsWith('100.');
      const resolvedApi = isLan ? lanApiBase : apiBase;

      async function checkHomelabHealth() {
        const textEl = document.getElementById('homelab-status-text');
        try {
          const res = await fetch(`${resolvedApi}/api/health`);
          if (res.ok) {
            const data = await res.json();
            textEl.textContent = `Homelab Online (${data.node})`;
          }
        } catch (_err) {
          textEl.textContent = 'Edge Static Mode';
        }
      }

      const form = document.getElementById('inquiry-form');
      const statusEl = document.getElementById('form-status');
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());
        statusEl.textContent = 'Sending...';
        try {
          const res = await fetch(`${resolvedApi}/api/coaching/inquiry`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          if (res.ok) {
            statusEl.textContent = 'Thanks! Your inquiry was logged directly to the homelab server.';
            form.reset();
          } else {
            statusEl.textContent = 'Could not submit inquiry right now.';
          }
        } catch (_err) {
          statusEl.textContent = 'Homelab tunnel offline—please reach out directly.';
        }
      });

      checkHomelabHealth();
    </script>
  </body>
</html>
