  <!-- =========================================================================
       PAGE CLIENT INTERACTIVITY SCRIPT
       ========================================================================= -->
  <script is:inline>
    // 1. Service Tier Pre-Selection & Query Param Listener (?tier=...)
    (function initServiceTierPreselect() {
      var tierSelect = document.getElementById('service-tier-select');
      var nameInput = document.getElementById('name');
      var messageInput = document.getElementById('message');

      var tierMap = {
        'coaching': '1-on-1 Success & AI Productivity Coaching',
        'automation': 'AI Workflow & Automation Consulting',
        'advisory': 'Custom AI Systems & Homelab Engineering',
        'intro': 'Free 15-Min Intro Call'
      };

      // Read query param on initial load
      try {
        var params = new URLSearchParams(window.location.search);
        var tierParam = params.get('tier');
        if (tierParam && tierSelect) {
          var mapped = tierMap[tierParam.toLowerCase()];
          if (mapped) {
            tierSelect.value = mapped;
          }
        }
      } catch (_e) {}

      // Click listener for all buttons with [data-select-tier]
      var tierButtons = document.querySelectorAll('[data-select-tier]');
      tierButtons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var tierValue = btn.getAttribute('data-select-tier');
          if (tierSelect && tierValue) {
            tierSelect.value = tierValue;
          }
          var contactSection = document.getElementById('contact');
          if (contactSection) {
            contactSection.scrollIntoView({ behavior: 'smooth' });
          }
          if (nameInput) {
            setTimeout(function () {
              nameInput.focus();
            }, 300);
          }
        });
      });

      // Quick 15-Min Intro Button Handler
      var quickBtn = document.getElementById('quick-intro-btn');
      if (quickBtn) {
        quickBtn.addEventListener('click', function () {
          if (tierSelect) {
            tierSelect.value = 'Free 15-Min Intro Call';
          }
          if (messageInput && (!messageInput.value || messageInput.value.trim() === '')) {
            messageInput.value =
              "Hi Elijah, I'd like to book a free 15-minute intro call. My general availability this week is [Days/Times]:";
          }
          var contactSection = document.getElementById('contact');
          if (contactSection) {
            contactSection.scrollIntoView({ behavior: 'smooth' });
          }
          if (nameInput) {
            setTimeout(function () {
              nameInput.focus();
            }, 250);
          }
        });
      }
    })();

    // 2. Homelab Dynamic Telemetry Pollers
    (function initHomelabTelemetry() {
      var apiBase = window.__API_BASE__ || 'https://api.eliburgessconsulting.com';

      // Telemetry: BoredGamer Arena (CT 105)
      var arenaPill = document.getElementById('telemetry-arena');
      if (arenaPill) {
        fetch(apiBase + '/api/arena/status', { headers: { Accept: 'application/json' } })
          .then(function (r) {
            return r.ok ? r.json() : null;
          })
          .then(function (d) {
            if (!d) return;
            var label = arenaPill.querySelector('.telemetry-text');
            var dot = arenaPill.querySelector('.status-dot');
            if (dot && d.online) dot.className = 'status-dot online';
            var totalBots = (d.kingdomino_bots || 0) + (d.pinochle_bots || 0);
            var text = (totalBots || 17) + ' Neural Bots Ready';
            if (d.active_tables && d.active_tables > 0) {
              text += ' • ' + d.active_tables + ' Tables Active';
            }
            if (label) label.textContent = text;
          })
          .catch(function () {});
      }

      // Telemetry: Research & Bioinformatics Hub (CT 107)
      var researchPill = document.getElementById('telemetry-research');
      if (researchPill) {
        fetch(apiBase + '/api/research/status', { headers: { Accept: 'application/json' } })
          .then(function (r) {
            return r.ok ? r.json() : null;
          })
          .then(function (d) {
            if (!d) return;
            var label = researchPill.querySelector('.telemetry-text');
            var dot = researchPill.querySelector('.status-dot');
            if (dot && d.online) dot.className = 'status-dot online';
            var papers = d.arxiv_papers
              ? (d.arxiv_papers >= 1000 ? (d.arxiv_papers / 1000).toFixed(1) + 'k+' : d.arxiv_papers)
              : '71.5k+';
            var shards = d.zoekt_shards || 65;
            if (label) label.textContent = papers + ' Papers • ' + shards + ' Shards';
          })
          .catch(function () {});
      }

      // Telemetry: eBay Deal Hunter (CT 104)
      var dealsPill = document.getElementById('telemetry-deals');
      if (dealsPill) {
        fetch(apiBase + '/api/deal-hunter/summary', { headers: { Accept: 'application/json' } })
          .then(function (r) {
            return r.ok ? r.json() : null;
          })
          .then(function (d) {
            if (!d) return;
            var label = dealsPill.querySelector('.telemetry-text');
            var dot = dealsPill.querySelector('.status-dot');
            if (dot && d.available) dot.className = 'status-dot online';
            if (label) {
              if (d.active_deals_count > 0 && d.top_discount_pct > 0) {
                label.textContent = d.active_deals_count + ' Active Deals • Up to ' + d.top_discount_pct + '% Off';
              } else if (d.total_tracked_items) {
                label.textContent = d.total_tracked_items.toLocaleString() + '+ Tracked Listings';
              }
            }
          })
          .catch(function () {});
      }

      // Telemetry: Valheim Dedicated Server (CT 101)
      var valheimDot = document.getElementById('valheim-status-dot');
      var valheimText = document.getElementById('valheim-status-text');
      var valheimServer = document.getElementById('valheim-server-name');
      var valheimPlayers = document.getElementById('valheim-player-count');
      var valheimUptime = document.getElementById('valheim-uptime');
      var valheimMods = document.getElementById('valheim-mods');

      if (valheimText) {
        var vController = typeof AbortController !== 'undefined' ? new AbortController() : null;
        var vSignal = vController ? vController.signal : undefined;
        var vTimeout = vController ? setTimeout(function () { vController.abort(); }, 3500) : null;

        fetch(apiBase + '/api/valheim/status', { signal: vSignal, headers: { Accept: 'application/json' } })
          .then(function (res) {
            if (vTimeout) clearTimeout(vTimeout);
            if (!res.ok) throw new Error('HTTP ' + res.status);
            return res.json();
          })
          .then(function (data) {
            var isOnline = data && (data.online === true || data.status === 'Online');
            if (valheimDot) {
              valheimDot.className = 'status-dot ' + (isOnline ? 'online' : 'static');
            }
            if (valheimText) {
              valheimText.textContent = isOnline ? 'Online (Dedicated)' : 'Standby / Offline';
            }
            if (valheimServer && data.server_name) {
              valheimServer.textContent = data.server_name + (data.world ? ' [' + data.world + ']' : '');
            }
            if (valheimPlayers) {
              valheimPlayers.textContent = (data.player_count !== undefined ? data.player_count : 0) + ' active players';
            }
            if (valheimUptime && data.uptime) {
              valheimUptime.textContent = 'Uptime: ' + data.uptime;
            }
            if (valheimMods && Array.isArray(data.active_mods) && data.active_mods.length > 0) {
              valheimMods.textContent = '';
              data.active_mods.forEach(function (mod) {
                var tag = document.createElement('span');
                tag.className = 'tag';
                tag.textContent = String(mod);
                valheimMods.appendChild(tag);
                valheimMods.appendChild(document.createTextNode(' '));
              });
            }
          })
          .catch(function () {
            if (vTimeout) clearTimeout(vTimeout);
            if (valheimDot) valheimDot.className = 'status-dot static';
            if (valheimText) valheimText.textContent = 'Standby (CT 101)';
          });
      }
    })();

    // 3. Direct Homelab Inquiry Form Submission Handler
    (function initInquiryFormHandler() {
      var form = document.getElementById('inquiry-form');
      var feedback = document.getElementById('form-feedback');
      var submitBtn = document.getElementById('submit-btn');
      var tierSelect = document.getElementById('service-tier-select');
      if (!form || !feedback || !submitBtn) return;

      form.addEventListener('submit', function (e) {
        e.preventDefault();

        var name = (document.getElementById('name').value || '').trim();
        var email = (document.getElementById('email').value || '').trim();
        var service_tier = tierSelect ? tierSelect.value : 'General Consulting / Coaching';
        var message = (document.getElementById('message').value || '').trim();
        var honeypot = form.querySelector('input[name="website_url"]');
        var website_url = honeypot ? honeypot.value : '';

        if (!name || !email || !message) {
          feedback.hidden = false;
          feedback.className = 'form-feedback error';
          feedback.innerHTML = '<strong>Missing required fields:</strong> Please provide your name, email, and message.';
          return;
        }

        var originalBtnHtml = submitBtn.innerHTML;
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>Transmitting to Homelab...</span>';
        feedback.hidden = true;

        var apiBase = window.__API_BASE__ || 'https://api.eliburgessconsulting.com';
        var controller = typeof AbortController !== 'undefined' ? new AbortController() : null;
        var signal = controller ? controller.signal : undefined;
        var timeoutId = controller
          ? setTimeout(function () {
              controller.abort();
            }, 5000)
          : null;

        fetch(apiBase + '/api/coaching/inquiry', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({
            name: name,
            email: email,
            service_tier: service_tier,
            message: message,
            website_url: website_url,
          }),
          signal: signal,
        })
          .then(function (res) {
            if (timeoutId) clearTimeout(timeoutId);
            if (!res.ok) {
              // Surface validation (422) / rate-limit (429) errors instead of blaming the tunnel
              return res
                .json()
                .catch(function () {
                  return {};
                })
                .then(function (body) {
                  var err = new Error('HTTP ' + res.status);
                  err.status = res.status;
                  var detail = body && body.detail;
                  if (Array.isArray(detail)) {
                    detail = detail
                      .map(function (d) {
                        return String((d && d.msg) || '').replace(/^Value error, /, '');
                      })
                      .filter(Boolean)
                      .join(' ');
                  }
                  err.detail = typeof detail === 'string' ? detail : '';
                  throw err;
                });
            }
            return res.json();
          })
          .then(function () {
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnHtml;
            feedback.hidden = false;
            feedback.className = 'form-feedback success';
            feedback.innerHTML =
              '<strong>Inquiry Received!</strong> Your message was securely stored on my homelab cluster and forwarded instantly to my phone. I will review it and reply within 24 hours.';
            form.reset();
            if (tierSelect) tierSelect.value = 'Free 15-Min Intro Call';
          })
          .catch(function (err) {
            if (timeoutId) clearTimeout(timeoutId);
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalBtnHtml;
            feedback.hidden = false;
            feedback.className = 'form-feedback error';
            if (err && err.status && err.status >= 400 && err.status < 500) {
              feedback.textContent = '';
              var strong = document.createElement('strong');
              strong.textContent = err.status === 429 ? 'Too many submissions. ' : 'Please check your details. ';
              feedback.appendChild(strong);
              feedback.appendChild(
                document.createTextNode(
                  err.detail ||
                    (err.status === 429
                      ? 'Please wait a few minutes and try again.'
                      : 'Some fields could not be validated.')
                )
              );
              return;
            }
            var mailtoLink =
              'mailto:elib@eliburgessconsulting.com?subject=' +
              encodeURIComponent('Inquiry: ' + service_tier) +
              '&body=' +
              encodeURIComponent('Name: ' + name + '\nEmail: ' + email + '\n\n' + message);
            feedback.innerHTML =
              '<strong>Homelab API tunnel is momentarily offline.</strong> <a href="' +
              mailtoLink +
              '" class="feedback-mailto">Click here to send your inquiry directly via email &rarr;</a>';
          });
      });
    })();
  </script>
</BaseLayout>

