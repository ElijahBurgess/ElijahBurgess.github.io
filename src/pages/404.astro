---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found"
  description="The requested page could not be found."
>
  <section class="not-found" aria-labelledby="not-found-heading">
    <div class="container not-found-inner">
      <span class="section-index">404</span>
      <h1 id="not-found-heading" class="not-found-title">Page not found</h1>
      <p class="not-found-copy">
        The page you requested does not exist or has moved to a different address.
      </p>
      <a href="/" class="btn btn-ghost">← Return Home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: clamp(5rem, 12vw, 8.5rem);
  }

  .not-found-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .not-found-title {
    margin-top: 0.55rem;
    font-size: clamp(2rem, 4.5vw, 3rem);
    letter-spacing: -0.03em;
  }

  .not-found-copy {
    margin: 0.9rem 0 1.85rem;
    font-size: 1.02rem;
    color: var(--text-secondary);
    max-width: 48ch;
  }
</style>
